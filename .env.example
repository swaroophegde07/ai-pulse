# ============================================================
# AI Pulse — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ============================================================

# Required: Google AI Studio API key for Gemini summarization.
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_api_key_here

# Optional: Override the Gemini model.
# Default is gemini-3.5-flash-lite (fast, cost-efficient).
# Other options: gemini-3.8-flash
# GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: Groq fallback summarizer (free tier, no card needed).
# Used when Gemini has no key, hits its quota, or keeps failing.
# Obtain from: https://console.groq.com/keys
# GROQ_API_KEY=your_groq_key_here
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_MAX_REQUESTS_PER_MINUTE=3
# GROQ_MAX_SUMMARIES_PER_RUN=15
# GROQ_MAX_RETRIES=1

# Optional: Maximum articles to retain in feed.json.
# Default: 200
# MAX_ARTICLES=200

# Optional: Override the feed output path.
# Default: src/data/feed.json (relative to repo root)
# FEED_PATH=src/data/feed.json
