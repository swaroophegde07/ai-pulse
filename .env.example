# ============================================================
# AI Pulse — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ============================================================

# Required: Google AI Studio API key for Gemini summarization.
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_api_key_here

# Optional: Override the Gemini model.
# Default is gemini-3.5-flash-lite (fast, cost-efficient).
# Other options: gemini-3.8-flash
# GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: Maximum articles to retain in feed.json.
# Default: 200
# MAX_ARTICLES=200

# Optional: Override the feed output path.
# Default: src/data/feed.json (relative to repo root)
# FEED_PATH=src/data/feed.json
