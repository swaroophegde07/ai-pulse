---
// DonutChart.astro — share-of-whole donut with a legend.
import type { Datum } from "../../lib/visuals";

interface Props {
  data: Datum[];
  ariaLabel: string;
  centerLabel?: string;
}

const { data, ariaLabel, centerLabel = "total" } = Astro.props;
const total = data.reduce((sum, d) => sum + d.value, 0) || 1;
let cumulative = 0;
const segments = data.map((d, i) => {
  const pct = (d.value / total) * 100;
  const seg = { ...d, pct, offset: 25 - cumulative, i };
  cumulative += pct;
  return seg;
});
---

<div class="chart-donut flex items-center gap-5 flex-wrap sm:flex-nowrap">
  <div class="relative w-36 h-36 shrink-0 mx-auto sm:mx-0">
    <svg viewBox="0 0 42 42" class="w-full h-full" role="img" aria-label={`${ariaLabel}: ${segments.map((s) => `${s.label} ${s.pct.toFixed(0)}%`).join(", ")}`}>
      <circle cx="21" cy="21" r="15.915" fill="none" class="donut-track" stroke-width="5" />
      {segments.map((s) => (
        <circle
          cx="21"
          cy="21"
          r="15.915"
          fill="none"
          stroke-width="5"
          class="donut-seg"
          style={`--h:${s.hue ?? 160};--i:${s.i};stroke-dasharray:${Math.max(0, s.pct - 0.6).toFixed(2)} ${(100 - Math.max(0, s.pct - 0.6)).toFixed(2)};stroke-dashoffset:${s.offset.toFixed(2)}`}
        >
          <title>{`${s.label}: ${s.value} (${s.pct.toFixed(1)}%)`}</title>
        </circle>
      ))}
    </svg>
    <div class="absolute inset-0 flex flex-col items-center justify-center pointer-events-none" aria-hidden="true">
      <span class="font-mono text-xl font-bold text-theme-primary leading-none">{total}</span>
      <span class="font-mono text-[9px] uppercase tracking-wider text-theme-muted mt-1">{centerLabel}</span>
    </div>
  </div>
  <ul class="flex-1 min-w-0 space-y-1.5" aria-hidden="true">
    {segments.map((s) => (
      <li class="flex items-center gap-2 text-xs">
        <span class="chart-swatch" style={`--h:${s.hue ?? 160}`}></span>
        <span class="text-theme-secondary truncate flex-1">{s.label}</span>
        <span class="font-mono text-[11px] text-theme-primary tabular-nums">{s.value}</span>
        <span class="font-mono text-[10px] text-theme-muted tabular-nums w-9 text-right">{s.pct.toFixed(0)}%</span>
      </li>
    ))}
  </ul>
</div>
