---
// Header.astro — top navigation bar

interface Props {
  currentPath?: string;
}

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const rawCurrent = Astro.props.currentPath || Astro.url.pathname || "/";

// Strip base prefix and normalize trailing slashes for robust route matching
const stripBase = (path: string): string => {
  let p = path;
  if (base && p.startsWith(base)) {
    p = p.slice(base.length);
  }
  p = p.replace(/\/+$/, "");
  return p === "" ? "/" : p;
};

const normalizedCurrent = stripBase(rawCurrent);

const navItems = [
  { label: "Overview", href: `${base}/`, active: true },
  { label: "News", href: `${base}/news/`, active: true },
  { label: "Models", href: `${base}/models/`, active: true },
  { label: "Research", href: `${base}/research/`, active: true },
  { label: "Benchmarks", href: `${base}/benchmarks/`, active: true },
];
---

<header class="border-b border-theme-border bg-theme-page/95 backdrop-blur-sm sticky top-0 z-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-14">
      <!-- Wordmark -->
      <a
        href={`${base}/`}
        class="flex items-center gap-2 group min-h-[44px] py-2 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 rounded"
        aria-label="AI Pulse home"
      >
        <span
          class="font-mono text-sm font-bold tracking-[0.25em] text-theme-primary group-hover:text-emerald-500 dark:group-hover:text-emerald-400 transition-colors duration-200"
        >
          AI PULSE
        </span>
        <span
          class="inline-block w-2 h-2 rounded-full bg-emerald-500 dark:bg-emerald-400 animate-pulse"
          title="Automated intelligence pipeline active"
          aria-label="Automated intelligence pipeline active"
        ></span>
      </a>

      <!-- Desktop nav -->
      <nav class="hidden md:flex items-center gap-1" aria-label="Main navigation">
        {
          navItems.map((item) => {
            const target = stripBase(item.href);
            const isCurrent =
              target === "/"
                ? normalizedCurrent === "/"
                : normalizedCurrent === target ||
                  normalizedCurrent.startsWith(`${target}/`);

            return (
              <a
                href={item.href}
                class={`font-mono text-xs tracking-wide px-3 py-2 rounded transition-colors duration-150 inline-flex items-center gap-1 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 ${
                  isCurrent
                    ? "text-emerald-600 dark:text-emerald-400 bg-emerald-500/10 font-medium"
                    : "text-theme-secondary hover:text-theme-primary hover:bg-theme-hover"
                }`}
                aria-current={isCurrent ? "page" : undefined}
              >
                <span>{item.label}</span>
              </a>
            );
          })
        }
      </nav>

      <!-- Desktop Theme Switcher & Feedback -->
      <div class="hidden md:flex items-center gap-3">
        <!-- Segmented Theme Switcher -->
        <div
          class="theme-switcher inline-flex items-center p-0.5 rounded border border-theme-border bg-theme-elevated"
          role="group"
          aria-label="Color theme preference"
        >
          <button
            type="button"
            data-theme-value="light"
            class="theme-btn px-2 py-1 rounded text-[11px] font-mono inline-flex items-center gap-1 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500"
            aria-label="Light theme"
            title="Light theme"
            aria-pressed="false"
          >
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="12" cy="12" r="4" stroke-width="2"></circle>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32l1.41 1.41M2 12h2m16 0h2M6.34 17.66l-1.41 1.41m14.14-14.14l-1.41 1.41"></path>
            </svg>
            <span class="sr-only lg:not-sr-only">Light</span>
          </button>
          <button
            type="button"
            data-theme-value="dark"
            class="theme-btn px-2 py-1 rounded text-[11px] font-mono inline-flex items-center gap-1 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500"
            aria-label="Dark theme"
            title="Dark theme"
            aria-pressed="false"
          >
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path>
            </svg>
            <span class="sr-only lg:not-sr-only">Dark</span>
          </button>
          <button
            type="button"
            data-theme-value="system"
            class="theme-btn px-2 py-1 rounded text-[11px] font-mono inline-flex items-center gap-1 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500"
            aria-label="System theme"
            title="System theme"
            aria-pressed="false"
          >
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <rect x="2" y="3" width="20" height="14" rx="2" stroke-width="2"></rect>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 21h8m-4-4v4"></path>
            </svg>
            <span class="sr-only lg:not-sr-only">Auto</span>
          </button>
        </div>

        <!-- Secondary Desktop Feedback link -->
        <div class="border-l border-theme-border pl-3">
          <a
            href={`${base}/feedback/`}
            class={`font-mono text-xs px-2.5 py-1.5 rounded transition-colors duration-150 inline-flex items-center gap-1 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 ${
              normalizedCurrent === "/feedback"
                ? "text-emerald-600 dark:text-emerald-400 bg-emerald-500/10 font-medium"
                : "text-theme-muted hover:text-theme-primary hover:bg-theme-hover"
            }`}
            aria-current={normalizedCurrent === "/feedback" ? "page" : undefined}
            aria-label="Submit feedback or report an issue"
          >
            <span>Feedback</span>
          </a>
        </div>
      </div>

      <!-- Mobile menu button -->
      <button
        type="button"
        id="mobile-menu-btn"
        class="btn-interactive md:hidden inline-flex items-center justify-center w-11 h-11 -mr-2 rounded text-theme-secondary hover:text-theme-primary hover:bg-theme-hover focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 cursor-pointer"
        aria-label="Open main menu"
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <!-- Hamburger icon (shown when closed) -->
        <svg
          id="menu-icon-closed"
          class="w-5 h-5 block"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M4 6h16M4 12h16M4 18h16"
          />
        </svg>
        <!-- Close (X) icon (hidden when closed) -->
        <svg
          id="menu-icon-open"
          class="w-5 h-5 hidden"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M6 18L18 6M6 6l12 12"
          />
        </svg>
      </button>
    </div>

    <!-- Mobile nav dropdown -->
    <nav
      id="mobile-nav"
      class="hidden md:hidden border-t border-theme-border/80 py-3 space-y-1"
      aria-label="Mobile navigation"
    >
      {
        navItems.map((item) => {
          const target = stripBase(item.href);
          const isCurrent =
            target === "/"
              ? normalizedCurrent === "/"
              : normalizedCurrent === target ||
                normalizedCurrent.startsWith(`${target}/`);

          return (
            <a
              href={item.href}
              class={`mobile-nav-link flex items-center justify-between font-mono text-xs tracking-wide px-3 py-3 rounded-md min-h-[44px] transition-colors ${
                isCurrent
                  ? "text-emerald-600 dark:text-emerald-400 bg-emerald-500/10 font-medium"
                  : "text-theme-secondary hover:text-theme-primary hover:bg-theme-hover active:bg-theme-selected"
              }`}
              aria-current={isCurrent ? "page" : undefined}
            >
              <span>{item.label}</span>
              {isCurrent && (
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 dark:bg-emerald-400" aria-hidden="true"></span>
              )}
            </a>
          );
        })
      }

      <!-- Mobile Theme Selector -->
      <div class="pt-3 mt-2 border-t border-theme-border/80 flex items-center justify-between px-3 py-2">
        <span class="font-mono text-xs text-theme-muted">Theme</span>
        <div
          class="theme-switcher inline-flex items-center p-0.5 rounded border border-theme-border bg-theme-elevated"
          role="group"
          aria-label="Mobile theme preference"
        >
          <button
            type="button"
            data-theme-value="light"
            class="theme-btn px-2.5 py-1.5 rounded text-[11px] font-mono inline-flex items-center gap-1 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500"
            aria-label="Light theme"
            title="Light theme"
            aria-pressed="false"
          >
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="12" cy="12" r="4" stroke-width="2"></circle>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32l1.41 1.41M2 12h2m16 0h2M6.34 17.66l-1.41 1.41m14.14-14.14l-1.41 1.41"></path>
            </svg>
            <span>Light</span>
          </button>
          <button
            type="button"
            data-theme-value="dark"
            class="theme-btn px-2.5 py-1.5 rounded text-[11px] font-mono inline-flex items-center gap-1 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500"
            aria-label="Dark theme"
            title="Dark theme"
            aria-pressed="false"
          >
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path>
            </svg>
            <span>Dark</span>
          </button>
          <button
            type="button"
            data-theme-value="system"
            class="theme-btn px-2.5 py-1.5 rounded text-[11px] font-mono inline-flex items-center gap-1 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500"
            aria-label="System theme"
            title="System theme"
            aria-pressed="false"
          >
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <rect x="2" y="3" width="20" height="14" rx="2" stroke-width="2"></rect>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 21h8m-4-4v4"></path>
            </svg>
            <span>Auto</span>
          </button>
        </div>
      </div>

      <div class="pt-2 mt-2 border-t border-theme-border/80">
        <a
          href={`${base}/feedback/`}
          class={`mobile-nav-link flex items-center justify-between font-mono text-xs tracking-wide px-3 py-3 rounded-md min-h-[44px] transition-colors ${
            normalizedCurrent === "/feedback"
              ? "text-emerald-600 dark:text-emerald-400 bg-emerald-500/10 font-medium"
              : "text-theme-muted hover:text-theme-primary hover:bg-theme-hover active:bg-theme-selected"
          }`}
          aria-current={normalizedCurrent === "/feedback" ? "page" : undefined}
        >
          <span>Feedback &amp; Bug Reports</span>
          <span class="font-mono text-[10px] text-theme-muted">↗</span>
        </a>
      </div>
    </nav>
  </div>
</header>

<script>
  function setupMobileMenu() {
    const btn = document.getElementById("mobile-menu-btn");
    const menu = document.getElementById("mobile-nav");
    const closedIcon = document.getElementById("menu-icon-closed");
    const openIcon = document.getElementById("menu-icon-open");

    if (!btn || !menu) return;

    function openMenu() {
      btn?.setAttribute("aria-expanded", "true");
      btn?.setAttribute("aria-label", "Close main menu");
      menu?.classList.remove("hidden");
      closedIcon?.classList.add("hidden");
      openIcon?.classList.remove("hidden");
      document.body.classList.add("overflow-hidden");
    }

    function closeMenu() {
      btn?.setAttribute("aria-expanded", "false");
      btn?.setAttribute("aria-label", "Open main menu");
      menu?.classList.add("hidden");
      closedIcon?.classList.remove("hidden");
      openIcon?.classList.add("hidden");
      document.body.classList.remove("overflow-hidden");
    }

    function toggleMenu() {
      const isExpanded = btn?.getAttribute("aria-expanded") === "true";
      if (isExpanded) {
        closeMenu();
      } else {
        openMenu();
      }
    }

    btn.onclick = (e) => {
      e.stopPropagation();
      toggleMenu();
    };

    // Close on navigation link click
    const links = menu.querySelectorAll(".mobile-nav-link");
    links.forEach((link) => {
      link.addEventListener("click", () => {
        closeMenu();
      });
    });

    // Close on Escape key
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && btn.getAttribute("aria-expanded") === "true") {
        closeMenu();
        btn.focus();
      }
    });

    // Close when clicking outside header
    document.addEventListener("click", (e) => {
      if (!menu.classList.contains("hidden")) {
        const header = btn.closest("header");
        if (header && !header.contains(e.target as Node)) {
          closeMenu();
        }
      }
    });

    // Reset menu on resize to desktop (>= 768px)
    window.addEventListener("resize", () => {
      if (window.innerWidth >= 768 && btn.getAttribute("aria-expanded") === "true") {
        closeMenu();
      }
    });
  }

  // Setup on initial DOM load
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupMobileMenu);
  } else {
    setupMobileMenu();
  }
  document.addEventListener("astro:page-load", setupMobileMenu);
</script>
