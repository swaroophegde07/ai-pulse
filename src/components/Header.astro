---
// Header.astro — top navigation bar

interface Props {
  currentPath?: string;
}

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const rawCurrent = Astro.props.currentPath || Astro.url.pathname || "/";

// Strip base prefix and normalize trailing slashes for robust route matching
const stripBase = (path: string): string => {
  let p = path;
  if (base && p.startsWith(base)) {
    p = p.slice(base.length);
  }
  p = p.replace(/\/+$/, "");
  return p === "" ? "/" : p;
};

const normalizedCurrent = stripBase(rawCurrent);

const navItems = [
  { label: "Overview", href: `${base}/`, active: true },
  { label: "News", href: `${base}/news/`, active: true },
  { label: "Models", href: `${base}/models/`, active: true },
  { label: "Research", href: `${base}/research/`, active: true },
  { label: "Benchmarks", href: `${base}/benchmarks/`, active: true },
];
---

<header class="border-b border-neutral-800 bg-neutral-950/95 backdrop-blur-sm sticky top-0 z-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-14">
      <!-- Wordmark -->
      <a
        href={`${base}/`}
        class="flex items-center gap-2 group min-h-[44px] py-2 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 rounded"
        aria-label="AI Pulse home"
      >
        <span
          class="font-mono text-sm font-bold tracking-[0.25em] text-neutral-100 group-hover:text-emerald-400 transition-colors duration-200"
        >
          AI PULSE
        </span>
        <span
          class="inline-block w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"
          aria-hidden="true"
        ></span>
      </a>

      <!-- Desktop nav -->
      <nav class="hidden md:flex items-center gap-1" aria-label="Main navigation">
        {
          navItems.map((item) => {
            const target = stripBase(item.href);
            const isCurrent =
              target === "/"
                ? normalizedCurrent === "/"
                : normalizedCurrent === target ||
                  normalizedCurrent.startsWith(`${target}/`);

            return (
              <a
                href={item.href}
                class={`font-mono text-xs tracking-wide px-3 py-2 rounded transition-colors duration-150 inline-flex items-center gap-1 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 ${
                  isCurrent
                    ? "text-emerald-400 bg-emerald-400/10 font-medium"
                    : "text-neutral-400 hover:text-neutral-100 hover:bg-neutral-800/80"
                }`}
                aria-current={isCurrent ? "page" : undefined}
              >
                <span>{item.label}</span>
              </a>
            );
          })
        }
      </nav>

      <!-- Mobile menu button -->
      <button
        type="button"
        id="mobile-menu-btn"
        class="md:hidden inline-flex items-center justify-center w-11 h-11 -mr-2 rounded text-neutral-400 hover:text-neutral-100 hover:bg-neutral-800/80 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 transition-colors cursor-pointer"
        aria-label="Open main menu"
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <!-- Hamburger icon (shown when closed) -->
        <svg
          id="menu-icon-closed"
          class="w-5 h-5 block"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M4 6h16M4 12h16M4 18h16"
          />
        </svg>
        <!-- Close (X) icon (hidden when closed) -->
        <svg
          id="menu-icon-open"
          class="w-5 h-5 hidden"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M6 18L18 6M6 6l12 12"
          />
        </svg>
      </button>
    </div>

    <!-- Mobile nav dropdown -->
    <nav
      id="mobile-nav"
      class="hidden md:hidden border-t border-neutral-800/80 py-3 space-y-1"
      aria-label="Mobile navigation"
    >
      {
        navItems.map((item) => {
          const target = stripBase(item.href);
          const isCurrent =
            target === "/"
              ? normalizedCurrent === "/"
              : normalizedCurrent === target ||
                normalizedCurrent.startsWith(`${target}/`);

          return (
            <a
              href={item.href}
              class={`mobile-nav-link flex items-center justify-between font-mono text-xs tracking-wide px-3 py-3 rounded-md min-h-[44px] transition-colors ${
                isCurrent
                  ? "text-emerald-400 bg-emerald-400/10 font-medium"
                  : "text-neutral-300 hover:text-neutral-100 hover:bg-neutral-800/60 active:bg-neutral-800"
              }`}
              aria-current={isCurrent ? "page" : undefined}
            >
              <span>{item.label}</span>
              {isCurrent && (
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400" aria-hidden="true"></span>
              )}
            </a>
          );
        })
      }
    </nav>
  </div>
</header>

<script>
  function setupMobileMenu() {
    const btn = document.getElementById("mobile-menu-btn");
    const menu = document.getElementById("mobile-nav");
    const closedIcon = document.getElementById("menu-icon-closed");
    const openIcon = document.getElementById("menu-icon-open");

    if (!btn || !menu) return;

    function openMenu() {
      btn?.setAttribute("aria-expanded", "true");
      btn?.setAttribute("aria-label", "Close main menu");
      menu?.classList.remove("hidden");
      closedIcon?.classList.add("hidden");
      openIcon?.classList.remove("hidden");
    }

    function closeMenu() {
      btn?.setAttribute("aria-expanded", "false");
      btn?.setAttribute("aria-label", "Open main menu");
      menu?.classList.add("hidden");
      closedIcon?.classList.remove("hidden");
      openIcon?.classList.add("hidden");
    }

    function toggleMenu() {
      const isExpanded = btn?.getAttribute("aria-expanded") === "true";
      if (isExpanded) {
        closeMenu();
      } else {
        openMenu();
      }
    }

    btn.onclick = (e) => {
      e.stopPropagation();
      toggleMenu();
    };

    // Close on navigation link click
    const links = menu.querySelectorAll(".mobile-nav-link");
    links.forEach((link) => {
      link.addEventListener("click", () => {
        closeMenu();
      });
    });

    // Close on Escape key
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && btn.getAttribute("aria-expanded") === "true") {
        closeMenu();
        btn.focus();
      }
    });

    // Close when clicking outside header
    document.addEventListener("click", (e) => {
      if (!menu.classList.contains("hidden")) {
        const header = btn.closest("header");
        if (header && !header.contains(e.target as Node)) {
          closeMenu();
        }
      }
    });

    // Reset menu on resize to desktop (>= 768px)
    window.addEventListener("resize", () => {
      if (window.innerWidth >= 768 && btn.getAttribute("aria-expanded") === "true") {
        closeMenu();
      }
    });
  }

  // Setup on initial DOM load
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupMobileMenu);
  } else {
    setupMobileMenu();
  }
  document.addEventListener("astro:page-load", setupMobileMenu);
</script>
