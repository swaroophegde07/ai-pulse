---
// NewsCard.astro — individual article card

interface SourceItem {
  title?: string;
  url: string;
  publisher?: string;
}

interface Props {
  id: string;
  title: string;
  company: string;
  source: string;
  summary: string;
  url: string;
  date: string | null;
  category: string;
  fetched_at: string;
  isDemo?: boolean;
  topics?: string[];
  tags?: string[];
  key_points?: string[];
  impact_score?: number | null;
  sources?: SourceItem[];
  priority_label?: string;
  priority_explanation?: string;
  why_it_matters?: string;
  source_type?: string;
  summary_status?: string;
}

const {
  id,
  title,
  company,
  source,
  summary,
  url,
  date,
  category,
  fetched_at,
  isDemo = false,
  topics = [],
  tags = [],
  key_points = [],
  impact_score,
  sources = [],
  priority_label,
  priority_explanation,
  why_it_matters,
  source_type,
  summary_status,
} = Astro.props;

// Format dates for display.
function formatDate(iso: string | null): string {
  if (!iso) return "Date unknown";
  try {
    return new Date(iso).toLocaleDateString("en-US", {
      year: "numeric",
      month: "short",
      day: "numeric",
    });
  } catch {
    return "Date unknown";
  }
}

function formatFetchedAt(iso: string): string {
  try {
    return new Date(iso).toISOString().slice(0, 16).replace("T", " ") + " UTC";
  } catch {
    return "";
  }
}

const displayDate = formatDate(date);
const displayFetched = formatFetchedAt(fetched_at);

// Base URL for links
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

// Combined tags list (prefer new tags, fallback to topics)
const articleTags = tags.length > 0 ? tags : topics;

// Boilerplate / generic content detection
const isGenericWhy = (text?: string) =>
  !text ||
  text.includes("Provides verified empirical") ||
  text.includes("Highlights important industry") ||
  text.includes("Expands foundation model") ||
  text.includes("Introduces algorithmic methodologies");

const isGenericPoint = (point?: string) =>
  !point ||
  point.trim().length === 0 ||
  point.includes("Provides verified empirical") ||
  point.includes("Highlights important industry") ||
  point.includes("Expands foundation model") ||
  point.includes("Introduces algorithmic methodologies");

const hasValidKeyPoints =
  Array.isArray(key_points) &&
  key_points.length === 3 &&
  key_points.every((p) => typeof p === "string" && !isGenericPoint(p));

// Category styling map.
const categoryStyles: Record<string, string> = {
  "News": "text-sky-600 dark:text-sky-400 bg-sky-500/10 border-sky-500/20",
  "Research": "text-violet-600 dark:text-violet-400 bg-violet-500/10 border-violet-500/20",
  "Benchmark": "text-amber-600 dark:text-amber-400 bg-amber-500/10 border-amber-500/20",
  "Product Release": "text-emerald-600 dark:text-emerald-400 bg-emerald-500/10 border-emerald-500/20",
  "Opinion": "text-rose-600 dark:text-rose-400 bg-rose-500/10 border-rose-500/20",
};
const catStyle = categoryStyles[category] ?? categoryStyles["News"];

const priorityStyles: Record<string, string> = {
  "Must Know": "text-amber-600 dark:text-amber-300 bg-amber-500/10 border-amber-500/30",
  "Deep Dive": "text-cyan-600 dark:text-cyan-300 bg-cyan-500/10 border-cyan-500/30",
  "Worth a Look": "text-theme-muted bg-theme-elevated border-theme-border",
};
const prioStyle = priority_label ? (priorityStyles[priority_label] ?? priorityStyles["Worth a Look"]) : "";

const articlePayload = JSON.stringify({
  id,
  title,
  company,
  source,
  summary,
  url,
  date,
  displayDate,
  category,
  topics,
  tags: articleTags,
  key_points: hasValidKeyPoints ? key_points : [],
  impact_score: impact_score ?? null,
  sources: sources || [],
  priority_label: priority_label ?? null,
  priority_explanation: priority_explanation ?? null,
  why_it_matters: (!hasValidKeyPoints && why_it_matters && !isGenericWhy(why_it_matters)) ? why_it_matters : null,
  source_type: source_type ?? null,
  summary_status: summary_status ?? null,
});
---

<article
  class="group relative flex flex-col bg-theme-surface border border-theme-border rounded-lg overflow-hidden hover:border-theme-border-accent hover:bg-theme-hover news-card cursor-pointer"
  data-id={id}
  data-title={title.toLowerCase()}
  data-company={company.toLowerCase()}
  data-summary={summary.toLowerCase()}
  data-category={category.toLowerCase()}
  data-source={source.toLowerCase()}
  data-date={date ?? ""}
  data-topics={(topics || []).join(",").toLowerCase()}
  data-tags={articleTags.join(",").toLowerCase()}
  data-keypoints={(key_points || []).join(" ").toLowerCase()}
  data-impact={impact_score ?? 0}
  data-priority={priority_label ? priority_label.toLowerCase() : "worth a look"}
  data-article-payload={articlePayload}
>
  <!-- Demo badge -->
  {
    isDemo && (
      <div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-amber-500/50 to-transparent" />
    )
  }

  <div class="flex flex-col flex-1 p-5 gap-3">
    <!-- Top row: category + impact/priority + company -->
    <div class="flex items-center justify-between gap-2 flex-wrap">
      <div class="flex items-center gap-1.5 flex-wrap">
        <span
          class={`font-mono text-[10px] font-medium tracking-widest uppercase px-2 py-0.5 rounded border ${catStyle}`}
        >
          {category}
        </span>
        {
          impact_score !== undefined && impact_score !== null && impact_score >= 8 ? (
            <span
              class="font-mono text-[9px] font-semibold uppercase tracking-wider px-1.5 py-0.5 rounded border border-amber-500/40 bg-amber-500/10 text-amber-500 dark:text-amber-300"
              title={`Editorial Impact Score: ${impact_score}/10`}
            >
              High Impact · {impact_score}/10
            </span>
          ) : impact_score !== undefined && impact_score !== null && impact_score >= 6 ? (
            <span
              class="font-mono text-[9px] font-medium tracking-wider px-1.5 py-0.5 rounded border border-theme-border bg-theme-elevated text-theme-secondary"
              title={`Editorial Impact Score: ${impact_score}/10`}
            >
              Impact {impact_score}/10
            </span>
          ) : priority_label ? (
            <span
              class={`font-mono text-[9px] font-medium tracking-wider uppercase px-1.5 py-0.5 rounded border ${prioStyle}`}
              title={priority_explanation}
            >
              {priority_label}
            </span>
          ) : null
        }
      </div>
      <div class="flex items-center gap-2">
        <span class="font-mono text-[10px] text-theme-muted tracking-wide truncate max-w-[140px]" title={source_type ? `${company} (${source_type})` : company}>
          {isDemo && <span class="text-amber-600 mr-1">[DEMO]</span>}{company}
        </span>
        <!-- Bookmark button -->
        <button
          type="button"
          class="bookmark-btn inline-flex items-center justify-center w-8 h-8 -mr-1.5 rounded text-theme-muted hover:text-amber-500 hover:bg-theme-elevated focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-400 active:scale-90 transition-all duration-150 cursor-pointer"
          data-article-id={id}
          data-article-title={title}
          data-article-url={url}
          aria-label="Save article bookmark"
          title="Save article to local bookmarks"
        >
          <svg class="w-4 h-4 bookmark-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"></path>
          </svg>
        </button>
      </div>
    </div>

    <!-- Title (Clickable) -->
    <h3 class="text-sm font-semibold text-theme-primary leading-snug group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors line-clamp-3">
      <a
        href={url}
        target="_blank"
        rel="noopener noreferrer"
        class="hover:text-emerald-600 dark:hover:text-emerald-400 focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-emerald-500 rounded transition-colors"
      >
        {title}
      </a>
    </h3>

    <!-- Summary -->
    {
      hasValidKeyPoints && (!summary || summary.startsWith("[Automated summary unavailable]") || summary_status === "pending_quota") ? (
        <div class="flex items-center gap-2 py-0.5">
          <span class="inline-flex items-center gap-1.5 text-[10px] font-mono text-emerald-600 dark:text-emerald-400 bg-emerald-500/10 border border-emerald-500/20 px-2 py-0.5 rounded font-medium">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
            <span>Priority TL;DR Briefing</span>
          </span>
          <span class="text-[10px] font-mono text-theme-muted">
            {summary_status === "pending_quota" ? "Extended narrative in queue" : "Executive 3-point briefing"}
          </span>
        </div>
      ) : summary_status === "publisher_excerpt" || summary_status === "unverified_excerpt" || (summary && summary.startsWith("[Automated summary unavailable] ") && summary.length > 40) ? (
        <p class="text-xs text-theme-secondary leading-relaxed line-clamp-4">
          <span class="text-theme-muted font-mono text-[9px] mr-1 uppercase border border-theme-border bg-theme-elevated px-1 py-0.5 rounded tracking-wider">[Excerpt]</span>
          {summary.replace("[Automated summary unavailable] ", "")}
        </p>
      ) : summary_status === "pending_quota" ? (
        <p class="text-xs text-theme-secondary leading-relaxed line-clamp-4">
          <span class="text-amber-600 dark:text-amber-400 font-mono text-[9px] mr-1.5 uppercase border border-amber-500/30 px-1 py-0.5 rounded bg-amber-500/10">Summary in queue</span>
          {summary && !summary.startsWith("[Automated summary unavailable]") && summary.length > 20 ? (
            summary.replace("[Automated summary unavailable] ", "")
          ) : (
            <span class="italic text-theme-muted">Summary pending quota refresh — read the original article.</span>
          )}
        </p>
      ) : !summary || summary.startsWith("[Automated summary unavailable]") ? (
        <p class="text-xs text-theme-muted italic leading-relaxed line-clamp-4">
          Summary unavailable — read the original article.
        </p>
      ) : (
        <p class="text-xs text-theme-secondary leading-relaxed line-clamp-4">
          {summary}
        </p>
      )
    }

    <!-- Three-point TL;DR Key Points (AI-generated TL;DR with explicit labels) -->
    {
      hasValidKeyPoints && (
        <div class="bg-theme-elevated border border-theme-border rounded-md p-3 space-y-2 font-mono text-[11px] text-theme-secondary">
          <div class="text-[9px] uppercase tracking-wider text-theme-muted font-semibold mb-1 flex items-center justify-between">
            <span>AI-generated TL;DR</span>
            <span class="text-[8px] text-emerald-600 dark:text-emerald-400 font-medium">Synthesized Analysis</span>
          </div>
          <div class="flex items-start gap-1.5">
            <span class="text-emerald-600 dark:text-emerald-400 font-bold shrink-0 text-[10px]">What happened:</span>
            <span class="text-theme-secondary leading-snug">{key_points[0]}</span>
          </div>
          <div class="flex items-start gap-1.5">
            <span class="text-emerald-600 dark:text-emerald-400 font-bold shrink-0 text-[10px]">Why it matters:</span>
            <span class="text-theme-secondary leading-snug">{key_points[1]}</span>
          </div>
          <div class="flex items-start gap-1.5">
            <span class="text-emerald-600 dark:text-emerald-400 font-bold shrink-0 text-[10px]">Who is affected:</span>
            <span class="text-theme-secondary leading-snug">{key_points[2]}</span>
          </div>
        </div>
      )
    }

    <!-- Why it matters (if available, no TL;DR present, and not generic) -->
    {
      !hasValidKeyPoints && why_it_matters && !isGenericWhy(why_it_matters) && (
        <div class="bg-theme-elevated border border-theme-border rounded px-2.5 py-1.5 text-[11px] text-theme-secondary font-mono leading-relaxed">
          <span class="text-emerald-600 dark:text-emerald-400 font-medium mr-1.5 uppercase tracking-wider text-[9px]">Why it matters:</span>
          {why_it_matters}
        </div>
      )
    }

    <!-- Clickable Entity Tags (Semantic link with in-page override on News page) -->
    {
      articleTags.length > 0 && (
        <div class="flex flex-wrap gap-1.5 pt-0.5">
          {articleTags.slice(0, 5).map((t) => (
            <a
              href={`${base}/news/?q=${encodeURIComponent(t.toLowerCase())}`}
              class="tag-pill chip-interactive text-[10px] font-mono text-theme-muted bg-theme-elevated hover:text-emerald-600 dark:hover:text-emerald-400 hover:border-theme-border-accent px-2 py-0.5 rounded border border-theme-border"
              data-tag={t.toLowerCase()}
              title={`Filter articles tagged #${t}`}
            >
              #{t}
            </a>
          ))}
        </div>
      )
    }

    <!-- Footer metadata & Links -->
    <footer class="flex flex-col gap-1.5 pt-2 border-t border-theme-border-subtle mt-auto">
      <div class="flex items-center justify-between gap-2 flex-wrap">
        <span class="font-mono text-[10px] text-theme-muted tracking-wide" title={source_type}>
          {source}
        </span>
        <time
          datetime={date ?? ""}
          data-article-time="true"
          data-pubdate={date ?? ""}
          class="font-mono text-[10px] text-theme-muted tracking-wide"
          title={date ? `Published: ${new Date(date).toUTCString()}${displayFetched ? ` · Ingested: ${displayFetched}` : ""}` : (displayFetched ? `Ingested: ${displayFetched}` : "Publication date unverified")}
          aria-label={date ? `Published ${displayDate}` : "Publication date unverified"}
        >
          {displayDate}
        </time>
      </div>

      <!-- Merged coverage sources (if deduplicated) -->
      {
        sources && sources.length > 1 && (
          <div class="font-mono text-[10px] text-theme-muted flex flex-wrap items-center gap-1.5 pt-0.5">
            <span class="text-theme-dim">Also reported by:</span>
            {sources.slice(1).map((s) => (
              <a
                href={s.url}
                target="_blank"
                rel="noopener noreferrer"
                class="text-theme-muted hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors inline-flex items-center gap-0.5"
                title={s.title || s.publisher || "Source link"}
              >
                <span>{s.publisher || "Source"}</span>
                <span>↗</span>
              </a>
            ))}
          </div>
        )
      }

      <!-- Footer Actions: Read source & Expand Brief -->
      <div class="flex items-center justify-between gap-2 mt-0.5 pt-0.5">
        <a
          href={url}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 font-mono text-[10px] text-theme-muted hover:text-emerald-600 dark:hover:text-emerald-400 focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-emerald-500 rounded px-1 -mx-1 transition-colors duration-150 group/link w-fit"
          aria-label={`Read full article: ${title} (opens in new tab)`}
        >
          <span>Read source</span>
          <svg
            class="w-3 h-3 group-hover/link:translate-x-0.5 group-hover/link:-translate-y-0.5 transition-transform duration-150"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
            />
          </svg>
        </a>

        <!-- Expand / Focused Reader Trigger Button -->
        <button
          type="button"
          class="expand-btn btn-interactive inline-flex items-center gap-1 font-mono text-[10px] text-theme-muted hover:text-emerald-600 dark:hover:text-emerald-400 focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-emerald-500 rounded px-1.5 py-0.5 hover:bg-theme-elevated transition-colors cursor-pointer"
          data-expand-id={id}
          title="Expand briefing into focused reader view"
          aria-label={`Expand full briefing for ${title}`}
        >
          <span>Expand</span>
          <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4" />
          </svg>
        </button>
      </div>
    </footer>
  </div>
</article>
