---
// NewsCard.astro — individual article card

interface Props {
  id: string;
  title: string;
  company: string;
  source: string;
  summary: string;
  url: string;
  date: string | null;
  category: string;
  fetched_at: string;
  isDemo?: boolean;
  topics?: string[];
  priority_label?: string;
  priority_explanation?: string;
  why_it_matters?: string;
  source_type?: string;
  summary_status?: string;
}

const {
  id,
  title,
  company,
  source,
  summary,
  url,
  date,
  category,
  fetched_at,
  isDemo = false,
  topics = [],
  priority_label,
  priority_explanation,
  why_it_matters,
  source_type,
  summary_status,
} = Astro.props;

// Format dates for display.
function formatDate(iso: string | null): string {
  if (!iso) return "Date unknown";
  try {
    return new Date(iso).toLocaleDateString("en-US", {
      year: "numeric",
      month: "short",
      day: "numeric",
    });
  } catch {
    return "Date unknown";
  }
}

function formatFetchedAt(iso: string): string {
  try {
    return new Date(iso).toISOString().slice(0, 16).replace("T", " ") + " UTC";
  } catch {
    return "";
  }
}

const displayDate = formatDate(date);
const displayFetched = formatFetchedAt(fetched_at);

// Category styling map.
const categoryStyles: Record<string, string> = {
  "News": "text-sky-400 bg-sky-400/10 border-sky-400/20",
  "Research": "text-violet-400 bg-violet-400/10 border-violet-400/20",
  "Benchmark": "text-amber-400 bg-amber-400/10 border-amber-400/20",
  "Product Release": "text-emerald-400 bg-emerald-400/10 border-emerald-400/20",
  "Opinion": "text-rose-400 bg-rose-400/10 border-rose-400/20",
};
const catStyle = categoryStyles[category] ?? categoryStyles["News"];

const priorityStyles: Record<string, string> = {
  "Must Know": "text-amber-300 bg-amber-400/10 border-amber-500/30",
  "Deep Dive": "text-cyan-300 bg-cyan-400/10 border-cyan-500/30",
  "Worth a Look": "text-neutral-400 bg-neutral-800/40 border-neutral-700/50",
};
const prioStyle = priority_label ? (priorityStyles[priority_label] ?? priorityStyles["Worth a Look"]) : "";
---

<article
  class="group relative flex flex-col bg-neutral-900 border border-neutral-800 rounded-lg overflow-hidden hover:border-neutral-700 hover:bg-neutral-900/80 transition-all duration-200"
  data-id={id}
  data-title={title.toLowerCase()}
  data-company={company.toLowerCase()}
  data-summary={summary.toLowerCase()}
  data-category={category.toLowerCase()}
  data-source={source.toLowerCase()}
  data-date={date ?? ""}
  data-topics={topics.join(",").toLowerCase()}
  data-priority={priority_label ? priority_label.toLowerCase() : "worth a look"}
>
  <!-- Demo badge -->
  {
    isDemo && (
      <div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-amber-500/50 to-transparent" />
    )
  }

  <div class="flex flex-col flex-1 p-5 gap-3">
    <!-- Top row: category + priority + company -->
    <div class="flex items-center justify-between gap-2 flex-wrap">
      <div class="flex items-center gap-1.5 flex-wrap">
        <span
          class={`font-mono text-[10px] font-medium tracking-widest uppercase px-2 py-0.5 rounded border ${catStyle}`}
        >
          {category}
        </span>
        {
          priority_label && (
            <span
              class={`font-mono text-[9px] font-medium tracking-wider uppercase px-1.5 py-0.5 rounded border ${prioStyle}`}
              title={priority_explanation}
            >
              {priority_label}
            </span>
          )
        }
      </div>
      <div class="flex items-center gap-2">
        <span class="font-mono text-[10px] text-neutral-500 tracking-wide truncate max-w-[140px]" title={source_type ? `${company} (${source_type})` : company}>
          {isDemo && <span class="text-amber-600 mr-1">[DEMO]</span>}{company}
        </span>
        <!-- Bookmark button -->
        <button
          type="button"
          class="bookmark-btn inline-flex items-center justify-center w-8 h-8 -mr-1.5 rounded text-neutral-500 hover:text-amber-400 hover:bg-neutral-800/60 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-400 transition-colors cursor-pointer"
          data-article-id={id}
          data-article-title={title}
          data-article-url={url}
          aria-label="Save article bookmark"
          title="Save article to local bookmarks"
        >
          <svg class="w-4 h-4 bookmark-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"></path>
          </svg>
        </button>
      </div>
    </div>

    <!-- Title -->
    <h3 class="text-sm font-semibold text-neutral-100 leading-snug group-hover:text-white transition-colors line-clamp-3">
      {title}
    </h3>

    <!-- Summary -->
    {
      summary_status === "publisher_excerpt" || summary_status === "unverified_excerpt" || (summary && summary.startsWith("[Automated summary unavailable] ") && summary.length > 40) ? (
        <p class="text-xs text-neutral-400 leading-relaxed line-clamp-4">
          <span class="text-neutral-500 font-mono text-[9px] mr-1 uppercase border border-neutral-800 bg-neutral-950 px-1 py-0.5 rounded tracking-wider">[Excerpt]</span>
          {summary.replace("[Automated summary unavailable] ", "")}
        </p>
      ) : summary_status === "pending_quota" ? (
        <p class="text-xs text-neutral-400 leading-relaxed line-clamp-4">
          <span class="text-amber-500/80 font-mono text-[9px] mr-1.5 uppercase border border-amber-500/30 px-1 py-0.5 rounded bg-amber-500/10">Summary in queue</span>
          {summary && !summary.startsWith("[Automated summary unavailable]") && summary.length > 20 ? (
            summary.replace("[Automated summary unavailable] ", "")
          ) : (
            <span class="italic text-neutral-500">Summary pending quota refresh — read the original article.</span>
          )}
        </p>
      ) : !summary || summary.startsWith("[Automated summary unavailable]") ? (
        <p class="text-xs text-neutral-500 italic leading-relaxed line-clamp-4">
          Summary unavailable — read the original article.
        </p>
      ) : (
        <p class="text-xs text-neutral-400 leading-relaxed line-clamp-4">
          {summary}
        </p>
      )
    }

    <!-- Why it matters (if available) -->
    {
      why_it_matters && (
        <div class="bg-neutral-950/60 border border-neutral-800/80 rounded px-2.5 py-1.5 text-[11px] text-neutral-400 font-mono leading-relaxed">
          <span class="text-emerald-400/90 font-medium mr-1.5 uppercase tracking-wider text-[9px]">Why it matters:</span>
          {why_it_matters}
        </div>
      )
    }

    <!-- Topics tags -->
    {
      topics.length > 0 && (
        <div class="flex flex-wrap gap-1 pt-1">
          {topics.slice(0, 3).map((t) => (
            <span class="text-[9px] font-mono text-neutral-500 bg-neutral-950 px-1.5 py-0.5 rounded border border-neutral-800/60">
              #{t}
            </span>
          ))}
        </div>
      )
    }

    <!-- Footer metadata -->
    <footer class="flex flex-col gap-1.5 pt-2 border-t border-neutral-800/60 mt-auto">
      <div class="flex items-center justify-between gap-2 flex-wrap">
        <span class="font-mono text-[10px] text-neutral-500 tracking-wide" title={source_type}>
          {source}
        </span>
        <time
          datetime={date ?? ""}
          class="font-mono text-[10px] text-neutral-500 tracking-wide"
          title={`Ingested: ${displayFetched}`}
        >
          {displayDate}
        </time>
      </div>

      <!-- External link -->
      <a
        href={url}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 font-mono text-[10px] text-neutral-500 hover:text-emerald-400 focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-emerald-400 rounded px-1 -mx-1 transition-colors duration-150 group/link mt-0.5 w-fit"
        aria-label={`Read full article: ${title} (opens in new tab)`}
      >
        <span>Read article</span>
        <svg
          class="w-3 h-3 group-hover/link:translate-x-0.5 group-hover/link:-translate-y-0.5 transition-transform duration-150"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
          />
        </svg>
      </a>
    </footer>
  </div>
</article>
