---
// NewsCard.astro — individual article card

interface Props {
  id: string;
  title: string;
  company: string;
  source: string;
  summary: string;
  url: string;
  date: string | null;
  category: string;
  fetched_at: string;
  isDemo?: boolean;
}

const {
  title,
  company,
  source,
  summary,
  url,
  date,
  category,
  fetched_at,
  isDemo = false,
} = Astro.props;

// Format dates for display.
function formatDate(iso: string | null): string {
  if (!iso) return "Date unknown";
  try {
    return new Date(iso).toLocaleDateString("en-US", {
      year: "numeric",
      month: "short",
      day: "numeric",
    });
  } catch {
    return "Date unknown";
  }
}

function formatFetchedAt(iso: string): string {
  try {
    return new Date(iso).toISOString().slice(0, 16).replace("T", " ") + " UTC";
  } catch {
    return "";
  }
}

const displayDate = formatDate(date);
const displayFetched = formatFetchedAt(fetched_at);

// Category styling map.
const categoryStyles: Record<string, string> = {
  "News": "text-sky-400 bg-sky-400/10 border-sky-400/20",
  "Research": "text-violet-400 bg-violet-400/10 border-violet-400/20",
  "Benchmark": "text-amber-400 bg-amber-400/10 border-amber-400/20",
  "Product Release": "text-emerald-400 bg-emerald-400/10 border-emerald-400/20",
  "Opinion": "text-rose-400 bg-rose-400/10 border-rose-400/20",
};
const catStyle = categoryStyles[category] ?? categoryStyles["News"];
---

<article
  class="group relative flex flex-col bg-neutral-900 border border-neutral-800 rounded-lg overflow-hidden hover:border-neutral-700 hover:bg-neutral-900/80 transition-all duration-200"
  data-title={title.toLowerCase()}
  data-company={company.toLowerCase()}
  data-summary={summary.toLowerCase()}
  data-category={category.toLowerCase()}
  data-source={source.toLowerCase()}
>
  <!-- Demo badge -->
  {
    isDemo && (
      <div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-amber-500/50 to-transparent" />
    )
  }

  <div class="flex flex-col flex-1 p-5 gap-3">
    <!-- Top row: category + company -->
    <div class="flex items-center justify-between gap-2 flex-wrap">
      <span
        class={`font-mono text-[10px] font-medium tracking-widest uppercase px-2 py-0.5 rounded border ${catStyle}`}
      >
        {category}
      </span>
      <span class="font-mono text-[10px] text-neutral-500 tracking-wide truncate max-w-[50%]">
        {isDemo && <span class="text-amber-600 mr-1">[DEMO]</span>}{company}
      </span>
    </div>

    <!-- Title -->
    <h3 class="text-sm font-semibold text-neutral-100 leading-snug group-hover:text-white transition-colors line-clamp-3">
      {title}
    </h3>

    <!-- Summary -->
    <p class="text-xs text-neutral-400 leading-relaxed line-clamp-4 flex-1">
      {summary}
    </p>

    <!-- Footer metadata -->
    <footer class="flex flex-col gap-1.5 pt-2 border-t border-neutral-800/60 mt-auto">
      <div class="flex items-center justify-between gap-2 flex-wrap">
        <span class="font-mono text-[10px] text-neutral-500 tracking-wide">
          {source}
        </span>
        <time
          datetime={date ?? ""}
          class="font-mono text-[10px] text-neutral-500 tracking-wide"
          title={`Ingested: ${displayFetched}`}
        >
          {displayDate}
        </time>
      </div>

      <!-- External link -->
      <a
        href={url}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 font-mono text-[10px] text-neutral-500 hover:text-emerald-400 transition-colors duration-150 group/link mt-0.5 w-fit"
        aria-label={`Read full article: ${title} (opens in new tab)`}
      >
        <span>Read article</span>
        <svg
          class="w-3 h-3 group-hover/link:translate-x-0.5 group-hover/link:-translate-y-0.5 transition-transform duration-150"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
          />
        </svg>
      </a>
    </footer>
  </div>
</article>
