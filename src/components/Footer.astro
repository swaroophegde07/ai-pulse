---
// Footer.astro — site footer

const currentYear = new Date().getFullYear();
const sources = [
  "Google DeepMind Blog",
  "Hugging Face Blog",
  "MIT News – AI",
  "The Gradient",
  "VentureBeat AI",
];
---

<footer class="border-t border-neutral-800 mt-16">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <!-- Brand -->
      <div class="flex flex-col gap-3">
        <span class="font-mono text-xs font-bold tracking-[0.25em] text-neutral-100">
          AI PULSE
        </span>
        <p class="text-xs text-neutral-500 leading-relaxed max-w-xs">
          A minimalist intelligence dashboard aggregating AI industry news,
          research, and model developments from reliable public sources.
        </p>
      </div>

      <!-- Data sources -->
      <div class="flex flex-col gap-3">
        <h3 class="font-mono text-[10px] text-neutral-500 tracking-widest uppercase">
          Data Sources
        </h3>
        <ul class="flex flex-col gap-1.5">
          {
            sources.map((src) => (
              <li class="font-mono text-[11px] text-neutral-600">
                {src}
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Links -->
      <div class="flex flex-col gap-3">
        <h3 class="font-mono text-[10px] text-neutral-500 tracking-widest uppercase">
          Project
        </h3>
        <ul class="flex flex-col gap-1.5">
          <li>
            <a
              href="https://github.com/ai-pulse"
              target="_blank"
              rel="noopener noreferrer"
              class="font-mono text-[11px] text-neutral-600 hover:text-emerald-400 transition-colors"
            >
              GitHub ↗
            </a>
          </li>
          <li>
            <span class="font-mono text-[11px] text-neutral-700">
              Summaries generated by Gemini API
            </span>
          </li>
          <li>
            <span class="font-mono text-[11px] text-neutral-700">
              Updated twice daily via GitHub Actions
            </span>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="mt-8 pt-6 border-t border-neutral-900 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-2">
      <p class="font-mono text-[10px] text-neutral-700 tracking-wide">
        &copy; {currentYear} AI Pulse. Content belongs to respective publishers.
      </p>
      <p class="font-mono text-[10px] text-neutral-700 tracking-wide">
        AI-generated summaries may contain errors. Verify with original sources.
      </p>
    </div>
  </div>
</footer>
