---
// Footer.astro — site footer
import sourcesData from "../data/sources.json";
import feedData from "../data/feed.json";
import buildData from "../data/build.json";
import benchmarksData from "../data/benchmarks.json";
import modelsData from "../data/models.json";
import pipelineStatusData from "../data/pipeline-status.json";

interface FeedRecord {
  source?: string;
  _demo?: boolean;
}

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const currentYear = new Date().getFullYear();

// Only consider genuine non-demonstration articles
const realArticles = (feedData as FeedRecord[]).filter((a) => !a._demo);
const contributingSourceNames = new Set(
  realArticles.map((a) => a.source).filter(Boolean)
);

// Sources that have actually contributed articles to the dataset
const contributingSources = sourcesData.filter((src) =>
  contributingSourceNames.has(src.name)
);

// Configured sources that do not yet have articles in the dataset
const pendingSources = sourcesData.filter(
  (src) => !contributingSourceNames.has(src.name)
);

// Build & Data provenance identifiers
const buildSha = (buildData as any)?.commit_sha ? (buildData as any).commit_sha.slice(0, 7) : "dev";
const buildTimestamp = (buildData as any)?.build_time || new Date().toISOString();
const benchmarkLastUpdated = (benchmarksData as any)?.metadata?.last_updated
  ? new Date((benchmarksData as any).metadata.last_updated).toISOString().slice(0, 10)
  : "Not recorded";
const modelsLastUpdated = Array.isArray(modelsData) && modelsData[0]?.last_verified
  ? modelsData[0].last_verified
  : "Not recorded";
const pipelineHealth = (pipelineStatusData as any)?.overall_status || "healthy";
const activeFeedsCount = (pipelineStatusData as any)?.feed_health?.active_sources || sourcesData.length;
const activeBenchmarkCount = (pipelineStatusData as any)?.summary?.active_benchmark_sources || 2;
---

<footer class="border-t border-theme-border mt-16 bg-theme-page">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <!-- Brand -->
      <div class="flex flex-col gap-3">
        <span class="font-mono text-xs font-bold tracking-[0.25em] text-theme-primary">
          AI PULSE
        </span>
        <p class="text-xs text-theme-muted leading-relaxed max-w-xs">
          A minimalist intelligence dashboard aggregating AI industry news,
          research, and model developments from reliable public sources.
        </p>
      </div>

      <!-- Data sources -->
      <div class="flex flex-col gap-3">
        <h3 class="font-mono text-[10px] text-theme-muted tracking-widest uppercase">
          Contributing Sources
        </h3>
        {
          contributingSources.length > 0 ? (
            <ul class="flex flex-col gap-1.5">
              {contributingSources.map((src) => (
                <li class="font-mono text-[11px] text-theme-secondary flex items-center justify-between">
                  <span>{src.name}</span>
                  <span class="text-[10px] text-theme-dim font-mono">
                    {src.publisher}
                  </span>
                </li>
              ))}
            </ul>
          ) : (
            <div class="flex flex-col gap-1">
              <span class="font-mono text-[11px] text-theme-muted">
                Awaiting initial ingestion
              </span>
              <span class="text-[10px] text-theme-dim leading-relaxed">
                {sourcesData.length} public feeds configured in pipeline.
              </span>
            </div>
          )
        }
        {
          contributingSources.length > 0 && pendingSources.length > 0 && (
            <p class="text-[10px] text-theme-dim font-mono pt-1 border-t border-theme-border-subtle">
              Also monitoring: {pendingSources.map((s) => s.name).join(", ")}
            </p>
          )
        }
      </div>

      <!-- Links -->
      <div class="flex flex-col gap-3">
        <h3 class="font-mono text-[10px] text-theme-muted tracking-widest uppercase">
          Project
        </h3>
        <ul class="flex flex-col gap-1.5">
          <li>
            <a
              href="https://github.com/swaroophegde07/ai-pulse"
              target="_blank"
              rel="noopener noreferrer"
              class="font-mono text-[11px] text-theme-secondary hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors inline-flex items-center gap-1 group"
              aria-label="View source repository on GitHub (opens in a new tab)"
            >
              <span>GitHub</span>
              <span class="group-hover:translate-x-0.5 transition-transform">↗</span>
            </a>
          </li>
          <li>
            <a
              href={`${base}/feedback/`}
              class="font-mono text-[11px] text-theme-secondary hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors inline-flex items-center gap-1"
            >
              <span>Feedback &amp; Bug Reports</span>
            </a>
          </li>
          <li>
            <span class="font-mono text-[11px] text-theme-dim">
              Summaries generated by Gemini API
            </span>
          </li>
          <li>
            <span class="font-mono text-[11px] text-theme-dim">
              Updated twice daily via GitHub Actions
            </span>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom bar with highlighted AI accuracy disclaimer -->
    <div class="mt-8 pt-6 border-t border-theme-border flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
      <p class="font-mono text-[11px] text-theme-muted tracking-wide order-2 md:order-1">
        &copy; {currentYear} AI Pulse. Content belongs to respective publishers.
      </p>
      <div
        class="order-1 md:order-2 inline-flex items-center gap-2 px-3 py-1.5 rounded-md border border-amber-500/30 bg-amber-500/10 text-amber-700 dark:text-amber-300 font-mono text-[11px] font-medium shadow-sm"
        role="note"
        aria-label="AI summary accuracy notice"
      >
        <svg class="w-3.5 h-3.5 shrink-0 text-amber-600 dark:text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
        </svg>
        <span>
          <strong class="font-semibold uppercase tracking-wider text-[10px] mr-1">Notice:</strong>
          AI-generated summaries may contain errors. Verify with original sources.
        </span>
      </div>
    </div>

    <!-- Build & Provenance Identifiers -->
    <div class="mt-4 pt-4 border-t border-theme-border-subtle flex flex-wrap items-center justify-between text-[10px] font-mono text-theme-dim gap-2">
      <div class="flex items-center gap-2">
        <span>Build: <strong class="text-theme-secondary font-semibold">{buildSha}</strong></span>
        <span>&middot;</span>
        <span>{buildTimestamp}</span>
        <span>&middot;</span>
        <span class="inline-flex items-center gap-1 text-emerald-600 dark:text-emerald-400">
          <span class="inline-block w-1.5 h-1.5 rounded-full bg-emerald-500 dark:bg-emerald-400"></span>
          Pipeline: {pipelineHealth} ({activeFeedsCount} feeds, {activeBenchmarkCount} benchmark suites)
        </span>
      </div>
      <div class="flex items-center gap-4">
        <span>Benchmarks data: <strong class="text-theme-secondary">{benchmarkLastUpdated}</strong></span>
        <span>Model catalog: <strong class="text-theme-secondary">{modelsLastUpdated}</strong></span>
      </div>
    </div>
  </div>
</footer>
