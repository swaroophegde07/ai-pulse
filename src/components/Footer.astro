---
// Footer.astro — site footer
import sourcesData from "../data/sources.json";
import feedData from "../data/feed.json";
import buildData from "../data/build.json";
import benchmarksData from "../data/benchmarks.json";
import modelsData from "../data/models.json";
import pipelineStatusData from "../data/pipeline-status.json";

interface FeedRecord {
  source?: string;
  _demo?: boolean;
}

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const currentYear = new Date().getFullYear();

// Only consider genuine non-demonstration articles
const realArticles = (feedData as FeedRecord[]).filter((a) => !a._demo);
const contributingSourceNames = new Set(
  realArticles.map((a) => a.source).filter(Boolean)
);

// Sources that have actually contributed articles to the dataset
const contributingSources = sourcesData.filter((src) =>
  contributingSourceNames.has(src.name)
);

// Configured sources that do not yet have articles in the dataset
const pendingSources = sourcesData.filter(
  (src) => !contributingSourceNames.has(src.name)
);

// Build & Data provenance identifiers
const buildSha = (buildData as any)?.commit_sha ? (buildData as any).commit_sha.slice(0, 7) : "dev";
const buildTimestamp = (buildData as any)?.build_time || new Date().toISOString();
const benchmarkLastUpdated = (benchmarksData as any)?.metadata?.last_updated
  ? new Date((benchmarksData as any).metadata.last_updated).toISOString().slice(0, 10)
  : "Not recorded";
const modelsLastUpdated = Array.isArray(modelsData) && modelsData[0]?.last_verified
  ? modelsData[0].last_verified
  : "Not recorded";
const pipelineHealth = (pipelineStatusData as any)?.overall_status || "healthy";
const activeFeedsCount = (pipelineStatusData as any)?.feed_health?.active_sources || sourcesData.length;
const activeBenchmarkCount = (pipelineStatusData as any)?.summary?.active_benchmark_sources || 2;
---

<footer class="border-t border-neutral-800 mt-16">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <!-- Brand -->
      <div class="flex flex-col gap-3">
        <span class="font-mono text-xs font-bold tracking-[0.25em] text-neutral-100">
          AI PULSE
        </span>
        <p class="text-xs text-neutral-500 leading-relaxed max-w-xs">
          A minimalist intelligence dashboard aggregating AI industry news,
          research, and model developments from reliable public sources.
        </p>
      </div>

      <!-- Data sources -->
      <div class="flex flex-col gap-3">
        <h3 class="font-mono text-[10px] text-neutral-500 tracking-widest uppercase">
          Contributing Sources
        </h3>
        {
          contributingSources.length > 0 ? (
            <ul class="flex flex-col gap-1.5">
              {contributingSources.map((src) => (
                <li class="font-mono text-[11px] text-neutral-400 flex items-center justify-between">
                  <span>{src.name}</span>
                  <span class="text-[10px] text-neutral-600 font-mono">
                    {src.publisher}
                  </span>
                </li>
              ))}
            </ul>
          ) : (
            <div class="flex flex-col gap-1">
              <span class="font-mono text-[11px] text-neutral-500">
                Awaiting initial ingestion
              </span>
              <span class="text-[10px] text-neutral-600 leading-relaxed">
                {sourcesData.length} public feeds configured in pipeline.
              </span>
            </div>
          )
        }
        {
          contributingSources.length > 0 && pendingSources.length > 0 && (
            <p class="text-[10px] text-neutral-600 font-mono pt-1 border-t border-neutral-900">
              Also monitoring: {pendingSources.map((s) => s.name).join(", ")}
            </p>
          )
        }
      </div>

      <!-- Links -->
      <div class="flex flex-col gap-3">
        <h3 class="font-mono text-[10px] text-neutral-500 tracking-widest uppercase">
          Project
        </h3>
        <ul class="flex flex-col gap-1.5">
          <li>
            <a
              href="https://github.com/swaroophegde07/ai-pulse"
              target="_blank"
              rel="noopener noreferrer"
              class="font-mono text-[11px] text-neutral-400 hover:text-emerald-400 transition-colors inline-flex items-center gap-1 group"
              aria-label="View source repository on GitHub (opens in a new tab)"
            >
              <span>GitHub</span>
              <span class="group-hover:translate-x-0.5 transition-transform">↗</span>
            </a>
          </li>
          <li>
            <a
              href={`${base}/feedback/`}
              class="font-mono text-[11px] text-neutral-400 hover:text-emerald-400 transition-colors inline-flex items-center gap-1"
            >
              <span>Feedback &amp; Bug Reports</span>
            </a>
          </li>
          <li>
            <span class="font-mono text-[11px] text-neutral-700">
              Summaries generated by Gemini API
            </span>
          </li>
          <li>
            <span class="font-mono text-[11px] text-neutral-700">
              Updated twice daily via GitHub Actions
            </span>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="mt-8 pt-6 border-t border-neutral-900 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-2">
      <p class="font-mono text-[10px] text-neutral-700 tracking-wide">
        &copy; {currentYear} AI Pulse. Content belongs to respective publishers.
      </p>
      <p class="font-mono text-[10px] text-neutral-700 tracking-wide">
        AI-generated summaries may contain errors. Verify with original sources.
      </p>
    </div>

    <!-- Build & Provenance Identifiers -->
    <div class="mt-4 pt-4 border-t border-neutral-900/60 flex flex-wrap items-center justify-between text-[10px] font-mono text-neutral-600 gap-2">
      <div class="flex items-center gap-2">
        <span>Build: <strong class="text-neutral-400 font-semibold">{buildSha}</strong></span>
        <span>&middot;</span>
        <span>{buildTimestamp}</span>
        <span>&middot;</span>
        <span class="inline-flex items-center gap-1 text-emerald-400">
          <span class="inline-block w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
          Pipeline: {pipelineHealth} ({activeFeedsCount} feeds, {activeBenchmarkCount} benchmark suites)
        </span>
      </div>
      <div class="flex items-center gap-4">
        <span>Benchmarks data: <strong class="text-neutral-400">{benchmarkLastUpdated}</strong></span>
        <span>Model catalog: <strong class="text-neutral-400">{modelsLastUpdated}</strong></span>
      </div>
    </div>
  </div>
</footer>
