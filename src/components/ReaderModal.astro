---
// src/components/ReaderModal.astro — Focused Intelligence Reader Modal
---

<!-- Modal Overlay -->
<div
  id="reader-modal-overlay"
  class="fixed inset-0 z-50 bg-black/60 backdrop-blur-sm hidden items-center justify-center p-3 sm:p-6"
  role="dialog"
  aria-modal="true"
  aria-labelledby="reader-modal-title"
>
  <!-- Modal Card -->
  <div
    id="reader-modal-card"
    class="bg-theme-surface border border-theme-border rounded-xl shadow-2xl max-w-2xl w-full max-h-[90vh] flex flex-col overflow-hidden relative"
    style="transform: scale(0.96); opacity: 0; transition: transform 180ms cubic-bezier(0.16, 1, 0.3, 1), opacity 180ms cubic-bezier(0.16, 1, 0.3, 1);"
  >
    <!-- Modal Header -->
    <header class="flex items-center justify-between gap-3 px-5 py-4 border-b border-theme-border bg-theme-surface">
      <div class="flex items-center gap-2 flex-wrap">
        <span
          id="reader-modal-category"
          class="font-mono text-[10px] font-medium tracking-widest uppercase px-2 py-0.5 rounded border border-sky-500/20 text-sky-600 dark:text-sky-400 bg-sky-500/10"
        >
          News
        </span>
        <span
          id="reader-modal-impact"
          class="hidden font-mono text-[9px] font-semibold uppercase tracking-wider px-1.5 py-0.5 rounded border"
        >
        </span>
        <span
          id="reader-modal-company"
          class="font-mono text-[11px] text-theme-muted tracking-wide"
        >
        </span>
      </div>

      <!-- Navigation & Close controls -->
      <div class="flex items-center gap-1.5 font-mono text-xs">
        <span id="reader-modal-counter" class="text-[10px] text-theme-muted mr-1.5">1 of 1</span>
        <button
          type="button"
          id="reader-prev-btn"
          class="btn-interactive w-7 h-7 inline-flex items-center justify-center rounded border border-theme-border hover:border-theme-border-accent hover:bg-theme-hover text-theme-muted hover:text-theme-primary cursor-pointer disabled:opacity-30 disabled:pointer-events-none"
          title="Previous article (Left arrow key)"
          aria-label="Previous article"
        >
          ←
        </button>
        <button
          type="button"
          id="reader-next-btn"
          class="btn-interactive w-7 h-7 inline-flex items-center justify-center rounded border border-theme-border hover:border-theme-border-accent hover:bg-theme-hover text-theme-muted hover:text-theme-primary cursor-pointer disabled:opacity-30 disabled:pointer-events-none"
          title="Next article (Right arrow key)"
          aria-label="Next article"
        >
          →
        </button>
        <button
          type="button"
          id="reader-close-btn"
          class="btn-interactive w-7 h-7 inline-flex items-center justify-center rounded border border-theme-border hover:border-theme-border-accent hover:bg-theme-hover text-theme-muted hover:text-theme-primary cursor-pointer ml-1"
          title="Close reader (Escape)"
          aria-label="Close reader"
        >
          ✕
        </button>
      </div>
    </header>

    <!-- Scrollable Article Body -->
    <div class="custom-scrollbar overflow-y-auto p-5 sm:p-6 space-y-4">
      <!-- Title -->
      <h2
        id="reader-modal-title"
        class="text-lg sm:text-xl font-bold text-theme-primary leading-snug"
      >
      </h2>

      <!-- Date & Source Telemetry -->
      <div class="flex items-center justify-between text-[11px] font-mono text-theme-muted border-b border-theme-border-subtle pb-3">
        <span id="reader-modal-source"></span>
        <time id="reader-modal-date"></time>
      </div>

      <!-- AI-Generated TL;DR Container -->
      <div
        id="reader-modal-tldr-box"
        class="bg-theme-elevated border border-theme-border rounded-lg p-3.5 space-y-2.5 font-mono text-xs text-theme-secondary"
      >
        <div class="text-[9px] uppercase tracking-wider text-theme-muted font-semibold mb-1 flex items-center justify-between">
          <span class="flex items-center gap-1.5">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
            AI-Synthesized Briefing
          </span>
          <span class="text-[9px] text-emerald-600 dark:text-emerald-400 font-medium">Verified Analysis</span>
        </div>
        <div class="space-y-2 text-[11px] leading-relaxed">
          <div class="flex items-start gap-2">
            <span class="text-emerald-600 dark:text-emerald-400 font-bold shrink-0">What happened:</span>
            <span id="reader-modal-point-1" class="text-theme-secondary"></span>
          </div>
          <div class="flex items-start gap-2">
            <span class="text-emerald-600 dark:text-emerald-400 font-bold shrink-0">Why it matters:</span>
            <span id="reader-modal-point-2" class="text-theme-secondary"></span>
          </div>
          <div class="flex items-start gap-2">
            <span class="text-emerald-600 dark:text-emerald-400 font-bold shrink-0">Who is affected:</span>
            <span id="reader-modal-point-3" class="text-theme-secondary"></span>
          </div>
        </div>
      </div>

      <!-- Single Why It Matters fallback (when TL;DR points not available) -->
      <div
        id="reader-modal-why-box"
        class="hidden bg-theme-elevated border border-theme-border rounded px-3 py-2 text-xs text-theme-secondary font-mono leading-relaxed"
      >
        <span class="text-emerald-600 dark:text-emerald-400 font-semibold mr-1.5 uppercase tracking-wider text-[10px]">Why it matters:</span>
        <span id="reader-modal-why-text"></span>
      </div>

      <!-- Summary / Excerpt -->
      <div class="space-y-1.5 pt-1">
        <h3 class="font-mono text-[10px] text-theme-muted uppercase tracking-wider">Executive Summary</h3>
        <p
          id="reader-modal-summary"
          class="text-xs sm:text-sm text-theme-secondary leading-relaxed"
        >
        </p>
      </div>

      <!-- Entity Tags -->
      <div id="reader-modal-tags-container" class="space-y-1.5 pt-2">
        <h3 class="font-mono text-[10px] text-theme-muted uppercase tracking-wider">Key Entities &amp; Tags</h3>
        <div id="reader-modal-tags" class="flex flex-wrap gap-1.5"></div>
      </div>

      <!-- Multi-source coverage -->
      <div id="reader-modal-sources-container" class="space-y-1.5 pt-2 border-t border-theme-border-subtle">
        <h3 class="font-mono text-[10px] text-theme-muted uppercase tracking-wider">Associated Sources &amp; Coverage</h3>
        <div id="reader-modal-sources" class="flex flex-wrap items-center gap-2 font-mono text-xs"></div>
      </div>
    </div>

    <!-- Modal Footer Actions -->
    <footer class="flex items-center justify-between gap-3 px-5 py-3.5 border-t border-theme-border bg-theme-surface flex-wrap">
      <div class="flex items-center gap-2">
        <button
          type="button"
          id="reader-bookmark-action"
          class="btn-interactive inline-flex items-center gap-1.5 font-mono text-xs px-3 py-1.5 rounded border border-theme-border hover:border-theme-border-accent text-theme-muted hover:text-amber-500 bg-theme-elevated cursor-pointer"
        >
          <svg id="reader-bookmark-icon" class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z" />
          </svg>
          <span id="reader-bookmark-text">Save Bookmark</span>
        </button>
        <button
          type="button"
          id="reader-copy-link"
          class="btn-interactive inline-flex items-center gap-1.5 font-mono text-xs px-3 py-1.5 rounded border border-theme-border hover:border-theme-border-accent text-theme-muted hover:text-theme-primary bg-theme-elevated cursor-pointer"
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
          </svg>
          <span id="reader-copy-text">Copy Link</span>
        </button>
      </div>

      <div>
        <a
          id="reader-source-link"
          href="#"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-interactive inline-flex items-center gap-1.5 font-mono text-xs px-4 py-1.5 rounded bg-emerald-600 hover:bg-emerald-500 text-white font-medium shadow-sm transition-colors cursor-pointer"
        >
          <span>Open Full Article</span>
          <span>↗</span>
        </a>
      </div>
    </footer>
  </div>
</div>

<script>
  (function () {
    const overlay = document.getElementById("reader-modal-overlay");
    const card = document.getElementById("reader-modal-card");
    const closeBtn = document.getElementById("reader-close-btn");
    const prevBtn = document.getElementById("reader-prev-btn") as HTMLButtonElement | null;
    const nextBtn = document.getElementById("reader-next-btn") as HTMLButtonElement | null;
    const counter = document.getElementById("reader-modal-counter");

    const catEl = document.getElementById("reader-modal-category");
    const impactEl = document.getElementById("reader-modal-impact");
    const companyEl = document.getElementById("reader-modal-company");
    const titleEl = document.getElementById("reader-modal-title");
    const sourceEl = document.getElementById("reader-modal-source");
    const dateEl = document.getElementById("reader-modal-date");
    const tldrBox = document.getElementById("reader-modal-tldr-box");
    const p1 = document.getElementById("reader-modal-point-1");
    const p2 = document.getElementById("reader-modal-point-2");
    const p3 = document.getElementById("reader-modal-point-3");
    const whyBox = document.getElementById("reader-modal-why-box");
    const whyText = document.getElementById("reader-modal-why-text");
    const summaryEl = document.getElementById("reader-modal-summary");
    const tagsContainer = document.getElementById("reader-modal-tags-container");
    const tagsEl = document.getElementById("reader-modal-tags");
    const sourcesContainer = document.getElementById("reader-modal-sources-container");
    const sourcesEl = document.getElementById("reader-modal-sources");
    const bookmarkAction = document.getElementById("reader-bookmark-action");
    const bookmarkIcon = document.getElementById("reader-bookmark-icon");
    const bookmarkText = document.getElementById("reader-bookmark-text");
    const copyLinkBtn = document.getElementById("reader-copy-link");
    const copyText = document.getElementById("reader-copy-text");
    const sourceLink = document.getElementById("reader-source-link") as HTMLAnchorElement | null;

    if (!overlay || !card) return;

    interface ArticlePayload {
      id: string;
      title: string;
      company: string;
      source: string;
      summary: string;
      url: string;
      date: string | null;
      displayDate: string;
      category: string;
      topics?: string[];
      tags?: string[];
      key_points?: string[];
      impact_score?: number | null;
      sources?: Array<{ title?: string; url: string; publisher?: string }>;
      priority_label?: string | null;
      priority_explanation?: string | null;
      why_it_matters?: string | null;
    }

    let activeArticles: ArticlePayload[] = [];
    let currentIndex = 0;

    function getSavedBookmarks(): string[] {
      try {
        const stored = localStorage.getItem("ai_pulse_bookmarks");
        return stored ? JSON.parse(stored) : [];
      } catch {
        return [];
      }
    }

    function isBookmarked(id: string): boolean {
      return getSavedBookmarks().includes(id);
    }

    function syncBookmarkButton(id: string) {
      const saved = isBookmarked(id);
      if (bookmarkIcon) {
        bookmarkIcon.setAttribute("fill", saved ? "currentColor" : "none");
        if (saved) {
          bookmarkIcon.parentElement?.classList.add("text-amber-500");
          bookmarkIcon.parentElement?.classList.remove("text-theme-muted");
        } else {
          bookmarkIcon.parentElement?.classList.remove("text-amber-500");
          bookmarkIcon.parentElement?.classList.add("text-theme-muted");
        }
      }
      if (bookmarkText) {
        bookmarkText.textContent = saved ? "Bookmarked" : "Save Bookmark";
      }
    }

    function renderModal(article: ArticlePayload) {
      if (!article) return;

      if (titleEl) titleEl.textContent = article.title;
      if (companyEl) companyEl.textContent = article.company;
      if (sourceEl) sourceEl.textContent = `Source: ${article.source}`;
      if (dateEl) {
        dateEl.textContent = article.displayDate || article.date || "Date unknown";
        if (article.date) dateEl.setAttribute("datetime", article.date);
      }

      // Category badge
      if (catEl) {
        catEl.textContent = article.category;
      }

      // Impact score badge
      if (impactEl) {
        if (typeof article.impact_score === "number" && article.impact_score >= 8) {
          impactEl.className = "font-mono text-[9px] font-semibold uppercase tracking-wider px-1.5 py-0.5 rounded border border-amber-500/40 bg-amber-500/10 text-amber-500 dark:text-amber-300";
          impactEl.textContent = `High Impact · ${article.impact_score}/10`;
          impactEl.classList.remove("hidden");
        } else if (typeof article.impact_score === "number" && article.impact_score >= 6) {
          impactEl.className = "font-mono text-[9px] font-medium tracking-wider px-1.5 py-0.5 rounded border border-theme-border bg-theme-elevated text-theme-secondary";
          impactEl.textContent = `Impact ${article.impact_score}/10`;
          impactEl.classList.remove("hidden");
        } else if (article.priority_label) {
          impactEl.className = "font-mono text-[9px] font-medium tracking-wider uppercase px-1.5 py-0.5 rounded border text-theme-muted bg-theme-elevated border-theme-border";
          impactEl.textContent = article.priority_label;
          impactEl.classList.remove("hidden");
        } else {
          impactEl.classList.add("hidden");
        }
      }

      // AI TL;DR Section
      const hasPoints = Array.isArray(article.key_points) && article.key_points.length === 3;
      if (tldrBox && p1 && p2 && p3) {
        if (hasPoints) {
          tldrBox.classList.remove("hidden");
          p1.textContent = article.key_points![0];
          p2.textContent = article.key_points![1];
          p3.textContent = article.key_points![2];
        } else {
          tldrBox.classList.add("hidden");
        }
      }

      // Why it matters fallback
      if (whyBox && whyText) {
        if (!hasPoints && article.why_it_matters) {
          whyBox.classList.remove("hidden");
          whyText.textContent = article.why_it_matters;
        } else {
          whyBox.classList.add("hidden");
        }
      }

      // Summary
      if (summaryEl) {
        const cleanSummary = (article.summary || "").replace("[Automated summary unavailable] ", "");
        summaryEl.textContent = cleanSummary || "Summary unavailable — visit the original article.";
      }

      // Entity tags
      if (tagsContainer && tagsEl) {
        const tags = article.tags || article.topics || [];
        if (tags.length > 0) {
          tagsContainer.classList.remove("hidden");
          const baseUrl = document.querySelector<HTMLAnchorElement>("a[href*='/news/']")?.href || "/ai-pulse/news/";
          tagsEl.innerHTML = tags.map((t) => `
            <a href="${baseUrl}?q=${encodeURIComponent(t.toLowerCase())}"
               class="tag-pill chip-interactive text-[10px] font-mono text-theme-muted bg-theme-elevated hover:text-emerald-600 dark:hover:text-emerald-400 hover:border-theme-border-accent px-2 py-0.5 rounded border border-theme-border"
               data-tag="${t.toLowerCase()}">
               #${t}
            </a>
          `).join("");
        } else {
          tagsContainer.classList.add("hidden");
        }
      }

      // Multi-sources
      if (sourcesContainer && sourcesEl) {
        if (article.sources && article.sources.length > 1) {
          sourcesContainer.classList.remove("hidden");
          sourcesEl.innerHTML = article.sources.slice(1).map((s) => `
            <a href="${s.url}" target="_blank" rel="noopener noreferrer"
               class="text-theme-muted hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors inline-flex items-center gap-1 border border-theme-border px-2 py-0.5 rounded bg-theme-elevated">
              <span>${s.publisher || "Source"}</span>
              <span>↗</span>
            </a>
          `).join("");
        } else {
          sourcesContainer.classList.add("hidden");
        }
      }

      // Action links
      if (sourceLink) {
        sourceLink.href = article.url;
      }

      // Counter
      if (counter) {
        counter.textContent = `${currentIndex + 1} of ${activeArticles.length}`;
      }

      // Nav buttons state
      if (prevBtn) prevBtn.disabled = currentIndex <= 0;
      if (nextBtn) nextBtn.disabled = currentIndex >= activeArticles.length - 1;

      // Bookmark action state
      syncBookmarkButton(article.id);
    }

    function openModalWithArticle(article: ArticlePayload, allArticles: ArticlePayload[], index: number) {
      activeArticles = allArticles;
      currentIndex = index;
      renderModal(article);

      overlay?.classList.remove("hidden");
      overlay?.classList.add("flex");
      document.body.classList.add("overflow-hidden");

      // Smooth entrance scale
      window.requestAnimationFrame(() => {
        if (card) {
          card.style.transform = "scale(1)";
          card.style.opacity = "1";
        }
      });
    }

    function closeModal() {
      if (!card || !overlay) return;
      card.style.transform = "scale(0.96)";
      card.style.opacity = "0";
      window.setTimeout(() => {
        overlay.classList.add("hidden");
        overlay.classList.remove("flex");
        document.body.classList.remove("overflow-hidden");
      }, 180);
    }

    function navigate(delta: number) {
      const nextIdx = currentIndex + delta;
      if (nextIdx >= 0 && nextIdx < activeArticles.length) {
        currentIndex = nextIdx;
        renderModal(activeArticles[currentIndex]);
      }
    }

    // Global click listener for card expand triggers
    document.addEventListener("click", (e) => {
      const target = e.target as HTMLElement | null;
      if (!target) return;

      // Check if user clicked an explicit expand button
      const expandBtn = target.closest<HTMLButtonElement>(".expand-btn");
      const cardEl = target.closest<HTMLElement>("article.news-card");

      if (expandBtn || (cardEl && !target.closest("a") && !target.closest(".bookmark-btn") && !target.closest(".tag-pill"))) {
        const articleCard = expandBtn?.closest<HTMLElement>("article.news-card") || cardEl;
        if (!articleCard) return;

        const payloadStr = articleCard.dataset.articlePayload;
        if (!payloadStr) return;

        try {
          const clickedArticle = JSON.parse(payloadStr) as ArticlePayload;
          // Gather currently visible articles in the same grid/container
          const container = articleCard.parentElement;
          const visibleCards = Array.from(
            (container || document).querySelectorAll<HTMLElement>("article.news-card")
          ).filter((el) => el.style.display !== "none");

          const allPayloads: ArticlePayload[] = [];
          let targetIndex = 0;

          visibleCards.forEach((c) => {
            const p = c.dataset.articlePayload;
            if (p) {
              const parsed = JSON.parse(p) as ArticlePayload;
              allPayloads.push(parsed);
              if (parsed.id === clickedArticle.id) {
                targetIndex = allPayloads.length - 1;
              }
            }
          });

          if (allPayloads.length === 0) {
            allPayloads.push(clickedArticle);
          }

          openModalWithArticle(clickedArticle, allPayloads, targetIndex);
        } catch {}
      }
    });

    // Close handlers
    closeBtn?.addEventListener("click", closeModal);
    overlay?.addEventListener("click", (e) => {
      if (e.target === overlay) closeModal();
    });

    // Nav handlers
    prevBtn?.addEventListener("click", () => navigate(-1));
    nextBtn?.addEventListener("click", () => navigate(1));

    // Keyboard handlers
    document.addEventListener("keydown", (e) => {
      if (overlay?.classList.contains("hidden")) return;
      if (e.key === "Escape") {
        e.preventDefault();
        closeModal();
      } else if (e.key === "ArrowLeft") {
        e.preventDefault();
        navigate(-1);
      } else if (e.key === "ArrowRight") {
        e.preventDefault();
        navigate(1);
      }
    });

    // Bookmark toggle inside modal
    bookmarkAction?.addEventListener("click", () => {
      const current = activeArticles[currentIndex];
      if (!current) return;

      const saved = getSavedBookmarks();
      const isSaved = saved.includes(current.id);
      let updated: string[];

      if (isSaved) {
        updated = saved.filter((id) => id !== current.id);
        window.dispatchEvent(new CustomEvent("ai-pulse:toast", {
          detail: { message: "Article removed from bookmarks", color: "bg-theme-muted" }
        }));
      } else {
        updated = Array.from(new Set([...saved, current.id]));
        window.dispatchEvent(new CustomEvent("ai-pulse:toast", {
          detail: { message: "Article saved to bookmarks", color: "bg-amber-400" }
        }));
      }

      try {
        localStorage.setItem("ai_pulse_bookmarks", JSON.stringify(updated));
      } catch {}

      syncBookmarkButton(current.id);

      // Also sync cards on page
      document.querySelectorAll<HTMLElement>(`article.news-card[data-id="${current.id}"]`).forEach((card) => {
        const btn = card.querySelector<HTMLButtonElement>(".bookmark-btn");
        const icon = btn?.querySelector<SVGElement>(".bookmark-icon");
        if (btn && icon) {
          const nowSaved = !isSaved;
          btn.setAttribute("aria-pressed", nowSaved ? "true" : "false");
          if (nowSaved) {
            btn.classList.add("text-amber-500");
            btn.classList.remove("text-theme-muted");
            icon.setAttribute("fill", "currentColor");
          } else {
            btn.classList.remove("text-amber-500");
            btn.classList.add("text-theme-muted");
            icon.setAttribute("fill", "none");
          }
        }
      });
    });

    // Copy link handler
    copyLinkBtn?.addEventListener("click", () => {
      const current = activeArticles[currentIndex];
      if (!current) return;

      const linkToCopy = current.url || window.location.href;
      navigator.clipboard?.writeText(linkToCopy).then(() => {
        if (copyText) copyText.textContent = "Copied!";
        window.dispatchEvent(new CustomEvent("ai-pulse:toast", {
          detail: { message: "Link copied to clipboard", color: "bg-emerald-400" }
        }));
        window.setTimeout(() => {
          if (copyText) copyText.textContent = "Copy Link";
        }, 1500);
      }).catch(() => {});
    });
  })();
</script>
