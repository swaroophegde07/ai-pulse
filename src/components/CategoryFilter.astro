---
// src/components/CategoryFilter.astro — client-side category, date, sort, publisher, topic, bookmark controls + pagination

interface Props {
  categories: string[];
  publishers: string[];
  topics: string[];
}

const { categories, publishers, topics } = Astro.props;
---

<div class="flex flex-col gap-4" id="filter-bar">
  <!-- Search input + Clear button -->
  <div class="relative">
    <label for="article-search" class="sr-only">Search articles</label>
    <div
      class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-theme-muted"
      aria-hidden="true"
    >
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"
        ></path>
      </svg>
    </div>
    <input
      id="article-search"
      type="search"
      role="searchbox"
      placeholder="Search articles by title, key points, tags, publisher…"
      class="w-full bg-theme-input border border-theme-border rounded-md pl-9 pr-10 py-2.5 text-xs text-theme-primary placeholder:text-theme-placeholder font-mono focus:outline-none focus:border-theme-border-accent focus:ring-1 focus:ring-emerald-500/20 transition-colors"
      aria-label="Search articles by title, publisher, summary, or category"
      autocomplete="off"
    />
    <button
      id="clear-search-btn"
      type="button"
      style="display: none;"
      class="btn-interactive absolute inset-y-0 right-0 pr-3 flex items-center text-theme-muted hover:text-theme-primary cursor-pointer"
      aria-label="Clear search input"
    >
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>
  </div>

  <!-- Primary Category & View Pills -->
  <div class="flex items-center justify-between flex-wrap gap-2">
    <div class="flex flex-wrap gap-1.5" role="toolbar" aria-label="Filter articles by category">
      <button
        type="button"
        data-category="all"
        class="category-btn chip-interactive active font-mono text-[10px] tracking-widest uppercase px-3 py-1.5 rounded border border-theme-border text-theme-primary bg-theme-elevated font-semibold hover:border-theme-border-accent"
        aria-pressed="true"
      >
        All
      </button>
      {
        categories.map((cat) => (
          <button
            type="button"
            data-category={cat.toLowerCase()}
            class="category-btn chip-interactive font-mono text-[10px] tracking-widest uppercase px-3 py-1.5 rounded border border-theme-border text-theme-muted hover:text-theme-primary hover:border-theme-border-accent bg-theme-surface"
            aria-pressed="false"
          >
            {cat}
          </button>
        ))
      }
      <!-- High Impact articles view pill -->
      <button
        type="button"
        id="high-impact-view-btn"
        data-high-impact="false"
        class="chip-interactive font-mono text-[10px] tracking-widest uppercase px-3 py-1.5 rounded border border-theme-border text-amber-500/90 hover:text-amber-500 hover:border-amber-500/40 bg-theme-surface"
        aria-pressed="false"
      >
        High Impact (<span id="high-impact-count">0</span>)
      </button>
      <!-- Saved articles view pill -->
      <button
        type="button"
        id="saved-view-btn"
        data-saved-view="false"
        class="chip-interactive font-mono text-[10px] tracking-widest uppercase px-3 py-1.5 rounded border border-theme-border text-amber-500/90 hover:text-amber-500 hover:border-amber-500/40 bg-theme-surface"
        aria-pressed="false"
      >
        Saved (<span id="saved-count">0</span>)
      </button>
    </div>

    <!-- Toggle Advanced Filters -->
    <button
      type="button"
      id="toggle-filters-btn"
      class="btn-interactive font-mono text-[11px] text-theme-secondary hover:text-emerald-600 dark:hover:text-emerald-400 focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-emerald-500 inline-flex items-center gap-1.5 py-1.5 px-2.5 rounded border border-theme-border hover:border-theme-border-accent bg-theme-surface cursor-pointer"
      aria-expanded="false"
      aria-controls="advanced-filters"
    >
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z"></path>
      </svg>
      <span>Filters & Sort</span>
      <span id="active-filters-count" class="hidden font-mono text-[9px] bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/30 px-1 rounded font-semibold">0</span>
    </button>
  </div>

  <!-- Collapsible Secondary Filters (Date, Sort, Publisher, Topic) -->
  <div
    id="advanced-filters"
    class="hidden border border-theme-border bg-theme-surface rounded-lg p-4 space-y-4"
  >
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      <!-- Date period filter -->
      <div>
        <label for="date-filter" class="block font-mono text-[10px] text-theme-muted uppercase tracking-wider mb-1.5">
          Date Window
        </label>
        <select
          id="date-filter"
          class="w-full bg-theme-input border border-theme-border rounded px-2.5 py-1.5 text-xs text-theme-primary font-mono focus:outline-none focus:border-theme-border-accent"
        >
          <option value="any">Any Time</option>
          <option value="today">Today</option>
          <option value="24h">Past 24 Hours</option>
          <option value="7d">Past 7 Days</option>
        </select>
      </div>

      <!-- Sorting filter -->
      <div>
        <label for="sort-filter" class="block font-mono text-[10px] text-theme-muted uppercase tracking-wider mb-1.5">
          Sort Order
        </label>
        <select
          id="sort-filter"
          class="w-full bg-theme-input border border-theme-border rounded px-2.5 py-1.5 text-xs text-theme-primary font-mono focus:outline-none focus:border-theme-border-accent"
        >
          <option value="newest">Newest First</option>
          <option value="important">Most Important</option>
          <option value="oldest">Oldest First</option>
        </select>
      </div>

      <!-- Publisher filter -->
      <div>
        <label for="publisher-filter" class="block font-mono text-[10px] text-theme-muted uppercase tracking-wider mb-1.5">
          Publisher
        </label>
        <select
          id="publisher-filter"
          class="w-full bg-theme-input border border-theme-border rounded px-2.5 py-1.5 text-xs text-theme-primary font-mono focus:outline-none focus:border-theme-border-accent"
        >
          <option value="all">All Publishers</option>
          {publishers.map((pub) => <option value={pub.toLowerCase()}>{pub}</option>)}
        </select>
      </div>

      <!-- Topic taxonomy filter -->
      <div>
        <label for="topic-filter" class="block font-mono text-[10px] text-theme-muted uppercase tracking-wider mb-1.5">
          Topic Tag
        </label>
        <select
          id="topic-filter"
          class="w-full bg-theme-input border border-theme-border rounded px-2.5 py-1.5 text-xs text-theme-primary font-mono focus:outline-none focus:border-theme-border-accent"
        >
          <option value="all">All Topics</option>
          {topics.map((top) => <option value={top.toLowerCase()}>{top}</option>)}
        </select>
      </div>
    </div>
  </div>

  <!-- Live Result count and Clear active filters -->
  <div class="flex items-center justify-between flex-wrap gap-2 pt-1">
    <p class="font-mono text-[11px] text-theme-muted tracking-wide" id="result-count" aria-live="polite">
      <!-- updated dynamically by JS -->
    </p>
    <button
      type="button"
      id="reset-all-filters-btn"
      style="display: none;"
      class="btn-interactive font-mono text-[10px] text-emerald-600 dark:text-emerald-400 hover:text-emerald-500 underline underline-offset-4 cursor-pointer"
    >
      Clear all filters
    </button>
  </div>
</div>

<script>
  (function () {
    const searchInput = document.getElementById("article-search") as HTMLInputElement | null;
    const clearSearchBtn = document.getElementById("clear-search-btn") as HTMLButtonElement | null;
    const categoryBtns = document.querySelectorAll<HTMLButtonElement>(".category-btn");
    const highImpactViewBtn = document.getElementById("high-impact-view-btn") as HTMLButtonElement | null;
    const highImpactCountSpan = document.getElementById("high-impact-count");
    const savedViewBtn = document.getElementById("saved-view-btn") as HTMLButtonElement | null;
    const savedCountSpan = document.getElementById("saved-count");
    const dateFilter = document.getElementById("date-filter") as HTMLSelectElement | null;
    const sortFilter = document.getElementById("sort-filter") as HTMLSelectElement | null;
    const publisherFilter = document.getElementById("publisher-filter") as HTMLSelectElement | null;
    const topicFilter = document.getElementById("topic-filter") as HTMLSelectElement | null;
    const toggleFiltersBtn = document.getElementById("toggle-filters-btn") as HTMLButtonElement | null;
    const advancedFilters = document.getElementById("advanced-filters");
    const resultCount = document.getElementById("result-count");
    const resetAllFiltersBtn = document.getElementById("reset-all-filters-btn") as HTMLButtonElement | null;
    const grid = document.getElementById("news-grid");
    const emptyState = document.getElementById("empty-state");
    const resetFilterBtn = document.getElementById("reset-filter-btn") as HTMLButtonElement | null;
    const loadMoreBtn = document.getElementById("load-more-btn") as HTMLButtonElement | null;
    const paginationControls = document.getElementById("pagination-controls");

    if (!grid || !searchInput) return;

    // Load initial article elements
    const originalArticles = Array.from(grid.querySelectorAll<HTMLElement>("article[data-title]"));

    // State
    let activeCategory = "all";
    let activePeriod = "any";
    let activeSort = "newest";
    let activePublisher = "all";
    let activeTopic = "all";
    let activeSavedOnly = false;
    let activeHighImpactOnly = false;
    let searchQuery = "";
    const PAGE_SIZE = 20;
    let currentPage = 1;
    let matchingArticles: HTMLElement[] = [];

    // LocalStorage bookmark helper
    function getSavedArticles(): string[] {
      try {
        const stored = localStorage.getItem("ai_pulse_bookmarks");
        return stored ? JSON.parse(stored) : [];
      } catch {
        return [];
      }
    }

    function saveArticle(id: string) {
      try {
        const set = new Set(getSavedArticles());
        set.add(id);
        localStorage.setItem("ai_pulse_bookmarks", JSON.stringify(Array.from(set)));
      } catch {}
      updateBookmarkUI();
    }

    function removeArticle(id: string) {
      try {
        const set = new Set(getSavedArticles());
        set.delete(id);
        localStorage.setItem("ai_pulse_bookmarks", JSON.stringify(Array.from(set)));
      } catch {}
      updateBookmarkUI();
    }

    function toggleBookmark(id: string) {
      const saved = getSavedArticles();
      if (saved.includes(id)) {
        removeArticle(id);
        window.dispatchEvent(new CustomEvent("ai-pulse:toast", {
          detail: { message: "Article removed from bookmarks", color: "bg-theme-muted" }
        }));
      } else {
        saveArticle(id);
        window.dispatchEvent(new CustomEvent("ai-pulse:toast", {
          detail: { message: "Article saved to bookmarks", color: "bg-amber-400" }
        }));
      }
      if (activeSavedOnly) {
        filterAndSort();
      }
    }

    function updateBookmarkUI() {
      const saved = getSavedArticles();
      if (savedCountSpan) {
        savedCountSpan.textContent = String(saved.length);
      }
      originalArticles.forEach((article) => {
        const id = article.dataset.id || "";
        const btn = article.querySelector<HTMLButtonElement>(".bookmark-btn");
        const icon = btn?.querySelector<SVGElement>(".bookmark-icon");
        if (btn && icon) {
          const isSaved = saved.includes(id);
          btn.setAttribute("aria-pressed", isSaved ? "true" : "false");
          if (isSaved) {
            btn.classList.add("text-amber-500");
            btn.classList.remove("text-theme-muted");
            icon.setAttribute("fill", "currentColor");
          } else {
            btn.classList.remove("text-amber-500");
            btn.classList.add("text-theme-muted");
            icon.setAttribute("fill", "none");
          }
        }
      });
    }

    function setCategoryBtnActive(btn: HTMLButtonElement, isActive: boolean) {
      btn.classList.toggle("active", isActive);
      btn.setAttribute("aria-pressed", isActive ? "true" : "false");
      if (isActive) {
        btn.classList.add("text-theme-primary", "bg-theme-elevated", "font-semibold");
        btn.classList.remove("text-theme-muted", "bg-theme-surface");
      } else {
        btn.classList.remove("text-theme-primary", "bg-theme-elevated", "font-semibold");
        btn.classList.add("text-theme-muted", "bg-theme-surface");
      }
    }

    // Attach bookmark handlers
    originalArticles.forEach((article) => {
      const btn = article.querySelector<HTMLButtonElement>(".bookmark-btn");
      if (btn) {
        btn.addEventListener("click", (e) => {
          e.preventDefault();
          e.stopPropagation();
          const id = article.dataset.id || "";
          toggleBookmark(id);
        });
      }
    });

    // Parse URL params on load
    function initFromURLParams() {
      const urlParams = new URLSearchParams(window.location.search);
      const q = urlParams.get("q");
      const cat = urlParams.get("category");
      const period = urlParams.get("period");
      const sort = urlParams.get("sort");
      const pub = urlParams.get("publisher");
      const topic = urlParams.get("topic");

      if (q && searchInput) {
        searchInput.value = q;
        searchQuery = q.toLowerCase().trim();
      }
      if (cat) activeCategory = cat.toLowerCase();
      if (period && dateFilter) {
        dateFilter.value = period;
        activePeriod = period;
      }
      if (sort && sortFilter) {
        sortFilter.value = sort;
        activeSort = sort;
      }
      if (pub && publisherFilter) {
        publisherFilter.value = pub.toLowerCase();
        activePublisher = pub.toLowerCase();
      }
      if (topic && topicFilter) {
        topicFilter.value = topic.toLowerCase();
        activeTopic = topic.toLowerCase();
      }

      // Auto-expand advanced filters if URL specified secondary filters
      if (
        (period && period !== "any") ||
        (sort && sort !== "newest") ||
        (pub && pub !== "all") ||
        (topic && topic !== "all")
      ) {
        if (advancedFilters && toggleFiltersBtn) {
          advancedFilters.classList.remove("hidden");
          toggleFiltersBtn.setAttribute("aria-expanded", "true");
        }
      }

      categoryBtns.forEach((b) => {
        const c = (b.dataset.category || "all").toLowerCase();
        const isActive = c === activeCategory;
        setCategoryBtnActive(b, isActive);
      });
    }

    function syncURLParams() {
      const params = new URLSearchParams();
      if (searchQuery) params.set("q", searchQuery);
      if (activeCategory !== "all") params.set("category", activeCategory);
      if (activePeriod !== "any") params.set("period", activePeriod);
      if (activeSort !== "newest") params.set("sort", activeSort);
      if (activePublisher !== "all") params.set("publisher", activePublisher);
      if (activeTopic !== "all") params.set("topic", activeTopic);

      const qs = params.toString();
      const newUrl = qs ? `${window.location.pathname}?${qs}` : window.location.pathname;
      window.history.replaceState({}, "", newUrl);
    }

    function checkActiveFilters(): boolean {
      return (
        searchQuery !== "" ||
        activeCategory !== "all" ||
        activePeriod !== "any" ||
        activeSort !== "newest" ||
        activePublisher !== "all" ||
        activeTopic !== "all" ||
        activeSavedOnly ||
        activeHighImpactOnly
      );
    }

    // Filter and Sort Engine
    function filterAndSort() {
      const now = new Date();
      const savedIds = new Set(getSavedArticles());

      matchingArticles = originalArticles.filter((article) => {
        const title = (article.dataset.title || "").toLowerCase();
        const company = (article.dataset.company || "").toLowerCase();
        const summary = (article.dataset.summary || "").toLowerCase();
        const category = (article.dataset.category || "").toLowerCase();
        const topics = (article.dataset.topics || "").toLowerCase();
        const tags = (article.dataset.tags || "").toLowerCase();
        const keypoints = (article.dataset.keypoints || "").toLowerCase();
        const impact = parseFloat(article.dataset.impact || "0");
        const dateStr = article.dataset.date;
        const id = article.dataset.id || "";

        // Saved filter
        if (activeSavedOnly && !savedIds.has(id)) return false;

        // High Impact filter
        if (activeHighImpactOnly && impact < 8) return false;

        // Search query
        if (searchQuery) {
          const match =
            title.includes(searchQuery) ||
            company.includes(searchQuery) ||
            summary.includes(searchQuery) ||
            category.includes(searchQuery) ||
            topics.includes(searchQuery) ||
            tags.includes(searchQuery) ||
            keypoints.includes(searchQuery);
          if (!match) return false;
        }

        // Category
        if (activeCategory !== "all" && category !== activeCategory) {
          return false;
        }

        // Publisher
        if (activePublisher !== "all" && company !== activePublisher) {
          return false;
        }

        // Topic
        if (activeTopic !== "all") {
          const artTopics = (article.dataset.topics || "")
            .toLowerCase()
            .split(",")
            .map((s) => s.trim())
            .filter(Boolean);
          if (!artTopics.includes(activeTopic)) {
            return false;
          }
        }

        // Date Period filter
        if (activePeriod !== "any") {
          if (!dateStr) return false; // undated articles excluded from strict date periods
          const artDate = new Date(dateStr);
          if (isNaN(artDate.getTime())) return false;

          if (activePeriod === "today") {
            // Compare local calendar date
            const isToday =
              artDate.getFullYear() === now.getFullYear() &&
              artDate.getMonth() === now.getMonth() &&
              artDate.getDate() === now.getDate();
            if (!isToday) return false;
          } else if (activePeriod === "24h") {
            // Rolling 24 hours
            const diffMs = now.getTime() - artDate.getTime();
            if (diffMs < 0 || diffMs > 24 * 60 * 60 * 1000) return false;
          } else if (activePeriod === "7d") {
            // Rolling 7 days
            const diffMs = now.getTime() - artDate.getTime();
            if (diffMs < 0 || diffMs > 7 * 24 * 60 * 60 * 1000) return false;
          }
        }

        return true;
      });

      // Sorting
      matchingArticles.sort((a, b) => {
        const da = a.dataset.date ? new Date(a.dataset.date).getTime() : 0;
        const db = b.dataset.date ? new Date(b.dataset.date).getTime() : 0;

        if (activeSort === "newest") {
          return db - da;
        } else if (activeSort === "oldest") {
          return da - db;
        } else if (activeSort === "important") {
          const getImportance = (art: HTMLElement): number => {
            const rawImpact = art.dataset.impact;
            const impact = rawImpact ? parseFloat(rawImpact) : 0;
            if (impact >= 1 && impact <= 10) return impact;
            const prio = (art.dataset.priority || "").toLowerCase();
            if (prio === "deep dive") return 8;
            if (prio === "must know") return 6;
            return 3;
          };
          const ia = getImportance(a);
          const ib = getImportance(b);
          if (ib !== ia) return ib - ia;
          return db - da;
        }
        return 0;
      });

      // Render pagination
      updateActiveFilterBadge();
      renderCurrentPage();
      syncURLParams();
    }

    function updateActiveFilterBadge() {
      let count = 0;
      if (activePeriod !== "any") count++;
      if (activeSort !== "newest") count++;
      if (activePublisher !== "all") count++;
      if (activeTopic !== "all") count++;

      const badge = document.getElementById("active-filters-count");
      if (badge) {
        if (count > 0) {
          badge.textContent = String(count);
          badge.classList.remove("hidden");
        } else {
          badge.classList.add("hidden");
        }
      }
    }

    function renderCurrentPage() {
      // Hide all first
      originalArticles.forEach((a) => (a.style.display = "none"));

      const totalMatches = matchingArticles.length;
      const countToShow = Math.min(currentPage * PAGE_SIZE, totalMatches);

      for (let i = 0; i < countToShow; i++) {
        const art = matchingArticles[i];
        art.style.display = "";
        grid?.appendChild(art); // re-append in sorted order
      }

      // Update Result Count text
      if (resultCount) {
        if (totalMatches === 0) {
          resultCount.textContent = "No matching articles found";
        } else if (countToShow < totalMatches) {
          resultCount.textContent = `Showing ${countToShow} of ${totalMatches} articles`;
        } else {
          resultCount.textContent = `Showing all ${totalMatches} matching article${totalMatches !== 1 ? "s" : ""}`;
        }
      }

      // Empty state
      if (emptyState) {
        emptyState.style.display = totalMatches === 0 ? "" : "none";
      }

      // Clear search button visibility
      if (clearSearchBtn) {
        clearSearchBtn.style.display = searchQuery ? "" : "none";
      }

      // Clear all filters button visibility
      if (resetAllFiltersBtn) {
        resetAllFiltersBtn.style.display = checkActiveFilters() ? "" : "none";
      }

      // Load More button visibility
      if (paginationControls && loadMoreBtn) {
        paginationControls.style.display = totalMatches > countToShow ? "" : "none";
      }
    }

    function updateHighImpactUI() {
      const count = originalArticles.filter(
        (a) => parseFloat(a.dataset.impact || "0") >= 8
      ).length;
      if (highImpactCountSpan) {
        highImpactCountSpan.textContent = String(count);
      }
    }

    function resetAllFilters() {
      if (searchInput) searchInput.value = "";
      searchQuery = "";
      activeCategory = "all";
      activePeriod = "any";
      activeSort = "newest";
      activePublisher = "all";
      activeTopic = "all";
      activeSavedOnly = false;
      activeHighImpactOnly = false;
      currentPage = 1;

      if (dateFilter) dateFilter.value = "any";
      if (sortFilter) sortFilter.value = "newest";
      if (publisherFilter) publisherFilter.value = "all";
      if (topicFilter) topicFilter.value = "all";

      if (highImpactViewBtn) {
        highImpactViewBtn.setAttribute("data-high-impact", "false");
        highImpactViewBtn.setAttribute("aria-pressed", "false");
        highImpactViewBtn.classList.remove("bg-amber-500/20", "text-amber-500", "dark:text-amber-300", "border-amber-500/40");
        highImpactViewBtn.classList.add("text-amber-500/90", "border-theme-border", "bg-theme-surface");
      }

      if (savedViewBtn) {
        savedViewBtn.setAttribute("data-saved-view", "false");
        savedViewBtn.setAttribute("aria-pressed", "false");
        savedViewBtn.classList.remove("bg-amber-500/20", "text-amber-500", "dark:text-amber-300", "border-amber-500/40");
        savedViewBtn.classList.add("text-amber-500/90", "border-theme-border", "bg-theme-surface");
      }

      categoryBtns.forEach((b) => {
        const c = (b.dataset.category || "all").toLowerCase();
        const isActive = c === "all";
        setCategoryBtnActive(b, isActive);
      });

      filterAndSort();
    }

    // Event Listeners
    searchInput.addEventListener("input", (e) => {
      searchQuery = (e.target as HTMLInputElement).value.toLowerCase().trim();
      currentPage = 1;
      filterAndSort();
    });

    searchInput.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && searchInput.value) {
        searchInput.value = "";
        searchQuery = "";
        currentPage = 1;
        filterAndSort();
      }
    });

    if (clearSearchBtn) {
      clearSearchBtn.addEventListener("click", () => {
        if (searchInput) searchInput.value = "";
        searchQuery = "";
        currentPage = 1;
        filterAndSort();
        searchInput?.focus();
      });
    }

    categoryBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        activeCategory = (btn.dataset.category || "all").toLowerCase();
        activeSavedOnly = false;
        activeHighImpactOnly = false;
        if (highImpactViewBtn) {
          highImpactViewBtn.setAttribute("data-high-impact", "false");
          highImpactViewBtn.setAttribute("aria-pressed", "false");
          highImpactViewBtn.classList.remove("bg-amber-500/20", "text-amber-500", "dark:text-amber-300", "border-amber-500/40");
          highImpactViewBtn.classList.add("text-amber-500/90", "border-theme-border", "bg-theme-surface");
        }
        if (savedViewBtn) {
          savedViewBtn.setAttribute("data-saved-view", "false");
          savedViewBtn.setAttribute("aria-pressed", "false");
          savedViewBtn.classList.remove("bg-amber-500/20", "text-amber-500", "dark:text-amber-300", "border-amber-500/40");
          savedViewBtn.classList.add("text-amber-500/90", "border-theme-border", "bg-theme-surface");
        }

        categoryBtns.forEach((b) => {
          const isActive = (b.dataset.category || "all").toLowerCase() === activeCategory;
          setCategoryBtnActive(b, isActive);
        });

        currentPage = 1;
        filterAndSort();
      });
    });

    if (highImpactViewBtn) {
      highImpactViewBtn.addEventListener("click", () => {
        activeHighImpactOnly = !activeHighImpactOnly;
        highImpactViewBtn.setAttribute("data-high-impact", activeHighImpactOnly ? "true" : "false");
        highImpactViewBtn.setAttribute("aria-pressed", activeHighImpactOnly ? "true" : "false");
        if (activeHighImpactOnly) {
          activeSavedOnly = false;
          if (savedViewBtn) {
            savedViewBtn.setAttribute("data-saved-view", "false");
            savedViewBtn.setAttribute("aria-pressed", "false");
            savedViewBtn.classList.remove("bg-amber-500/20", "text-amber-500", "dark:text-amber-300", "border-amber-500/40");
            savedViewBtn.classList.add("text-amber-500/90", "border-theme-border", "bg-theme-surface");
          }
          highImpactViewBtn.classList.add("bg-amber-500/20", "text-amber-500", "dark:text-amber-300", "border-amber-500/40");
          highImpactViewBtn.classList.remove("text-amber-500/90", "border-theme-border", "bg-theme-surface");
        } else {
          highImpactViewBtn.classList.remove("bg-amber-500/20", "text-amber-500", "dark:text-amber-300", "border-amber-500/40");
          highImpactViewBtn.classList.add("text-amber-500/90", "border-theme-border", "bg-theme-surface");
        }
        currentPage = 1;
        filterAndSort();
      });
    }

    if (savedViewBtn) {
      savedViewBtn.addEventListener("click", () => {
        activeSavedOnly = !activeSavedOnly;
        activeHighImpactOnly = false;
        if (highImpactViewBtn) {
          highImpactViewBtn.setAttribute("data-high-impact", "false");
          highImpactViewBtn.setAttribute("aria-pressed", "false");
          highImpactViewBtn.classList.remove("bg-amber-500/20", "text-amber-500", "dark:text-amber-300", "border-amber-500/40");
          highImpactViewBtn.classList.add("text-amber-500/90", "border-theme-border", "bg-theme-surface");
        }
        savedViewBtn.setAttribute("data-saved-view", activeSavedOnly ? "true" : "false");
        savedViewBtn.setAttribute("aria-pressed", activeSavedOnly ? "true" : "false");
        if (activeSavedOnly) {
          savedViewBtn.classList.add("bg-amber-500/20", "text-amber-500", "dark:text-amber-300", "border-amber-500/40");
          savedViewBtn.classList.remove("text-amber-500/90", "border-theme-border", "bg-theme-surface");
          // Deselect category pills visually
          categoryBtns.forEach((b) => {
            setCategoryBtnActive(b, false);
          });
        } else {
          savedViewBtn.classList.remove("bg-amber-500/20", "text-amber-500", "dark:text-amber-300", "border-amber-500/40");
          savedViewBtn.classList.add("text-amber-500/90", "border-theme-border", "bg-theme-surface");
        }
        currentPage = 1;
        filterAndSort();
      });
    }

    // Delegated click handler for article entity tag pills
    grid.addEventListener("click", (e) => {
      const target = (e.target as HTMLElement).closest(".tag-pill") as HTMLElement | null;
      if (target && target.dataset.tag) {
        e.preventDefault();
        e.stopPropagation();
        const clickedTag = target.dataset.tag.toLowerCase();
        if (searchInput) {
          searchInput.value = clickedTag;
          searchQuery = clickedTag;
          currentPage = 1;
          filterAndSort();
          const headerOffset = 120;
          const gridPos = grid.getBoundingClientRect().top + window.pageYOffset - headerOffset;
          window.scrollTo({ top: gridPos, behavior: "smooth" });
        }
      }
    });

    if (dateFilter) {
      dateFilter.addEventListener("change", () => {
        activePeriod = dateFilter.value;
        currentPage = 1;
        filterAndSort();
      });
    }

    if (sortFilter) {
      sortFilter.addEventListener("change", () => {
        activeSort = sortFilter.value;
        currentPage = 1;
        filterAndSort();
      });
    }

    if (publisherFilter) {
      publisherFilter.addEventListener("change", () => {
        activePublisher = publisherFilter.value;
        currentPage = 1;
        filterAndSort();
      });
    }

    if (topicFilter) {
      topicFilter.addEventListener("change", () => {
        activeTopic = topicFilter.value;
        currentPage = 1;
        filterAndSort();
      });
    }

    if (loadMoreBtn) {
      loadMoreBtn.addEventListener("click", () => {
        currentPage++;
        renderCurrentPage();
      });
    }

    if (resetFilterBtn) {
      resetFilterBtn.addEventListener("click", resetAllFilters);
    }

    if (resetAllFiltersBtn) {
      resetAllFiltersBtn.addEventListener("click", resetAllFilters);
    }

    // Toggle advanced filters
    if (toggleFiltersBtn && advancedFilters) {
      toggleFiltersBtn.addEventListener("click", () => {
        const isHidden = advancedFilters.classList.contains("hidden");
        if (isHidden) {
          advancedFilters.classList.remove("hidden");
          toggleFiltersBtn.setAttribute("aria-expanded", "true");
        } else {
          advancedFilters.classList.add("hidden");
          toggleFiltersBtn.setAttribute("aria-expanded", "false");
        }
      });
    }

    // Initialize
    updateBookmarkUI();
    updateHighImpactUI();
    initFromURLParams();
    filterAndSort();
  })();
</script>
