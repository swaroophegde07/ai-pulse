---
// src/pages/research/index.astro — Research Feed
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import NewsCard from "../../components/NewsCard.astro";
import Footer from "../../components/Footer.astro";
import feedData from "../../data/feed.json";

interface FeedRecord {
  id: string;
  title: string;
  company: string;
  source: string;
  summary: string;
  url: string;
  date: string | null;
  category: string;
  fetched_at: string;
  _demo?: boolean;
  topics?: string[];
  tags?: string[];
  key_points?: string[];
  impact_score?: number | null;
  sources?: { title?: string; url: string; publisher?: string }[];
  priority_label?: string;
  priority_explanation?: string;
  why_it_matters?: string;
  source_type?: string;
  summary_status?: string;
}

const feed = feedData as FeedRecord[];
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

// Only genuine, non-demonstration articles
const realArticles = feed.filter((a) => !a._demo);

// Deterministic research classification keywords
const RESEARCH_KEYWORDS = /\b(paper|preprint|arxiv|technical report|study|proof|algorithm|scaling law|interpretability|architecture|ablation|reinforcement learning|benchmark evaluation|empirical|foundational|deepmind|gradient)\b/i;

// Filter research papers, preprints, and lab findings
const researchArticles = realArticles
  .filter((a) => {
    // 1. Explicitly tagged Research
    if (a.category === "Research") return true;

    // 2. Published by dedicated research hubs
    const isResearchPublisher =
      a.company === "Google DeepMind" ||
      a.company === "The Gradient" ||
      a.company === "Microsoft Research";

    // 3. Or text/title matches substantive scientific keywords
    const matchesResearchContent =
      RESEARCH_KEYWORDS.test(a.title) || RESEARCH_KEYWORDS.test(a.summary);

    return isResearchPublisher || matchesResearchContent;
  })
  .sort((a, b) => {
    const da = a.date ? new Date(a.date).getTime() : 0;
    const db = b.date ? new Date(b.date).getTime() : 0;
    if (da !== db) return db - da;
    return new Date(b.fetched_at).getTime() - new Date(a.fetched_at).getTime();
  });

// Extract distinct research institutions represented in this feed
const researchPublishers = new Set(researchArticles.map((a) => a.company).filter(Boolean));
const labList = Array.from(researchPublishers).sort();

const researchLabs = [
  {
    name: "Google DeepMind",
    focus: "AlphaFold, Gemini architectures, reasoning, RL, frontier science",
    url: "https://deepmind.google/research/",
  },
  {
    name: "OpenAI Research",
    focus: "Reasoning models (o1/o3), scaling laws, alignment, synthetic data",
    url: "https://openai.com/research/",
  },
  {
    name: "Anthropic Research",
    focus: "Constitutional AI, mechanistic interpretability, safety evaluations",
    url: "https://www.anthropic.com/research",
  },
  {
    name: "Microsoft Research AI",
    focus: "Small language models (Phi), multimodal systems, autonomous agents",
    url: "https://www.microsoft.com/en-us/research/research-area/artificial-intelligence/",
  },
  {
    name: "Meta FAIR",
    focus: "Open scientific research, self-supervised learning, Llama models",
    url: "https://ai.meta.com/research/",
  },
  {
    name: "The Gradient",
    focus: "In-depth peer perspective, technical synthesis, ML essays",
    url: "https://thegradient.pub/",
  },
];
---

<Layout title="AI Research Feed & Publications">
  <Header currentPath="/research/" />

  <main id="main-content" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <!-- Header banner -->
    <div class="mb-10 animate-reveal">
      <div class="inline-flex items-center gap-2 font-mono text-[10px] tracking-widest uppercase px-2.5 py-1 rounded border border-purple-500/30 bg-purple-500/10 text-purple-600 dark:text-purple-400 mb-3">
        <span>Peer Intelligence & Preprints</span>
      </div>
      <h1 class="text-2xl sm:text-3xl font-bold text-theme-primary tracking-tight mb-2">
        Research Feed
      </h1>
      <p class="text-sm text-theme-secondary leading-relaxed max-w-3xl">
        Curated papers, preprints, technical reports, and algorithmic breakthroughs from leading AI research laboratories and scientific institutions.
      </p>
    </div>

    <!-- Quick stats overview -->
    <div class="grid grid-cols-2 sm:grid-cols-3 gap-4 mb-8">
      <div class="border border-theme-border bg-theme-surface p-4 rounded-lg">
        <span class="font-mono text-[10px] text-theme-muted tracking-widest uppercase block mb-1">
          Technical Publications
        </span>
        <span class="font-mono text-xl font-bold text-theme-primary">{researchArticles.length}</span>
      </div>
      <div class="border border-theme-border bg-theme-surface p-4 rounded-lg">
        <span class="font-mono text-[10px] text-theme-muted tracking-widest uppercase block mb-1">
          Active Contributing Labs
        </span>
        <span class="font-mono text-xl font-bold text-purple-600 dark:text-purple-400">
          {researchPublishers.size}
        </span>
      </div>
      <div class="border border-theme-border bg-theme-surface p-4 rounded-lg">
        <span class="font-mono text-[10px] text-theme-muted tracking-widest uppercase block mb-1">
          Monitored Research Hubs
        </span>
        <span class="font-mono text-xl font-bold text-theme-primary">{researchLabs.length}</span>
      </div>
    </div>

    <!-- Monitored Research Labs Directory -->
    <section class="mb-12 border border-theme-border bg-theme-surface rounded-lg p-6">
      <h2 class="text-xs font-mono text-theme-muted tracking-widest uppercase mb-4">
        Tracked Research Laboratories & Outlets
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {
          researchLabs.map((lab) => (
            <a
              href={lab.url}
              target="_blank"
              rel="noopener noreferrer"
              class="border border-theme-border bg-theme-elevated/60 p-4 rounded hover:border-theme-border-accent transition-colors group block"
            >
              <div class="flex items-center justify-between mb-1.5">
                <span class="font-semibold text-xs text-theme-primary group-hover:text-purple-600 dark:group-hover:text-purple-400 transition-colors">
                  {lab.name}
                </span>
                <span class="font-mono text-[10px] text-theme-dim group-hover:text-theme-muted">
                  ↗
                </span>
              </div>
              <p class="text-[11px] text-theme-secondary line-clamp-2 leading-relaxed font-mono">
                {lab.focus}
              </p>
            </a>
          ))
        }
      </div>
    </section>

    <!-- Research Articles List -->
    <section>
      <div class="flex items-center justify-between mb-6">
        <div>
          <h2 class="text-xs font-mono text-theme-muted tracking-widest uppercase">
            Publications & Technical Reports ({researchArticles.length})
          </h2>
          <p class="text-[11px] text-theme-muted font-mono mt-0.5">
            Filtered using deterministic scientific publication keywords and verified research lab sources.
          </p>
        </div>
        <div class="flex items-center gap-4">
          <a
            href="https://github.com/swaroophegde07/ai-pulse/issues/new?template=data_correction.yml&title=%5BData+Correction%5D%3A+Research+Publication+Inaccuracy+%28Research+Page%29"
            target="_blank"
            rel="noopener noreferrer"
            class="font-mono text-[10px] text-theme-muted hover:text-blue-500 transition-colors hidden sm:inline-flex items-center gap-1"
            title="Report inaccurate research data, lab attribution, or broken preprint links"
          >
            <span>Report a research-data issue</span>
            <span>↗</span>
          </a>
          <a
            href={`${base}/news/`}
            class="font-mono text-[10px] text-theme-muted hover:text-theme-accent transition-colors"
          >
            View all news →
          </a>
        </div>
      </div>

      <!-- Search and Lab Filter Toolbar -->
      <div class="border border-theme-border bg-theme-surface rounded-lg p-4 mb-6">
        <div class="flex flex-col sm:flex-row gap-3 justify-between items-start sm:items-center">
          <div class="relative w-full sm:w-80">
            <label for="research-search-input" class="sr-only">Search research publications</label>
            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-theme-muted">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
              </svg>
            </div>
            <input
              type="search"
              id="research-search-input"
              placeholder="Search papers, preprints, keywords..."
              class="w-full bg-theme-input border border-theme-border rounded pl-9 pr-14 py-2 text-xs text-theme-primary placeholder:text-theme-placeholder font-mono focus:outline-none focus:border-purple-500"
            />
            <div class="absolute inset-y-0 right-0 pr-2.5 flex items-center gap-1.5 pointer-events-none">
              <kbd class="hidden sm:inline-block px-1.5 py-0.5 text-[9px] font-mono text-theme-muted bg-theme-elevated border border-theme-border rounded shadow-xs" title="Press / to search">/</kbd>
            </div>
            <button
              type="button"
              id="clear-research-search"
              style="display: none;"
              class="absolute inset-y-0 right-0 pr-2.5 flex items-center text-theme-muted hover:text-theme-primary transition-colors cursor-pointer"
              aria-label="Clear research search"
            >
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
              </svg>
            </button>
          </div>

          <div class="flex items-center gap-2.5 w-full sm:w-auto flex-wrap">
            <button
              type="button"
              id="saved-research-btn"
              data-saved="false"
              class="chip-interactive font-mono text-xs uppercase tracking-wider px-3 py-2 rounded border border-theme-border text-amber-800 dark:text-amber-300 hover:text-amber-900 dark:hover:text-amber-200 hover:border-amber-500/40 bg-theme-surface shrink-0 cursor-pointer flex items-center gap-1.5"
              aria-pressed="false"
              title="Show only bookmarked papers"
            >
              <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
              </svg>
              <span>Saved (<span id="saved-research-count">0</span>)</span>
            </button>

            <label for="research-lab-filter" class="sr-only">Filter by Lab</label>
            <select
              id="research-lab-filter"
              class="flex-1 sm:flex-initial bg-theme-input border border-theme-border rounded px-3 py-2 text-xs text-theme-primary font-mono focus:outline-none focus:border-purple-500 cursor-pointer"
            >
              <option value="all">All Contributing Labs ({researchArticles.length})</option>
              {labList.map((lab) => <option value={lab.toLowerCase()}>{lab}</option>)}
            </select>
          </div>
        </div>

        <div class="flex items-center justify-between pt-3 mt-3 border-t border-theme-border-subtle text-[11px] font-mono text-theme-muted">
          <span id="research-count-label">Showing all {researchArticles.length} publications</span>
          <button
            type="button"
            id="reset-research-filters-btn"
            style="display: none;"
            class="text-purple-600 dark:text-purple-400 hover:underline underline-offset-4 cursor-pointer"
          >
            Clear filters
          </button>
        </div>
      </div>

      {
        researchArticles.length === 0 ? (
          <div class="border border-theme-border rounded-lg p-10 text-center bg-theme-surface">
            <p class="font-mono text-xs text-theme-secondary">
              No research articles currently indexed. Google DeepMind, Microsoft Research, and The Gradient articles will appear here automatically.
            </p>
          </div>
        ) : (
          <>
            <div id="research-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
              {researchArticles.map((article) => (
                <NewsCard
                  id={article.id}
                  title={article.title}
                  company={article.company}
                  source={article.source}
                  summary={article.summary}
                  url={article.url}
                  date={article.date}
                  category={article.category}
                  fetched_at={article.fetched_at}
                  isDemo={false}
                  topics={article.topics || []}
                  tags={article.tags || []}
                  key_points={article.key_points || []}
                  impact_score={article.impact_score}
                  sources={article.sources || []}
                  priority_label={article.priority_label}
                  priority_explanation={article.priority_explanation}
                  why_it_matters={article.why_it_matters}
                  source_type={article.source_type}
                  summary_status={article.summary_status}
                />
              ))}
            </div>

            <div
              id="no-research-matched"
              style="display: none;"
              class="border border-theme-border rounded-lg p-12 text-center bg-theme-surface"
            >
              <p class="font-mono text-xs text-theme-secondary mb-3">
                No research articles match your search query or selected laboratory.
              </p>
              <button
                type="button"
                id="empty-research-reset-btn"
                class="font-mono text-[10px] uppercase tracking-wider text-theme-primary hover:text-theme-primary px-3 py-1.5 rounded border border-theme-border bg-theme-elevated hover:bg-theme-hover transition-colors cursor-pointer"
              >
                Reset research filters
              </button>
            </div>

            <div class="mt-12 pt-6 border-t border-theme-border-subtle flex flex-wrap items-center justify-between gap-2 font-mono text-[11px] text-theme-muted">
              <span>Notice a misattributed lab or broken paper link?</span>
              <a
                href="https://github.com/swaroophegde07/ai-pulse/issues/new?template=data_correction.yml&title=%5BData+Correction%5D%3A+Research+Publication+Inaccuracy+%28Research+Page%29"
                target="_blank"
                rel="noopener noreferrer"
                class="text-theme-muted hover:text-blue-500 transition-colors inline-flex items-center gap-1"
              >
                <span>Report a research-data issue</span>
                <span>↗</span>
              </a>
            </div>
          </>
        )
      }
    </section>
  </main>

  <Footer />
</Layout>

<script>
  (function () {
    const searchInput = document.getElementById("research-search-input") as HTMLInputElement | null;
    const clearSearchBtn = document.getElementById("clear-research-search") as HTMLButtonElement | null;
    const labSelect = document.getElementById("research-lab-filter") as HTMLSelectElement | null;
    const countLabel = document.getElementById("research-count-label");
    const resetBtn = document.getElementById("reset-research-filters-btn") as HTMLButtonElement | null;
    const emptyResetBtn = document.getElementById("empty-research-reset-btn") as HTMLButtonElement | null;
    const savedBtn = document.getElementById("saved-research-btn") as HTMLButtonElement | null;
    const savedCountEl = document.getElementById("saved-research-count");
    const grid = document.getElementById("research-grid");
    const emptyState = document.getElementById("no-research-matched");

    if (!grid) return;
    const articles = Array.from(grid.querySelectorAll<HTMLElement>("article"));

    const BOOKMARK_STORAGE_KEY = "ai_pulse_bookmarks";
    function getBookmarks(): Set<string> {
      try {
        const stored = localStorage.getItem(BOOKMARK_STORAGE_KEY);
        if (stored) {
          return new Set(JSON.parse(stored));
        }
      } catch (e) {
        // graceful fallback if localStorage is blocked
      }
      return new Set();
    }

    let bookmarks = getBookmarks();
    let isSavedView = false;
    let currentSearch = "";
    let currentLab = "all";

    function updateBookmarkUI() {
      if (savedCountEl) {
        const researchIds = new Set(articles.map((a) => a.dataset.id).filter(Boolean));
        const matched = Array.from(bookmarks).filter((id) => researchIds.has(id)).length;
        savedCountEl.textContent = String(matched);
      }
      articles.forEach((art) => {
        const id = art.dataset.id || "";
        const isSaved = bookmarks.has(id);
        const btn = art.querySelector<HTMLButtonElement>(".bookmark-btn");
        const icon = btn?.querySelector<SVGElement>("svg polygon");
        if (btn && icon) {
          if (isSaved) {
            btn.classList.add("text-amber-800", "dark:text-amber-300");
            btn.classList.remove("text-theme-muted");
            icon.setAttribute("fill", "currentColor");
          } else {
            btn.classList.remove("text-amber-800", "dark:text-amber-300");
            btn.classList.add("text-theme-muted");
            icon.setAttribute("fill", "none");
          }
        }
      });
    }

    function toggleBookmark(id: string) {
      if (bookmarks.has(id)) {
        bookmarks.delete(id);
      } else {
        bookmarks.add(id);
      }
      try {
        localStorage.setItem(BOOKMARK_STORAGE_KEY, JSON.stringify(Array.from(bookmarks)));
      } catch (e) {}
      updateBookmarkUI();
      if (isSavedView) {
        filterResearch();
      }
    }

    function filterResearch() {
      let visible = 0;
      articles.forEach((art) => {
        const title = (art.dataset.title || "").toLowerCase();
        const company = (art.dataset.company || "").toLowerCase();
        const summary = (art.dataset.summary || "").toLowerCase();
        const tags = (art.dataset.tags || "").toLowerCase();
        const keypoints = (art.dataset.keypoints || "").toLowerCase();
        const artId = art.dataset.id || "";

        const matchesSearch =
          !currentSearch ||
          title.includes(currentSearch) ||
          company.includes(currentSearch) ||
          summary.includes(currentSearch) ||
          tags.includes(currentSearch) ||
          keypoints.includes(currentSearch);

        const matchesLab = currentLab === "all" || company === currentLab;
        const matchesSaved = !isSavedView || (artId ? bookmarks.has(artId) : false);

        const show = matchesSearch && matchesLab && matchesSaved;
        art.style.display = show ? "" : "none";
        if (show) visible++;
      });

      if (countLabel) {
        if (isSavedView) {
          countLabel.textContent = `Showing ${visible} saved publication${visible !== 1 ? "s" : ""}`;
        } else if (visible === articles.length && !currentSearch && currentLab === "all") {
          countLabel.textContent = `Showing all ${articles.length} publications`;
        } else if (visible === 0) {
          countLabel.textContent = "No matching publications";
        } else {
          countLabel.textContent = `Showing ${visible} of ${articles.length} publications`;
        }
      }

      if (emptyState) {
        emptyState.style.display = visible === 0 ? "block" : "none";
        const emptyMsg = emptyState.querySelector("p");
        if (emptyMsg) {
          if (isSavedView && visible === 0) {
            emptyMsg.textContent = "You have not saved any research publications yet. Click the bookmark star icon on any paper to save it for quick reference.";
          } else {
            emptyMsg.textContent = "No research publications match your search or filter criteria.";
          }
        }
      }

      const hasFilter = currentSearch !== "" || currentLab !== "all" || isSavedView;
      if (resetBtn) resetBtn.style.display = hasFilter ? "" : "none";
      if (clearSearchBtn) clearSearchBtn.style.display = currentSearch ? "" : "none";
    }

    function resetFilters() {
      if (searchInput) searchInput.value = "";
      if (labSelect) labSelect.value = "all";
      if (savedBtn) {
        isSavedView = false;
        savedBtn.dataset.saved = "false";
        savedBtn.setAttribute("aria-pressed", "false");
        savedBtn.classList.remove("bg-amber-500/10", "border-amber-500/40");
      }
      currentSearch = "";
      currentLab = "all";
      filterResearch();
    }

    if (savedBtn) {
      savedBtn.addEventListener("click", () => {
        isSavedView = !isSavedView;
        savedBtn.dataset.saved = isSavedView ? "true" : "false";
        savedBtn.setAttribute("aria-pressed", isSavedView ? "true" : "false");
        savedBtn.classList.toggle("bg-amber-500/10", isSavedView);
        savedBtn.classList.toggle("border-amber-500/40", isSavedView);
        filterResearch();
      });
    }

    // Attach bookmark handlers
    articles.forEach((article) => {
      const btn = article.querySelector<HTMLButtonElement>(".bookmark-btn");
      if (btn) {
        btn.addEventListener("click", (e) => {
          e.preventDefault();
          e.stopPropagation();
          const id = article.dataset.id || "";
          toggleBookmark(id);
        });
      }
    });

    // Keyboard shortcut '/' to focus search
    window.addEventListener("keydown", (e) => {
      if (
        e.key === "/" &&
        !["INPUT", "TEXTAREA", "SELECT"].includes((document.activeElement as HTMLElement)?.tagName)
      ) {
        e.preventDefault();
        searchInput?.focus();
      }
    });

    // Initialize bookmark states on load
    updateBookmarkUI();

    if (searchInput) {
      searchInput.addEventListener("input", (e) => {
        currentSearch = (e.target as HTMLInputElement).value.toLowerCase().trim();
        filterResearch();
      });

      searchInput.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && searchInput.value) {
          searchInput.value = "";
          currentSearch = "";
          filterResearch();
        }
      });
    }

    if (clearSearchBtn) {
      clearSearchBtn.addEventListener("click", () => {
        if (searchInput) searchInput.value = "";
        currentSearch = "";
        filterResearch();
        searchInput?.focus();
      });
    }

    if (labSelect) {
      labSelect.addEventListener("change", (e) => {
        currentLab = (e.target as HTMLSelectElement).value.toLowerCase();
        filterResearch();
      });
    }

    if (resetBtn) resetBtn.addEventListener("click", resetFilters);
    if (emptyResetBtn) emptyResetBtn.addEventListener("click", resetFilters);

    // Delegated click handler for article entity tag pills
    grid.addEventListener("click", (e) => {
      const target = (e.target as HTMLElement).closest(".tag-pill") as HTMLElement | null;
      if (target && target.dataset.tag) {
        e.preventDefault();
        e.stopPropagation();
        const clickedTag = target.dataset.tag.toLowerCase();
        if (searchInput) {
          searchInput.value = clickedTag;
          currentSearch = clickedTag;
          filterResearch();
          const headerOffset = 120;
          const gridPos = grid.getBoundingClientRect().top + window.pageYOffset - headerOffset;
          window.scrollTo({ top: gridPos, behavior: "smooth" });
        }
      }
    });
  })();
</script>
