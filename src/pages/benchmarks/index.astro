---
// src/pages/benchmarks/index.astro — Benchmarks Board (Coming Soon)
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<Layout title="Benchmarks — Coming Soon">
  <Header currentPath="/benchmarks/" />

  <main id="main-content" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="max-w-2xl border border-neutral-800 bg-neutral-900/50 rounded-lg p-8 sm:p-12">
      <div class="inline-flex items-center gap-2 font-mono text-[10px] tracking-widest uppercase px-2.5 py-1 rounded border border-amber-500/30 bg-amber-500/10 text-amber-400 mb-4">
        <span>Under Active Development</span>
      </div>
      <h1 class="text-2xl sm:text-3xl font-bold text-neutral-100 tracking-tight mb-4">
        Benchmark Board
      </h1>
      <p class="text-sm text-neutral-400 leading-relaxed mb-6">
        Standardized evaluations across MMLU-Pro, SWE-bench, GSM8k, HumanEval, and Math arenas. Tracking performance metrics, inference cost efficiency, and latency profiles.
      </p>
      <div class="border-t border-neutral-800 pt-6">
        <p class="text-xs text-neutral-500 mb-4">
          Planned capabilities for upcoming releases:
        </p>
        <ul class="space-y-2 font-mono text-xs text-neutral-400">
          <li class="flex items-center gap-2">
            <span class="text-emerald-400">▹</span> Side-by-side leaderboard comparison matrix
          </li>
          <li class="flex items-center gap-2">
            <span class="text-emerald-400">▹</span> Cost-per-token vs. performance Pareto frontiers
          </li>
          <li class="flex items-center gap-2">
            <span class="text-emerald-400">▹</span> Verified benchmark verification protocols to detect data contamination
          </li>
        </ul>
      </div>
      <div class="mt-8">
        <a
          href={`${base}/news/`}
          class="inline-flex items-center gap-2 font-mono text-xs text-neutral-300 hover:text-emerald-400 transition-colors"
        >
          <span>← Browse benchmark news and announcements</span>
        </a>
      </div>
    </div>
  </main>

  <Footer />
</Layout>
