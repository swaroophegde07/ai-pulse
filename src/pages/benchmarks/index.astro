---
// src/pages/benchmarks/index.astro — Multi-Source Benchmark Intelligence Dashboard
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import NewsCard from "../../components/NewsCard.astro";
import Footer from "../../components/Footer.astro";
import feedData from "../../data/feed.json";
import benchmarksData from "../../data/benchmarks.json";
import modelsData from "../../data/models.json";

interface FeedRecord {
  id: string;
  title: string;
  company: string;
  source: string;
  summary: string;
  url: string;
  date: string | null;
  category: string;
  fetched_at: string;
  _demo?: boolean;
}

interface BenchmarkRecord {
  model_name: string;
  canonical_id: string;
  internal_model_id?: string | null;
  match_confidence?: number | null;
  provider: string;
  benchmark_name: string;
  category: string;
  score: number;
  score_unit: string;
  evaluation_date: string | null;
  source: string;
  source_url: string;
  provenance: string;
  retrieved_at: string;
  notes?: string;
}

interface ModelRecord {
  id: string;
  name: string;
  provider: string;
  family: string;
  release_date: string;
  lifecycle_status: string;
  context_window: number;
  input_modalities: string[];
  output_modalities: string[];
  license_type: string;
  api_available: boolean;
  consumer_available: boolean;
  pricing?: {
    input_per_1m: number;
    output_per_1m: number;
    unit: string;
  };
  documentation_url: string;
  source_url: string;
  last_verified: string;
  notes?: string;
}

interface SourceNotice {
  source: string;
  url: string;
  status: string;
  description: string;
  attribution: string;
}

const feed = feedData as FeedRecord[];
const benchmarks = (benchmarksData.benchmarks || []) as BenchmarkRecord[];
const sources = (benchmarksData.metadata?.sources || []) as SourceNotice[];
const standards = (benchmarksData.benchmark_standards || []) as any[];
const models = (modelsData || []) as ModelRecord[];
const validationReport = benchmarksData.metadata?.validation_report || {
  retrieved_count: benchmarks.length,
  parsed_count: benchmarks.length,
  valid_count: benchmarks.length,
  duplicate_count: 0,
  conflict_count: 0,
  quarantined_count: 0,
  retained_count: benchmarks.length,
};
const lastEvalDate = benchmarksData.metadata?.health?.last_successful_evaluation_date || "2026-06-25";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

// Mapping from models.json ID to LiveBench canonical ID(s)
const modelToBenchId: Record<string, string> = {
  "openai/o1": "o1",
  "openai/o3-mini": "o3-mini",
  "openai/gpt-4o": "gpt-4o",
  "openai/gpt-4o-mini": "gpt-4o-mini",
  "anthropic/claude-3-5-sonnet": "claude-3-5-sonnet",
  "anthropic/claude-3-7-sonnet": "claude-3-7-sonnet",
  "anthropic/claude-3-5-haiku": "claude-3-5-haiku",
  "deepseek/deepseek-r1": "deepseek-r1",
  "deepseek/deepseek-v3": "deepseek-v3",
  "meta/llama-3-3-70b-instruct": "llama-3.3-70b-instruct",
  "meta/llama-3-1-405b-instruct": "llama-3.1-405b-instruct",
  "microsoft/phi-4": "phi-4",
  "mistral/mistral-large-2411": "mistral-large-2411",
  "google/gemini-2-0-flash": "gemini-2.0-flash",
  "google/gemini-2-0-pro-exp": "gemini-2.0-pro",
};

// Build dynamic head-to-head model comparison database
const dynamicModelDatabase: Record<string, any> = {};
for (const m of models) {
  const benchId = modelToBenchId[m.id] || m.id.split("/")[1] || m.id;

  const rRecord = benchmarks.find(
    (b) =>
      b.category === "Reasoning" &&
      ((b.internal_model_id && b.internal_model_id === m.id) ||
        b.canonical_id === benchId ||
        b.canonical_id === m.id)
  );
  const cRecord = benchmarks.find(
    (b) =>
      (b.category === "Coding" || b.category === "Agentic Coding") &&
      ((b.internal_model_id && b.internal_model_id === m.id) ||
        b.canonical_id === benchId ||
        b.canonical_id === m.id)
  );

  const ctxStr = m.context_window >= 1_000_000
    ? `${(m.context_window / 1_000_000).toFixed(m.context_window % 1_000_000 === 0 ? 0 : 1)}M tokens`
    : `${Math.round(m.context_window / 1000)}k tokens`;

  const pInStr = m.pricing ? `$${m.pricing.input_per_1m.toFixed(2)}` : "Not specified";
  const pOutStr = m.pricing ? `$${m.pricing.output_per_1m.toFixed(2)}` : "Not specified";

  const evalDate = rRecord?.evaluation_date || cRecord?.evaluation_date;
  const evalSource = rRecord ? `${rRecord.source} (${rRecord.evaluation_date || "Verified"})` : cRecord ? `${cRecord.source} (${cRecord.evaluation_date || "Verified"})` : "Not evaluated";

  dynamicModelDatabase[m.id] = {
    name: m.name,
    reasoning: rRecord ? `${rRecord.score.toFixed(1)}%` : "Not available",
    coding: cRecord ? `${cRecord.score.toFixed(1)}%` : "Not available",
    context: ctxStr,
    priceIn: pInStr,
    priceOut: pOutStr,
    license: m.license_type,
    evalSource: evalSource,
    evalDate: evalDate || "Not available",
  };
}

// Only real articles
const realArticles = feed.filter((a) => !a._demo);

// Filter articles related to benchmarks & evaluations
const benchmarkArticles = realArticles
  .filter(
    (a) =>
      a.category === "Benchmark" ||
      /benchmark|eval|leaderboard|arena|swe-bench|mmlu|humaneval|score|test/i.test(
        a.title
      ) ||
      /benchmark|eval|leaderboard|arena|elo/i.test(a.summary)
  )
  .sort((a, b) => {
    const da = a.date ? new Date(a.date).getTime() : 0;
    const db = b.date ? new Date(b.date).getTime() : 0;
    if (da !== db) return db - da;
    return new Date(b.fetched_at).getTime() - new Date(a.fetched_at).getTime();
  });

// Extract unique categories for explorer filter
const categories = ["All", ...Array.from(new Set(benchmarks.map((b) => b.category)))];

// Top verified benchmark records for overview highlights
const topReasoning = [...benchmarks]
  .filter((b) => b.category === "Reasoning")
  .sort((a, b) => b.score - a.score)[0];

const topCoding = [...benchmarks]
  .filter((b) => b.category === "Coding" || b.category === "Agentic Coding")
  .sort((a, b) => b.score - a.score)[0];

const topOverall = [...benchmarks]
  .filter((b) => b.category === "Composite")
  .sort((a, b) => b.score - a.score)[0];

// Verified cost efficiency record from model catalog
const costEfficientModel = [...models]
  .filter((m) => m.pricing && m.pricing.input_per_1m !== undefined)
  .sort((a, b) => (a.pricing!.input_per_1m) - (b.pricing!.input_per_1m))[0];
---

<Layout title="AI Benchmark Board & Model Intelligence — AI Pulse">
  <Header currentPath="/benchmarks/" />

  <main id="main-content" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <!-- Header banner -->
    <div class="mb-10">
      <div class="inline-flex items-center gap-2 font-mono text-[10px] tracking-widest uppercase px-2.5 py-1 rounded border border-blue-500/30 bg-blue-500/10 text-blue-400 mb-3">
        <span>Empirical Evaluations & Telemetry</span>
      </div>
      <h1 class="text-2xl sm:text-3xl font-bold text-neutral-100 tracking-tight mb-2">
        Benchmark Board
      </h1>
      <p class="text-sm text-neutral-400 leading-relaxed max-w-3xl">
        Multi-source evaluation intelligence covering standardized reasoning suites, autonomous coding benchmarks, and model telemetry across verified, independent sources.
      </p>
    </div>

    <!-- Benchmark Pipeline Integrity Strip -->
    <div class="mb-10 border border-neutral-800 bg-neutral-900/40 rounded-lg p-5">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-3 border-b border-neutral-800/80 pb-3 mb-4">
        <div class="flex items-center gap-2">
          <span class="inline-block w-2 h-2 rounded-full bg-emerald-400"></span>
          <span class="font-mono text-xs font-semibold text-neutral-200">Data Integrity & Validation Report</span>
          <span class="font-mono text-[10px] text-neutral-400">({lastEvalDate} Official Release)</span>
        </div>
        <div class="font-mono text-[10px] text-neutral-400">
          Source: Official LiveBench (Apache-2.0) & OpenRouter Catalog
        </div>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3 font-mono text-xs">
        <div class="bg-neutral-950/60 p-3 rounded border border-neutral-800/80">
          <div class="text-[10px] text-neutral-500 uppercase tracking-wider">Retrieved</div>
          <div class="text-neutral-200 font-bold mt-1 text-sm">{validationReport.retrieved_count}</div>
        </div>
        <div class="bg-neutral-950/60 p-3 rounded border border-neutral-800/80">
          <div class="text-[10px] text-neutral-500 uppercase tracking-wider">Parsed</div>
          <div class="text-neutral-200 font-bold mt-1 text-sm">{validationReport.parsed_count}</div>
        </div>
        <div class="bg-neutral-950/60 p-3 rounded border border-neutral-800/80">
          <div class="text-[10px] text-emerald-400 uppercase tracking-wider">Valid Verified</div>
          <div class="text-emerald-400 font-bold mt-1 text-sm">{validationReport.valid_count}</div>
        </div>
        <div class="bg-neutral-950/60 p-3 rounded border border-neutral-800/80">
          <div class="text-[10px] text-neutral-500 uppercase tracking-wider">Duplicates</div>
          <div class="text-neutral-200 font-bold mt-1 text-sm">{validationReport.duplicate_count}</div>
        </div>
        <div class="bg-neutral-950/60 p-3 rounded border border-neutral-800/80">
          <div class="text-[10px] text-neutral-500 uppercase tracking-wider">Conflicting/Quarantined</div>
          <div class="text-neutral-200 font-bold mt-1 text-sm">{validationReport.conflict_count + validationReport.quarantined_count}</div>
        </div>
        <div class="bg-neutral-950/60 p-3 rounded border border-neutral-800/80">
          <div class="text-[10px] text-blue-400 uppercase tracking-wider">Retained in UI</div>
          <div class="text-blue-400 font-bold mt-1 text-sm">{validationReport.retained_count}</div>
        </div>
      </div>
    </div>

    <!-- 4A. Overview Highlights -->
    <section class="mb-12">
      <h2 class="text-xs font-mono text-neutral-400 tracking-widest uppercase mb-4">
        Verified Evaluation Highlights
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <!-- Reasoning Leader -->
        <div class="border border-neutral-800 bg-neutral-900/40 p-5 rounded-lg flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-2">
              <span class="font-mono text-[10px] text-purple-400 uppercase tracking-wider">
                Reasoning Leader
              </span>
              <span class="font-mono text-[10px] text-neutral-500">LiveBench</span>
            </div>
            <div class="font-bold text-lg text-neutral-100 mb-1">
              {topReasoning ? topReasoning.model_name : "Not available"}
            </div>
            <p class="text-xs text-neutral-400 font-mono mb-3">
              Score: <span class="text-emerald-400 font-semibold">{topReasoning ? `${topReasoning.score}%` : "Not available"}</span> (Theory of Mind, Logic & Spatial)
            </p>
          </div>
          <div class="border-t border-neutral-800/80 pt-2 font-mono text-[9px] text-neutral-500">
            Source: LiveBench Independent Eval
          </div>
        </div>

        <!-- Coding Leader -->
        <div class="border border-neutral-800 bg-neutral-900/40 p-5 rounded-lg flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-2">
              <span class="font-mono text-[10px] text-emerald-400 uppercase tracking-wider">
                Coding Leader
              </span>
              <span class="font-mono text-[10px] text-neutral-500">LiveBench</span>
            </div>
            <div class="font-bold text-lg text-neutral-100 mb-1">
              {topCoding ? topCoding.model_name : "Not available"}
            </div>
            <p class="text-xs text-neutral-400 font-mono mb-3">
              Score: <span class="text-emerald-400 font-semibold">{topCoding ? `${topCoding.score}%` : "Not available"}</span> (Code Gen & Completion)
            </p>
          </div>
          <div class="border-t border-neutral-800/80 pt-2 font-mono text-[9px] text-neutral-500">
            Source: LiveBench Independent Eval
          </div>
        </div>

        <!-- Overall Average Leader -->
        <div class="border border-neutral-800 bg-neutral-900/40 p-5 rounded-lg flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-2">
              <span class="font-mono text-[10px] text-blue-400 uppercase tracking-wider">
                Overall Average
              </span>
              <span class="font-mono text-[10px] text-neutral-500">LiveBench</span>
            </div>
            <div class="font-bold text-lg text-neutral-100 mb-1">
              {topOverall ? topOverall.model_name : "Not available"}
            </div>
            <p class="text-xs text-neutral-400 font-mono mb-3">
              Score: <span class="text-emerald-400 font-semibold">{topOverall ? `${topOverall.score}%` : "Not available"}</span> across all tasks
            </p>
          </div>
          <div class="border-t border-neutral-800/80 pt-2 font-mono text-[9px] text-neutral-500">
            Source: LiveBench Verified Average
          </div>
        </div>

        <!-- Open Weights Efficiency Leader -->
        <div class="border border-neutral-800 bg-neutral-900/40 p-5 rounded-lg flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-2">
              <span class="font-mono text-[10px] text-amber-400 uppercase tracking-wider">
                Cost Efficiency
              </span>
              <span class="font-mono text-[10px] text-neutral-500">Model Catalog</span>
            </div>
            <div class="font-bold text-lg text-neutral-100 mb-1">
              {costEfficientModel ? costEfficientModel.name : "Not available"}
            </div>
            <p class="text-xs text-neutral-400 font-mono mb-3">
              Pricing: <span class="text-emerald-400 font-semibold">
                {costEfficientModel?.pricing ? `$${costEfficientModel.pricing.input_per_1m.toFixed(2)} / $${costEfficientModel.pricing.output_per_1m.toFixed(2)}` : "Not available"}
              </span> per 1M tokens ({costEfficientModel ? costEfficientModel.license_type : "Verified"})
            </p>
          </div>
          <div class="border-t border-neutral-800/80 pt-2 font-mono text-[9px] text-neutral-500">
            Source: Verified Model Specifications
          </div>
        </div>
      </div>
    </section>

    <!-- 4B. Benchmark Explorer -->
    <section class="mb-14 border border-neutral-800 bg-neutral-900/30 rounded-lg overflow-hidden">
      <div class="p-5 border-b border-neutral-800 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
        <div>
          <h2 class="text-xs font-mono text-neutral-300 tracking-widest uppercase">
            Benchmark Explorer
          </h2>
          <div class="flex items-center gap-2 mt-0.5">
            <p class="text-[11px] text-neutral-500 font-mono">
              Verified empirical evaluations with traceable provenance and scoring units.
            </p>
            <span class="text-neutral-700 hidden sm:inline">&middot;</span>
            <a
              href="https://github.com/swaroophegde07/ai-pulse/issues/new?template=data_correction.yml&title=%5BData+Correction%5D%3A+Benchmark+Evaluation+Inaccuracy&affected_page=https%3A%2F%2Fswaroophegde07.github.io%2Fai-pulse%2Fbenchmarks%2F&entity_type=Benchmark+Result+%28Score%2C+Suite+Name%2C+Metric%2C+Category%29"
              target="_blank"
              rel="noopener noreferrer"
              class="hidden sm:inline-flex items-center gap-1 font-mono text-[10px] text-neutral-400 hover:text-blue-400 transition-colors"
              title="Report a benchmark issue via GitHub Issue Form"
            >
              <span>Report a benchmark issue</span>
              <span>↗</span>
            </a>
          </div>
        </div>

        <!-- Search & Filter Controls -->
        <div class="flex flex-wrap items-center gap-3 w-full sm:w-auto">
          <div class="relative w-full sm:w-56">
            <label for="benchmark-search-input" class="sr-only">Search benchmark results</label>
            <div class="absolute inset-y-0 left-0 pl-2.5 flex items-center pointer-events-none text-neutral-500">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
              </svg>
            </div>
            <input
              type="search"
              id="benchmark-search-input"
              placeholder="Search model or benchmark..."
              class="bg-neutral-950 border border-neutral-800 rounded pl-8 pr-7 py-1.5 text-xs text-neutral-100 placeholder:text-neutral-600 font-mono focus:outline-none focus:border-blue-500 w-full"
            />
            <button
              type="button"
              id="clear-benchmark-search"
              style="display: none;"
              class="absolute inset-y-0 right-0 pr-2 flex items-center text-neutral-500 hover:text-neutral-200 transition-colors cursor-pointer"
              aria-label="Clear benchmark search"
            >
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
              </svg>
            </button>
          </div>

          <!-- Category filter select -->
          <label for="benchmark-category-filter" class="sr-only">Filter by Category</label>
          <select
            id="benchmark-category-filter"
            class="bg-neutral-950 border border-neutral-800 rounded px-3 py-1.5 text-xs text-neutral-300 font-mono focus:outline-none focus:border-blue-500 cursor-pointer"
          >
            {categories.map((c) => <option value={c.toLowerCase()}>{c}</option>)}
          </select>
        </div>
      </div>

      <div class="overflow-x-auto custom-scrollbar">
        <div class="block sm:hidden text-[10px] text-neutral-400 font-mono px-6 py-2 bg-neutral-950/80 border-b border-neutral-800/80">
          Swipe table horizontally for scores & provenance details →
        </div>
        <table class="w-full text-left text-xs font-mono" id="benchmarks-table">
          <thead>
            <tr class="border-b border-neutral-800 bg-neutral-950/40 text-neutral-500 text-[11px]">
              <th class="py-3 pl-6 pr-4 font-medium">Model</th>
              <th class="py-3 pr-4 font-medium">Provider</th>
              <th class="py-3 pr-4 font-medium">Benchmark Suite</th>
              <th class="py-3 pr-4 font-medium">Category</th>
              <th class="py-3 pr-4 font-medium">Score</th>
              <th class="py-3 pr-4 font-medium">Provenance</th>
              <th class="py-3 pr-6 text-right font-medium">Source</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-neutral-800/60 text-neutral-300">
            {
              benchmarks.map((b) => (
                <tr
                  class="benchmark-row hover:bg-neutral-800/30 transition-colors"
                  data-model={b.model_name.toLowerCase()}
                  data-provider={b.provider.toLowerCase()}
                  data-benchmark={b.benchmark_name.toLowerCase()}
                  data-category={b.category.toLowerCase()}
                >
                  <td class="py-3.5 pl-6 pr-4 font-semibold text-neutral-100">
                    {b.model_name}
                  </td>
                  <td class="py-3.5 pr-4 text-neutral-400">{b.provider}</td>
                  <td class="py-3.5 pr-4 text-neutral-300 font-medium">{b.benchmark_name}</td>
                  <td class="py-3.5 pr-4">
                    <span class="inline-block px-2 py-0.5 rounded text-[10px] border border-blue-500/20 bg-blue-500/10 text-blue-400">
                      {b.category}
                    </span>
                  </td>
                  <td class="py-3.5 pr-4 font-bold text-emerald-400">
                    {b.score.toFixed(1)} {b.score_unit === "Percentage" ? "%" : b.score_unit}
                  </td>
                  <td class="py-3.5 pr-4">
                    <span class="text-[10px] text-neutral-500 block">{b.provenance}</span>
                    <span class="text-[9px] text-neutral-600 block">{b.evaluation_date}</span>
                  </td>
                  <td class="py-3.5 pr-6 text-right">
                    <a
                      href={b.source_url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-1 text-[10px] text-neutral-400 hover:text-blue-400 transition-colors"
                      aria-label={`Source verification for ${b.benchmark_name} (opens in new tab)`}
                    >
                      <span>{b.source}</span>
                      <span>↗</span>
                    </a>
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <div
        id="no-benchmarks-matched"
        style="display: none;"
        class="p-12 text-center font-mono text-xs text-neutral-400 bg-neutral-950/40"
      >
        <p class="mb-3 text-neutral-300">No benchmark results match your search and category filter.</p>
        <button
          type="button"
          id="reset-benchmarks-filter-btn"
          class="font-mono text-[10px] uppercase tracking-wider text-neutral-300 hover:text-white px-3 py-1.5 rounded border border-neutral-700 bg-neutral-800 hover:bg-neutral-700 transition-colors cursor-pointer"
        >
          Reset benchmark filters
        </button>
      </div>

      <div class="px-6 py-2.5 bg-neutral-950/60 border-t border-neutral-800/80 flex flex-wrap items-center justify-between gap-2 text-[10px] font-mono text-neutral-500">
        <span>Evaluations parsed from official LiveBench releases</span>
        <a
          href="https://github.com/swaroophegde07/ai-pulse/issues/new?template=data_correction.yml&title=%5BData+Correction%5D%3A+Benchmark+Evaluation+Inaccuracy&affected_page=https%3A%2F%2Fswaroophegde07.github.io%2Fai-pulse%2Fbenchmarks%2F&entity_type=Benchmark+Result+%28Score%2C+Suite+Name%2C+Metric%2C+Category%29"
          target="_blank"
          rel="noopener noreferrer"
          class="text-neutral-400 hover:text-blue-400 transition-colors inline-flex items-center gap-1"
        >
          <span>Report a benchmark issue</span>
          <span>↗</span>
        </a>
      </div>
    </section>

    <!-- 4C. Model Head-to-Head Comparison -->
    <section
      id="model-comparison-section"
      class="mb-14 border border-neutral-800 bg-neutral-900/40 rounded-lg p-6"
      data-models-db={JSON.stringify(dynamicModelDatabase)}
    >
      <div class="mb-6">
        <h2 class="text-xs font-mono text-neutral-300 tracking-widest uppercase mb-1">
          Model Head-to-Head Comparison
        </h2>
        <p class="text-xs text-neutral-500 font-mono">
          Select two foundation models to compare verified empirical scores and pricing side-by-side.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
        <!-- Model A Selector -->
        <div>
          <label for="compare-model-a" class="block font-mono text-[10px] uppercase text-neutral-400 mb-2">
            Model A
          </label>
          <select
            id="compare-model-a"
            class="w-full bg-neutral-950 border border-neutral-800 rounded px-3 py-2 text-xs font-mono text-neutral-100 focus:outline-none focus:border-blue-500 cursor-pointer"
          >
            {
              models.map((m) => (
                <option value={m.id} selected={m.id === "openai/o1"}>
                  {m.name}
                </option>
              ))
            }
          </select>
        </div>

        <!-- Model B Selector -->
        <div>
          <label for="compare-model-b" class="block font-mono text-[10px] uppercase text-neutral-400 mb-2">
            Model B
          </label>
          <select
            id="compare-model-b"
            class="w-full bg-neutral-950 border border-neutral-800 rounded px-3 py-2 text-xs font-mono text-neutral-100 focus:outline-none focus:border-blue-500 cursor-pointer"
          >
            {
              models.map((m) => (
                <option value={m.id} selected={m.id === "deepseek/deepseek-r1"}>
                  {m.name}
                </option>
              ))
            }
          </select>
        </div>
      </div>

      <!-- Comparison Metrics Matrix -->
      <div class="border border-neutral-800 rounded-lg overflow-x-auto custom-scrollbar bg-neutral-950/60">
        <div class="block sm:hidden text-[10px] text-neutral-400 font-mono px-4 py-2 bg-neutral-950/80 border-b border-neutral-800/80">
          Swipe table horizontally to inspect comparison →
        </div>
        <table class="w-full text-left font-mono text-xs">
          <thead>
            <tr class="border-b border-neutral-800 text-neutral-500 text-[11px]">
              <th class="py-3 px-4 font-medium">Evaluation Dimension</th>
              <th class="py-3 px-4 font-medium text-neutral-200" id="col-name-a">{dynamicModelDatabase["openai/o1"]?.name || "Model A"}</th>
              <th class="py-3 px-4 font-medium text-neutral-200" id="col-name-b">{dynamicModelDatabase["deepseek/deepseek-r1"]?.name || "Model B"}</th>
              <th class="py-3 px-4 font-medium text-neutral-500">Source & Provenance</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-neutral-800/60 text-neutral-300">
            <tr>
              <td class="py-3 px-4 text-neutral-400">LiveBench Reasoning Score</td>
              <td class="py-3 px-4 font-bold text-emerald-400" id="cmp-reasoning-a">{dynamicModelDatabase["openai/o1"]?.reasoning || "Not available"}</td>
              <td class="py-3 px-4 font-bold text-emerald-400" id="cmp-reasoning-b">{dynamicModelDatabase["deepseek/deepseek-r1"]?.reasoning || "Not available"}</td>
              <td class="py-3 px-4 text-[10px] text-neutral-500" id="cmp-provenance-reasoning">LiveBench Independent Eval</td>
            </tr>
            <tr>
              <td class="py-3 px-4 text-neutral-400">LiveBench Coding Score</td>
              <td class="py-3 px-4 font-bold text-emerald-400" id="cmp-coding-a">{dynamicModelDatabase["openai/o1"]?.coding || "Not available"}</td>
              <td class="py-3 px-4 font-bold text-emerald-400" id="cmp-coding-b">{dynamicModelDatabase["deepseek/deepseek-r1"]?.coding || "Not available"}</td>
              <td class="py-3 px-4 text-[10px] text-neutral-500" id="cmp-provenance-coding">LiveBench Independent Eval</td>
            </tr>
            <tr>
              <td class="py-3 px-4 text-neutral-400">Context Window</td>
              <td class="py-3 px-4 font-medium" id="cmp-context-a">{dynamicModelDatabase["openai/o1"]?.context || "Not available"}</td>
              <td class="py-3 px-4 font-medium" id="cmp-context-b">{dynamicModelDatabase["deepseek/deepseek-r1"]?.context || "Not available"}</td>
              <td class="py-3 px-4 text-[10px] text-neutral-500">OpenRouter Catalog</td>
            </tr>
            <tr>
              <td class="py-3 px-4 text-neutral-400">Input Price (per 1M tokens)</td>
              <td class="py-3 px-4 font-medium" id="cmp-price-in-a">{dynamicModelDatabase["openai/o1"]?.priceIn || "Not available"}</td>
              <td class="py-3 px-4 font-medium" id="cmp-price-in-b">{dynamicModelDatabase["deepseek/deepseek-r1"]?.priceIn || "Not available"}</td>
              <td class="py-3 px-4 text-[10px] text-neutral-500">Provider API Pricing</td>
            </tr>
            <tr>
              <td class="py-3 px-4 text-neutral-400">Output Price (per 1M tokens)</td>
              <td class="py-3 px-4 font-medium" id="cmp-price-out-a">{dynamicModelDatabase["openai/o1"]?.priceOut || "Not available"}</td>
              <td class="py-3 px-4 font-medium" id="cmp-price-out-b">{dynamicModelDatabase["deepseek/deepseek-r1"]?.priceOut || "Not available"}</td>
              <td class="py-3 px-4 text-[10px] text-neutral-500">Provider API Pricing</td>
            </tr>
            <tr>
              <td class="py-3 px-4 text-neutral-400">License / Weights</td>
              <td class="py-3 px-4 font-medium" id="cmp-license-a">{dynamicModelDatabase["openai/o1"]?.license || "Not available"}</td>
              <td class="py-3 px-4 font-medium" id="cmp-license-b">{dynamicModelDatabase["deepseek/deepseek-r1"]?.license || "Not available"}</td>
              <td class="py-3 px-4 text-[10px] text-neutral-500">Official Model Card</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- 4D. Standard Evaluation Suites Reference -->
    <section class="mb-14 border border-neutral-800 bg-neutral-900/40 rounded-lg p-6">
      <h2 class="text-xs font-mono text-neutral-300 tracking-widest uppercase mb-4">
        Industry Benchmark Standards
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {
          standards.map((s) => (
            <div class="border border-neutral-800 bg-neutral-950/60 p-4 rounded flex flex-col justify-between">
              <div>
                <div class="flex items-center justify-between mb-1.5">
                  <span class="font-semibold text-xs text-neutral-200">
                    {s.name}
                  </span>
                  <span class="font-mono text-[9px] text-blue-400 uppercase tracking-wider">
                    {s.category}
                  </span>
                </div>
                <p class="text-[11px] text-neutral-400 font-mono mb-2">
                  Eval Type: {s.eval_type}
                </p>
                <p class="text-[11px] text-neutral-500 leading-relaxed mb-3">
                  {s.description}
                </p>
              </div>
              <div class="border-t border-neutral-800/80 pt-2 font-mono text-[10px] text-neutral-400 flex justify-between items-center">
                <span>Top: {s.leader}</span>
                <a
                  href={s.reference_url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-neutral-500 hover:text-blue-400 transition-colors"
                >
                  ↗
                </a>
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <!-- 4E. Source Provenance, Transparency & Licensing -->
    <section class="mb-14 border border-neutral-800 bg-neutral-900/40 rounded-lg p-6">
      <h2 class="text-xs font-mono text-neutral-300 tracking-widest uppercase mb-4">
        Source Provenance & Licensing Disclosures
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 mb-4">
        {
          sources.map((src) => (
            <div class="border border-neutral-800 bg-neutral-950/60 p-4 rounded flex flex-col justify-between">
              <div>
                <div class="flex items-center justify-between mb-2">
                  <span class="font-semibold text-xs text-neutral-100">{src.source}</span>
                  <span class={`font-mono text-[9px] px-1.5 py-0.5 rounded ${
                    src.status.startsWith("Active")
                      ? "border border-emerald-500/30 bg-emerald-500/10 text-emerald-400"
                      : "border border-neutral-700 bg-neutral-800 text-neutral-400"
                  }`}>
                    {src.status.split("(")[0]}
                  </span>
                </div>
                <p class="text-[11px] text-neutral-400 leading-relaxed mb-2 font-mono">
                  {src.description}
                </p>
                <p class="text-[10px] text-neutral-500 leading-relaxed font-mono mb-3">
                  {src.attribution}
                </p>
              </div>
              <div class="border-t border-neutral-800/80 pt-2">
                <a
                  href={src.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="font-mono text-[10px] text-neutral-400 hover:text-blue-400 transition-colors inline-flex items-center gap-1"
                >
                  <span>Verify at source portal</span>
                  <span>↗</span>
                </a>
              </div>
            </div>
          ))
        }
      </div>
      <p class="text-[11px] text-neutral-500 font-mono leading-relaxed border-t border-neutral-800/80 pt-3">
        Important: AI Pulse strictly separates empirical benchmark scores from platform telemetry (e.g. OpenRouter usage). Benchmark evaluations measure specific task performance under fixed prompts, while usage telemetry reflects provider popularity. Neither represents a complete or universal ranking of artificial intelligence.
      </p>
    </section>

    <!-- Benchmark & Evaluation News -->
    <section>
      <div class="flex items-center justify-between mb-6">
        <div>
          <h2 class="text-xs font-mono text-neutral-400 tracking-widest uppercase">
            Benchmark & Evaluation Coverage ({benchmarkArticles.length})
          </h2>
          <p class="text-[11px] text-neutral-500 font-mono mt-0.5">
            Peer analysis, methodology critiques, and evaluation news from tracked sources.
          </p>
        </div>
        <a
          href={`${base}/news/`}
          class="font-mono text-[10px] text-neutral-500 hover:text-emerald-400 transition-colors"
        >
          View all news →
        </a>
      </div>

      {
        benchmarkArticles.length === 0 ? (
          <div class="border border-neutral-800 rounded-lg p-10 text-center bg-neutral-900/30">
            <p class="font-mono text-xs text-neutral-400 mb-2">
              No specific benchmark articles tagged yet.
            </p>
            <p class="font-mono text-[11px] text-neutral-500 max-w-md mx-auto">
              Evaluation analyses and benchmark scores from OpenAI, Google DeepMind, and Ars Technica will appear here automatically when classified under Benchmark.
            </p>
          </div>
        ) : (
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
            {benchmarkArticles.map((article) => (
              <NewsCard
                id={article.id}
                title={article.title}
                company={article.company}
                source={article.source}
                summary={article.summary}
                url={article.url}
                date={article.date}
                category={article.category}
                fetched_at={article.fetched_at}
                isDemo={false}
              />
            ))}
          </div>
        )
      }
    </section>
  </main>

  <Footer />
</Layout>

<script>
  (function () {
    // 1. Benchmark Explorer filtering & search
    const searchInput = document.getElementById("benchmark-search-input") as HTMLInputElement | null;
    const clearSearchBtn = document.getElementById("clear-benchmark-search") as HTMLButtonElement | null;
    const catSelect = document.getElementById("benchmark-category-filter") as HTMLSelectElement | null;
    const resetFilterBtn = document.getElementById("reset-benchmarks-filter-btn") as HTMLButtonElement | null;
    const rows = document.querySelectorAll<HTMLTableRowElement>(".benchmark-row");
    const emptyState = document.getElementById("no-benchmarks-matched");

    let currentSearch = "";
    let currentCategory = "all";

    function filterBenchmarks() {
      let visible = 0;
      rows.forEach((row) => {
        const model = row.dataset.model || "";
        const benchmark = row.dataset.benchmark || "";
        const provider = row.dataset.provider || "";
        const category = row.dataset.category || "";

        const matchesSearch =
          !currentSearch ||
          model.includes(currentSearch) ||
          benchmark.includes(currentSearch) ||
          provider.includes(currentSearch);

        const matchesCat =
          currentCategory === "all" || category === currentCategory;

        const show = matchesSearch && matchesCat;
        row.style.display = show ? "" : "none";
        if (show) visible++;
      });

      if (emptyState) {
        emptyState.style.display = visible === 0 ? "block" : "none";
      }

      if (clearSearchBtn) {
        clearSearchBtn.style.display = currentSearch ? "" : "none";
      }
    }

    if (searchInput) {
      searchInput.addEventListener("input", (e) => {
        currentSearch = (e.target as HTMLInputElement).value.toLowerCase().trim();
        filterBenchmarks();
      });

      searchInput.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && searchInput.value) {
          searchInput.value = "";
          currentSearch = "";
          filterBenchmarks();
        }
      });
    }

    if (clearSearchBtn) {
      clearSearchBtn.addEventListener("click", () => {
        if (searchInput) searchInput.value = "";
        currentSearch = "";
        filterBenchmarks();
        searchInput?.focus();
      });
    }

    if (catSelect) {
      catSelect.addEventListener("change", (e) => {
        currentCategory = (e.target as HTMLSelectElement).value.toLowerCase();
        filterBenchmarks();
      });
    }

    if (resetFilterBtn) {
      resetFilterBtn.addEventListener("click", () => {
        if (searchInput) searchInput.value = "";
        if (catSelect) catSelect.value = "all";
        currentSearch = "";
        currentCategory = "all";
        filterBenchmarks();
      });
    }

    // 2. Head-to-Head Model Comparison Logic
    const selectA = document.getElementById("compare-model-a") as HTMLSelectElement | null;
    const selectB = document.getElementById("compare-model-b") as HTMLSelectElement | null;
    const cmpSection = document.getElementById("model-comparison-section");

    let modelDatabase: Record<string, any> = {};
    if (cmpSection?.dataset.modelsDb) {
      try {
        modelDatabase = JSON.parse(cmpSection.dataset.modelsDb);
      } catch (e) {
        console.error("Failed to parse model comparison database:", e);
      }
    }

    function updateComparison() {
      const keyA = selectA?.value || "openai/o1";
      const keyB = selectB?.value || "deepseek/deepseek-r1";

      const dataA = modelDatabase[keyA] || modelDatabase["openai/o1"];
      const dataB = modelDatabase[keyB] || modelDatabase["deepseek/deepseek-r1"];

      const colA = document.getElementById("col-name-a");
      const colB = document.getElementById("col-name-b");
      if (colA) colA.textContent = dataA.name;
      if (colB) colB.textContent = dataB.name;

      const setEl = (id: string, val: string) => {
        const el = document.getElementById(id);
        if (el) el.textContent = val;
      };

      setEl("cmp-reasoning-a", dataA.reasoning);
      setEl("cmp-reasoning-b", dataB.reasoning);
      setEl("cmp-coding-a", dataA.coding);
      setEl("cmp-coding-b", dataB.coding);
      setEl("cmp-context-a", dataA.context);
      setEl("cmp-context-b", dataB.context);
      setEl("cmp-price-in-a", dataA.priceIn);
      setEl("cmp-price-in-b", dataB.priceIn);
      setEl("cmp-price-out-a", dataA.priceOut);
      setEl("cmp-price-out-b", dataB.priceOut);
      setEl("cmp-license-a", dataA.license);
      setEl("cmp-license-b", dataB.license);
    }

    if (selectA) selectA.addEventListener("change", updateComparison);
    if (selectB) selectB.addEventListener("change", updateComparison);
  })();
</script>
