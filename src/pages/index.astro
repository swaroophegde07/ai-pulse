---
// src/pages/index.astro — Homepage / Intelligence Dashboard with Today's AI Brief

import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import NewsCard from "../components/NewsCard.astro";
import Footer from "../components/Footer.astro";
import sourcesData from "../data/sources.json";
import feedData from "../data/feed.json";
import modelsData from "../data/models.json";
import benchmarksData from "../data/benchmarks.json";

interface FeedRecord {
  id: string;
  title: string;
  company: string;
  source: string;
  summary: string;
  url: string;
  date: string | null;
  category: string;
  fetched_at: string;
  _demo?: boolean;
  topics?: string[];
  tags?: string[];
  key_points?: string[];
  impact_score?: number | null;
  sources?: { title?: string; url: string; publisher?: string }[];
  priority_score?: number;
  priority_label?: string;
  priority_explanation?: string;
  why_it_matters?: string;
  source_type?: string;
  summary_status?: string;
}

const feed = feedData as FeedRecord[];
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const modelsCount = Array.isArray(modelsData) ? modelsData.length : 91;
const featuredModelsCount = Array.isArray(modelsData) ? modelsData.filter((m: any) => m.is_featured_frontier).length : 23;
const benchmarksCount = Array.isArray((benchmarksData as any)?.benchmarks) ? (benchmarksData as any).benchmarks.length : 552;

// Only genuine, non-demonstration articles in production views
const realArticles = feed.filter((a) => !a._demo);

// Distinct publishers represented in the real article dataset
const distinctPublishers = new Set(
  realArticles.map((a) => a.company).filter(Boolean)
);
const publisherCount = distinctPublishers.size;

// Sort articles by publication date descending (dated first, newest first)
const sortedArticles = [...realArticles].sort((a, b) => {
  const da = a.date ? new Date(a.date).getTime() : 0;
  const db = b.date ? new Date(b.date).getTime() : 0;
  if (da !== db) return db - da;
  const fa = a.fetched_at ? new Date(a.fetched_at).getTime() : 0;
  const fb = b.fetched_at ? new Date(b.fetched_at).getTime() : 0;
  return fb - fa;
});

// Importance ranking preferring impact_score (1-10) with fallback to priority_label
function getImportanceScore(a: FeedRecord): number {
  if (typeof a.impact_score === "number" && a.impact_score >= 1 && a.impact_score <= 10) {
    return a.impact_score;
  }
  const prio = (a.priority_label || "").toLowerCase();
  if (prio === "deep dive") return 8;
  if (prio === "must know") return 6;
  if (typeof a.priority_score === "number" && a.priority_score > 0) {
    return Math.min(10, Math.max(1, a.priority_score * 1.5));
  }
  return 3;
}

const isGenericWhy = (text?: string) =>
  !text ||
  text.includes("Provides verified empirical") ||
  text.includes("Highlights important industry") ||
  text.includes("Expands foundation model") ||
  text.includes("Introduces algorithmic methodologies");

// Semantics for Today's AI Brief:
// An article is eligible only when its publication timestamp is valid,
// is not later than the current time, and falls within the relevant time window.
const nowMs = Date.now();
const THIRTY_HOURS_MS = 30 * 60 * 60 * 1000;
const SEVEN_DAYS_MS = 7 * 24 * 60 * 60 * 1000;

function isEligibleInWindow(dateStr: string | null | undefined, windowMs: number, now: number): boolean {
  if (!dateStr || typeof dateStr !== "string") return false;
  const pubMs = new Date(dateStr).getTime();
  if (isNaN(pubMs)) return false;
  // Exclude future-dated articles: publication timestamp must not be later than current time
  if (pubMs > now) return false;
  // Must fall within the relevant time window
  return (now - pubMs) <= windowMs;
}

const articlesFromToday = sortedArticles.filter((a) =>
  isEligibleInWindow(a.date, THIRTY_HOURS_MS, nowMs)
);

// Fallback pool strictly limited to past 7 days (never the full historical archive, no future-dated)
const articlesFromPast7Days = sortedArticles.filter((a) =>
  isEligibleInWindow(a.date, SEVEN_DAYS_MS, nowMs)
);

type BriefMode = "today" | "recent" | "empty";
let briefMode: BriefMode = "today";
let briefCandidatePool: FeedRecord[] = [];

if (articlesFromToday.length >= 3) {
  briefMode = "today";
  briefCandidatePool = articlesFromToday;
} else if (articlesFromPast7Days.length > 0) {
  briefMode = "recent";
  briefCandidatePool = articlesFromPast7Days;
} else {
  briefMode = "empty";
  briefCandidatePool = [];
}

// Prioritize high-signal stories with publisher diversity (max 2 per publisher in the brief)
const sortedBriefCandidates = [...briefCandidatePool].sort((a, b) => {
  const sa = getImportanceScore(a);
  const sb = getImportanceScore(b);
  if (sb !== sa) return sb - sa;
  const da = a.date ? new Date(a.date).getTime() : 0;
  const db = b.date ? new Date(b.date).getTime() : 0;
  return db - da;
});

const todaysBrief: FeedRecord[] = [];
const briefPublishersCount: Record<string, number> = {};

for (const candidate of sortedBriefCandidates) {
  const pub = candidate.company || "Unknown";
  const count = briefPublishersCount[pub] || 0;
  if (count < 2) {
    todaysBrief.push(candidate);
    briefPublishersCount[pub] = count + 1;
  }
  if (todaysBrief.length >= 4) break;
}

// Dedicated Priority Stories (high-signal developments across coverage)
const briefIds = new Set(todaysBrief.map((a) => a.id));
const priorityStories = sortedArticles
  .filter((a) => !briefIds.has(a.id) && getImportanceScore(a) >= 6)
  .sort((a, b) => {
    const sa = getImportanceScore(a);
    const sb = getImportanceScore(b);
    if (sb !== sa) return sb - sa;
    const da = a.date ? new Date(a.date).getTime() : 0;
    const db = b.date ? new Date(b.date).getTime() : 0;
    return db - da;
  })
  .slice(0, 4);

// Latest coverage strictly chronological
const displayedIds = new Set([...briefIds, ...priorityStories.map((a) => a.id)]);
const latestArticles = sortedArticles.filter((a) => !displayedIds.has(a.id)).slice(0, 6);

// Last successful data refresh from trustworthy ingestion metadata
const lastUpdated = realArticles
  .map((a) => a.fetched_at)
  .sort()
  .reverse()[0];

function formatLastUpdated(iso: string | undefined): string {
  if (!iso) return "Awaiting first ingestion";
  try {
    return new Date(iso).toLocaleDateString("en-US", {
      month: "short",
      day: "numeric",
      hour: "2-digit",
      minute: "2-digit",
      timeZoneName: "short",
    });
  } catch {
    return iso;
  }
}
