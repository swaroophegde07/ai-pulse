---
// src/pages/index.astro — Homepage / Overview

import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import NewsCard from "../components/NewsCard.astro";
import Footer from "../components/Footer.astro";
import sourcesData from "../data/sources.json";
import feedData from "../data/feed.json";

// Type the feed records.
interface FeedRecord {
  id: string;
  title: string;
  company: string;
  source: string;
  summary: string;
  url: string;
  date: string | null;
  category: string;
  fetched_at: string;
  _demo?: boolean;
}

const feed = feedData as FeedRecord[];
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

// Only genuine, non-demonstration articles in production views
const realArticles = feed.filter((a) => !a._demo);

// Distinct publishers represented in the real article dataset
const distinctPublishers = new Set(
  realArticles.map((a) => a.company).filter(Boolean)
);
const publisherCount = distinctPublishers.size;

// Sort articles by publication date descending (dated first, newest first)
const sortedArticles = [...realArticles].sort((a, b) => {
  const da = a.date ? new Date(a.date).getTime() : 0;
  const db = b.date ? new Date(b.date).getTime() : 0;
  if (da !== db) return db - da;
  const fa = a.fetched_at ? new Date(a.fetched_at).getTime() : 0;
  const fb = b.fetched_at ? new Date(b.fetched_at).getTime() : 0;
  return fb - fa;
});

// Latest 6 articles for the homepage hero section
const latestArticles = sortedArticles.slice(0, 6);

// Last successful data refresh from trustworthy ingestion metadata
const lastUpdated = realArticles
  .map((a) => a.fetched_at)
  .sort()
  .reverse()[0];

function formatLastUpdated(iso: string | undefined): string {
  if (!iso) return "Awaiting first ingestion";
  try {
    return new Date(iso).toLocaleDateString("en-US", {
      month: "short",
      day: "numeric",
      hour: "2-digit",
      minute: "2-digit",
      timeZoneName: "short",
    });
  } catch {
    return iso;
  }
}
---

<Layout title="AI Pulse — Intelligence Dashboard">
  <Header currentPath="/" />

  <main id="main-content">
    <!-- Hero / Intro Section -->
    <section class="border-b border-neutral-800/60 bg-neutral-950">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
        <div class="max-w-3xl">
          <h1 class="text-2xl sm:text-3xl font-bold text-neutral-100 tracking-tight mb-3">
            AI Intelligence Dashboard
          </h1>
          <p class="text-sm text-neutral-400 leading-relaxed mb-6 max-w-xl">
            Aggregated news, research, and developments from across the AI
            industry. Updated twice daily from verified public sources.
            Summaries generated by Gemini.
          </p>

          <!-- Stats bar: single source of truth -->
          <div class="flex flex-wrap gap-6">
            {
              [
                { label: "Articles", value: String(realArticles.length) },
                { label: "Publishers", value: String(publisherCount) },
                {
                  label: "Configured Feeds",
                  value: String(sourcesData.length),
                },
                {
                  label: "Last updated",
                  value: formatLastUpdated(lastUpdated),
                },
              ].map(({ label, value }) => (
                <div class="flex flex-col gap-1">
                  <span class="font-mono text-[10px] text-neutral-600 tracking-widest uppercase">
                    {label}
                  </span>
                  <span class="font-mono text-sm text-neutral-300">{value}</span>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <!-- Latest Articles Section -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
      <div class="flex items-center justify-between mb-6">
        <h2 class="text-xs font-mono text-neutral-500 tracking-widest uppercase">
          Latest
        </h2>
        <a
          href={`${base}/news/`}
          class="font-mono text-[10px] text-neutral-500 hover:text-emerald-400 tracking-wide transition-colors"
        >
          View all →
        </a>
      </div>

      {
        latestArticles.length === 0 ? (
          <div class="border border-neutral-800 rounded-lg p-12 text-center bg-neutral-900/30">
            <p class="font-mono text-xs text-neutral-400 mb-2 font-medium">
              No genuine news articles ingested yet.
            </p>
            <p class="font-mono text-[11px] text-neutral-600 max-w-md mx-auto leading-relaxed">
              The automated ingestion pipeline runs twice daily across {sourcesData.length} public feeds,
              or can be triggered on demand via GitHub Actions.
            </p>
          </div>
        ) : (
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
            {latestArticles.map((article) => (
              <NewsCard
                id={article.id}
                title={article.title}
                company={article.company}
                source={article.source}
                summary={article.summary}
                url={article.url}
                date={article.date}
                category={article.category}
                fetched_at={article.fetched_at}
                isDemo={false}
              />
            ))}
          </div>
        )
      }
    </section>

    <!-- Intelligence Hub Sections -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-12">
      <h2 class="text-xs font-mono text-neutral-500 tracking-widest uppercase mb-4">
        Intelligence Hubs
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {
          [
            {
              title: "Model Tracker",
              tag: "Live Tracker",
              description:
                "Frontier architectures, open-weight checkpoints, parameter specifications, and release tracking across major labs.",
              href: `${base}/models/`,
            },
            {
              title: "Research Feed",
              tag: "Publications",
              description:
                "Peer perspectives, algorithmic breakthroughs, and preprint intelligence from Google DeepMind, FAIR, and AI labs.",
              href: `${base}/research/`,
            },
            {
              title: "Benchmark Board",
              tag: "Evaluations",
              description:
                "Standardized capability benchmarks including SWE-bench, MMLU-Pro, HumanEval, and human preference arenas.",
              href: `${base}/benchmarks/`,
            },
          ].map(({ title, tag, description, href }) => (
            <a
              href={href}
              class="border border-neutral-800 bg-neutral-900/40 rounded-lg p-6 flex flex-col justify-between hover:border-neutral-700 transition-colors group"
            >
              <div>
                <div class="flex items-center justify-between mb-2">
                  <span class="font-mono text-[10px] text-emerald-400 tracking-widest uppercase">
                    {tag}
                  </span>
                  <span class="font-mono text-xs text-neutral-500 group-hover:text-emerald-400 transition-colors">
                    →
                  </span>
                </div>
                <h3 class="text-sm font-semibold text-neutral-200 group-hover:text-neutral-100 transition-colors mb-2">
                  {title}
                </h3>
                <p class="text-xs text-neutral-400 leading-relaxed font-mono">
                  {description}
                </p>
              </div>
            </a>
          ))
        }
      </div>
    </section>
  </main>

  <Footer />
</Layout>
