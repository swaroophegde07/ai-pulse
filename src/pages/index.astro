---
// src/pages/index.astro — Homepage / Intelligence Dashboard with Today's AI Brief

import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import NewsCard from "../components/NewsCard.astro";
import Footer from "../components/Footer.astro";
import sourcesData from "../data/sources.json";
import feedData from "../data/feed.json";
import modelsData from "../data/models.json";
import benchmarksData from "../data/benchmarks.json";

interface FeedRecord {
  id: string;
  title: string;
  company: string;
  source: string;
  summary: string;
  url: string;
  date: string | null;
  category: string;
  fetched_at: string;
  _demo?: boolean;
  topics?: string[];
  tags?: string[];
  key_points?: string[];
  impact_score?: number | null;
  sources?: { title?: string; url: string; publisher?: string }[];
  priority_score?: number;
  priority_label?: string;
  priority_explanation?: string;
  why_it_matters?: string;
  source_type?: string;
  summary_status?: string;
}

const feed = feedData as FeedRecord[];
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const modelsCount = Array.isArray(modelsData) ? modelsData.length : 91;
const featuredModelsCount = Array.isArray(modelsData) ? modelsData.filter((m: any) => m.is_featured_frontier).length : 23;
const benchmarksCount = Array.isArray((benchmarksData as any)?.benchmarks) ? (benchmarksData as any).benchmarks.length : 552;

// Only genuine, non-demonstration articles in production views
const realArticles = feed.filter((a) => !a._demo);

// Distinct publishers represented in the real article dataset
const distinctPublishers = new Set(
  realArticles.map((a) => a.company).filter(Boolean)
);
const publisherCount = distinctPublishers.size;

// Sort articles by publication date descending (dated first, newest first)
const sortedArticles = [...realArticles].sort((a, b) => {
  const da = a.date ? new Date(a.date).getTime() : 0;
  const db = b.date ? new Date(b.date).getTime() : 0;
  if (da !== db) return db - da;
  const fa = a.fetched_at ? new Date(a.fetched_at).getTime() : 0;
  const fb = b.fetched_at ? new Date(b.fetched_at).getTime() : 0;
  return fb - fa;
});

// Importance ranking preferring impact_score (1-10) with fallback to priority_label
function getImportanceScore(a: FeedRecord): number {
  if (typeof a.impact_score === "number" && a.impact_score >= 1 && a.impact_score <= 10) {
    return a.impact_score;
  }
  const prio = (a.priority_label || "").toLowerCase();
  if (prio === "deep dive") return 8;
  if (prio === "must know") return 6;
  if (typeof a.priority_score === "number" && a.priority_score > 0) {
    return Math.min(10, Math.max(1, a.priority_score * 1.5));
  }
  return 3;
}

const isGenericWhy = (text?: string) =>
  !text ||
  text.includes("Provides verified empirical") ||
  text.includes("Highlights important industry") ||
  text.includes("Expands foundation model") ||
  text.includes("Introduces algorithmic methodologies");

// Semantics for Today's AI Brief:
// An article is eligible only when its publication timestamp is valid,
// is not later than the current time, and falls within the relevant time window.
const nowMs = Date.now();
const THIRTY_HOURS_MS = 30 * 60 * 60 * 1000;
const SEVEN_DAYS_MS = 7 * 24 * 60 * 60 * 1000;

function isEligibleInWindow(dateStr: string | null | undefined, windowMs: number, now: number): boolean {
  if (!dateStr || typeof dateStr !== "string") return false;
  const pubMs = new Date(dateStr).getTime();
  if (isNaN(pubMs)) return false;
  // Exclude future-dated articles: publication timestamp must not be later than current time
  if (pubMs > now) return false;
  // Must fall within the relevant time window
  return (now - pubMs) <= windowMs;
}

const articlesFromToday = sortedArticles.filter((a) =>
  isEligibleInWindow(a.date, THIRTY_HOURS_MS, nowMs)
);

// Fallback pool strictly limited to past 7 days (never the full historical archive, no future-dated)
const articlesFromPast7Days = sortedArticles.filter((a) =>
  isEligibleInWindow(a.date, SEVEN_DAYS_MS, nowMs)
);

type BriefMode = "today" | "recent" | "empty";
let briefMode: BriefMode = "today";
let briefCandidatePool: FeedRecord[] = [];

if (articlesFromToday.length >= 3) {
  briefMode = "today";
  briefCandidatePool = articlesFromToday;
} else if (articlesFromPast7Days.length > 0) {
  briefMode = "recent";
  briefCandidatePool = articlesFromPast7Days;
} else {
  briefMode = "empty";
  briefCandidatePool = [];
}

// Prioritize high-signal stories with publisher diversity (max 2 per publisher in the brief)
const sortedBriefCandidates = [...briefCandidatePool].sort((a, b) => {
  const sa = getImportanceScore(a);
  const sb = getImportanceScore(b);
  if (sb !== sa) return sb - sa;
  const da = a.date ? new Date(a.date).getTime() : 0;
  const db = b.date ? new Date(b.date).getTime() : 0;
  return db - da;
});

const todaysBrief: FeedRecord[] = [];
const briefPublishersCount: Record<string, number> = {};

for (const candidate of sortedBriefCandidates) {
  const pub = candidate.company || "Unknown";
  const count = briefPublishersCount[pub] || 0;
  if (count < 2) {
    todaysBrief.push(candidate);
    briefPublishersCount[pub] = count + 1;
  }
  if (todaysBrief.length >= 4) break;
}

// Dedicated Priority Stories (high-signal developments across coverage)
const briefIds = new Set(todaysBrief.map((a) => a.id));
const priorityStories = sortedArticles
  .filter((a) => !briefIds.has(a.id) && getImportanceScore(a) >= 6)
  .sort((a, b) => {
    const sa = getImportanceScore(a);
    const sb = getImportanceScore(b);
    if (sb !== sa) return sb - sa;
    const da = a.date ? new Date(a.date).getTime() : 0;
    const db = b.date ? new Date(b.date).getTime() : 0;
    return db - da;
  })
  .slice(0, 4);

// Latest coverage strictly chronological
const displayedIds = new Set([...briefIds, ...priorityStories.map((a) => a.id)]);
const latestArticles = sortedArticles.filter((a) => !displayedIds.has(a.id)).slice(0, 6);

// Last successful data refresh from trustworthy ingestion metadata
const lastUpdated = realArticles
  .map((a) => a.fetched_at)
  .sort()
  .reverse()[0];

function formatLastUpdated(iso: string | undefined): string {
  if (!iso) return "Awaiting first ingestion";
  try {
    return new Date(iso).toLocaleDateString("en-US", {
      month: "short",
      day: "numeric",
      hour: "2-digit",
      minute: "2-digit",
      timeZoneName: "short",
    });
  } catch {
    return iso;
  }
}
---

<Layout title="AI Pulse — Intelligence Dashboard">
  <Header currentPath="/" />

  <main id="main-content">
    <!-- Hero / Intro Section -->
    <section class="border-b border-theme-border bg-theme-page">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-14 animate-reveal">
        <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6 mb-8">
          <div class="max-w-2xl">
            <div class="inline-flex items-center gap-2 font-mono text-[10px] tracking-widest uppercase px-2.5 py-1 rounded border border-emerald-500/30 bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 mb-3">
              <span class="inline-block w-1.5 h-1.5 rounded-full bg-emerald-500 dark:bg-emerald-400"></span>
              <span>Frontier Intelligence Stream</span>
            </div>
            <h1 class="text-2xl sm:text-3xl font-bold text-theme-primary tracking-tight mb-2">
              AI Intelligence Dashboard
            </h1>
            <p class="text-sm text-theme-secondary leading-relaxed">
              Objective news aggregation, verified model capabilities, empirical benchmarks, and research tracking. Filtered for high-signal developments with traceable provenance.
            </p>
          </div>

          <!-- Fast section jump navigation -->
          <nav aria-label="Page sections" class="flex items-center gap-2 flex-wrap font-mono text-[10px]">
            <span class="text-theme-muted uppercase tracking-wider">Jump to:</span>
            <a href="#todays-brief" class="px-2.5 py-1 rounded border border-theme-border bg-theme-surface text-theme-secondary hover:text-emerald-600 dark:hover:text-emerald-400 hover:border-theme-border-accent transition-colors">Today's Brief</a>
            <a href="#priority-intelligence" class="px-2.5 py-1 rounded border border-theme-border bg-theme-surface text-theme-secondary hover:text-emerald-600 dark:hover:text-emerald-400 hover:border-theme-border-accent transition-colors">Priority Intel</a>
            <a href="#latest-coverage" class="px-2.5 py-1 rounded border border-theme-border bg-theme-surface text-theme-secondary hover:text-emerald-600 dark:hover:text-emerald-400 hover:border-theme-border-accent transition-colors">Latest News</a>
            <a href="#intelligence-hubs" class="px-2.5 py-1 rounded border border-theme-border bg-theme-surface text-theme-secondary hover:text-emerald-600 dark:hover:text-emerald-400 hover:border-theme-border-accent transition-colors">Hubs</a>
            <span class="text-theme-muted hidden sm:inline">&middot;</span>
            <a href={`${base}/feedback/`} class="px-2.5 py-1 rounded border border-theme-border bg-theme-surface text-theme-muted hover:text-emerald-600 dark:hover:text-emerald-400 hover:border-theme-border-accent transition-colors" title="Send feedback or report an issue">Send Feedback</a>
          </nav>
        </div>

        <!-- Formatted stats cards: single source of truth -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
          {
            [
              { label: "Articles Ingested", value: String(realArticles.length) },
              { label: "Distinct Publishers", value: String(publisherCount) },
              {
                label: "Monitored Feeds",
                value: String(sourcesData.length),
              },
              {
                label: "Last Ingestion",
                value: formatLastUpdated(lastUpdated),
              },
            ].map(({ label, value }) => (
              <div class="bg-theme-surface border border-theme-border rounded-lg p-3.5 flex flex-col justify-between">
                <span class="font-mono text-[10px] text-theme-muted tracking-wider uppercase">
                  {label}
                </span>
                <span
                  class="font-mono text-sm font-semibold text-theme-primary mt-1 truncate"
                  title={value}
                  data-count-target={/^\d+$/.test(value) ? value : undefined}
                >
                  {value}
                </span>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Today's AI Brief Section -->
    <section id="todays-brief" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 border-b border-theme-border">
      <div class="flex items-center justify-between mb-6">
        <div class="flex items-center gap-2 flex-wrap">
          <span class="inline-block w-2 h-2 rounded-full bg-emerald-500 dark:bg-emerald-400"></span>
          <h2 class="text-xs font-mono text-theme-primary font-semibold tracking-widest uppercase">
            Today's AI Brief
          </h2>
          {
            briefMode === "today" ? (
              <span class="font-mono text-[9px] text-emerald-600 dark:text-emerald-400 bg-emerald-500/10 border border-emerald-500/20 px-2 py-0.5 rounded tracking-wide">
                Live Daily Coverage
              </span>
            ) : briefMode === "recent" ? (
              <span class="font-mono text-[9px] text-amber-500 dark:text-amber-400 bg-amber-500/10 border border-amber-500/20 px-2 py-0.5 rounded tracking-wide">
                Past 7 Days Highlights (limited coverage today)
              </span>
            ) : (
              <span class="font-mono text-[9px] text-theme-muted bg-theme-elevated border border-theme-border px-2 py-0.5 rounded tracking-wide">
                No recent stories (past 7 days)
              </span>
            )
          }
        </div>
        <a
          href={`${base}/news/?sort=important`}
          class="font-mono text-[10px] text-theme-muted hover:text-emerald-600 dark:hover:text-emerald-400 tracking-wide transition-colors"
        >
          Priority stream →
        </a>
      </div>

      {
        todaysBrief.length === 0 ? (
          <div class="border border-theme-border rounded-lg p-8 text-center bg-theme-surface">
            <p class="font-mono text-xs text-theme-muted mb-1">No recent articles published in the past 7 days.</p>
            <p class="font-mono text-[11px] text-theme-dim">The automated ingestion runs twice daily across monitored feeds. Explore latest stories below.</p>
          </div>
        ) : (
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            {todaysBrief.map((article) => (
              <div class="bg-theme-surface border border-theme-border rounded-lg p-5 flex flex-col justify-between hover:border-theme-border-accent hover:bg-theme-hover transition-colors">
                <div>
                  <div class="flex items-center justify-between gap-2 mb-2 flex-wrap">
                    <div class="flex items-center gap-1.5">
                      <span class="font-mono text-[9px] text-amber-500 dark:text-amber-300 bg-amber-500/10 border border-amber-500/30 uppercase tracking-wider px-1.5 py-0.5 rounded">
                        {article.priority_label || "Must Know"}
                      </span>
                      <span class="font-mono text-[10px] text-theme-muted">
                        {article.company}
                      </span>
                    </div>
                    <time class="font-mono text-[10px] text-theme-dim">
                      {article.date ? new Date(article.date).toLocaleDateString("en-US", { month: "short", day: "numeric" }) : ""}
                    </time>
                  </div>
                  <h3 class="text-sm font-semibold text-theme-primary mb-2 leading-snug">
                    <a href={article.url} target="_blank" rel="noopener noreferrer" class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">
                      {article.title}
                    </a>
                  </h3>
                  <p class="text-xs text-theme-secondary leading-relaxed mb-3">
                    {article.summary}
                  </p>
                  {article.why_it_matters && !isGenericWhy(article.why_it_matters) && (
                    <div class="bg-theme-elevated border border-theme-border rounded px-2.5 py-1.5 text-[11px] text-theme-secondary font-mono leading-relaxed mb-3">
                      <span class="text-emerald-600 dark:text-emerald-400 font-medium mr-1.5 uppercase tracking-wider text-[9px]">Why it matters:</span>
                      {article.why_it_matters}
                    </div>
                  )}
                </div>
                <div class="pt-2 border-t border-theme-border-subtle flex items-center justify-between">
                  <span class="font-mono text-[10px] text-theme-dim">
                    {article.source}
                  </span>
                  <a
                    href={article.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="font-mono text-[10px] text-theme-muted hover:text-emerald-600 dark:hover:text-emerald-400 inline-flex items-center gap-1"
                  >
                    <span>Read source</span>
                    <span>↗</span>
                  </a>
                </div>
              </div>
            ))}
          </div>
        )
      }
    </section>

    <!-- Priority Intelligence Section -->
    {
      priorityStories.length > 0 && (
        <section id="priority-intelligence" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 border-b border-theme-border">
          <div class="flex items-center justify-between mb-6">
            <div>
              <h2 class="text-xs font-mono text-theme-primary font-semibold tracking-widest uppercase mb-1">
                Priority Intelligence
              </h2>
              <p class="text-[11px] font-mono text-theme-muted">
                High-signal architecture drops, benchmark results, and foundation model milestones.
              </p>
            </div>
            <a
              href={`${base}/news/?sort=important`}
              class="font-mono text-[10px] text-theme-muted hover:text-emerald-600 dark:hover:text-emerald-400 tracking-wide transition-colors"
            >
              View all high-signal stories →
            </a>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
            {priorityStories.map((article) => (
              <div class="bg-theme-surface border border-theme-border rounded-lg p-4 flex flex-col justify-between hover:border-theme-border-accent hover:bg-theme-hover transition-colors">
                <div>
                  <div class="flex items-center justify-between gap-1 mb-2">
                    <span class="font-mono text-[9px] text-amber-500 dark:text-amber-300 bg-amber-500/10 border border-amber-500/30 uppercase tracking-wider px-1.5 py-0.5 rounded">
                      {article.priority_label || "Must Know"}
                    </span>
                    <time class="font-mono text-[9px] text-theme-dim">
                      {article.date ? new Date(article.date).toLocaleDateString("en-US", { month: "short", day: "numeric" }) : "Recent"}
                    </time>
                  </div>
                  <h3 class="text-xs font-semibold text-theme-primary mb-2 line-clamp-2 leading-snug">
                    <a href={article.url} target="_blank" rel="noopener noreferrer" class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">
                      {article.title}
                    </a>
                  </h3>
                  <p class="text-[11px] text-theme-secondary line-clamp-3 leading-relaxed mb-3">
                    {article.summary}
                  </p>
                </div>
                <div class="pt-2 border-t border-theme-border-subtle flex items-center justify-between font-mono text-[10px]">
                  <span class="text-theme-muted">{article.company}</span>
                  <a href={article.url} target="_blank" rel="noopener noreferrer" class="text-theme-muted hover:text-emerald-600 dark:hover:text-emerald-400">
                    Source ↗
                  </a>
                </div>
              </div>
            ))}
          </div>
        </section>
      )
    }

    <!-- Latest Articles Section -->
    <section id="latest-coverage" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
      <div class="flex items-center justify-between mb-6">
        <h2 class="text-xs font-mono text-theme-muted tracking-widest uppercase">
          Latest Coverage
        </h2>
        <a
          href={`${base}/news/`}
          class="font-mono text-[10px] text-theme-muted hover:text-emerald-600 dark:hover:text-emerald-400 tracking-wide transition-colors"
        >
          View all {realArticles.length} articles →
        </a>
      </div>

      {
        latestArticles.length === 0 ? (
          <div class="border border-theme-border rounded-lg p-12 text-center bg-theme-surface">
            <p class="font-mono text-xs text-theme-secondary mb-2 font-medium">
              No genuine news articles ingested yet.
            </p>
            <p class="font-mono text-[11px] text-theme-muted max-w-md mx-auto leading-relaxed">
              The automated ingestion pipeline runs twice daily across {sourcesData.length} public feeds.
            </p>
          </div>
        ) : (
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
            {latestArticles.map((article) => (
              <NewsCard
                id={article.id}
                title={article.title}
                company={article.company}
                source={article.source}
                summary={article.summary}
                url={article.url}
                date={article.date}
                category={article.category}
                fetched_at={article.fetched_at}
                isDemo={false}
                topics={article.topics || []}
                tags={article.tags || []}
                key_points={article.key_points || []}
                impact_score={article.impact_score}
                sources={article.sources || []}
                priority_label={article.priority_label}
                priority_explanation={article.priority_explanation}
                why_it_matters={article.why_it_matters}
                source_type={article.source_type}
                summary_status={article.summary_status}
              />
            ))}
          </div>
        )
      }
    </section>

    <!-- Intelligence Hub Sections -->
    <section id="intelligence-hubs" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-12">
      <h2 class="text-xs font-mono text-theme-muted tracking-widest uppercase mb-4">
        Intelligence Hubs
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {
          [
            {
              title: "Model Tracker",
              tag: `${modelsCount} Models (${featuredModelsCount} Featured)`,
              description:
                "Frontier architectures, context lengths, token pricing, modalities, and open-weights licensing across major providers.",
              href: `${base}/models/`,
            },
            {
              title: "Research Feed",
              tag: "Original Papers & Reports",
              description:
                "Algorithmic breakthroughs, preprints, and publications from Google DeepMind, OpenAI, Meta FAIR, and Microsoft Research.",
              href: `${base}/research/`,
            },
            {
              title: "Benchmark Board",
              tag: `${benchmarksCount} Verified Evaluations`,
              description:
                "LiveBench evaluations, OpenRouter real-time pricing telemetry, and interactive head-to-head model comparisons.",
              href: `${base}/benchmarks/`,
            },
          ].map(({ title, tag, description, href }) => (
            <a
              href={href}
              class="border border-theme-border bg-theme-surface rounded-lg p-6 flex flex-col justify-between hover:border-theme-border-accent hover:bg-theme-hover transition-colors group"
            >
              <div>
                <div class="flex items-center justify-between mb-2">
                  <span class="font-mono text-[10px] text-emerald-600 dark:text-emerald-400 tracking-widest uppercase">
                    {tag}
                  </span>
                  <span class="font-mono text-xs text-theme-muted group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors">
                    →
                  </span>
                </div>
                <h3 class="text-sm font-semibold text-theme-primary group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors mb-2">
                  {title}
                </h3>
                <p class="text-xs text-theme-secondary leading-relaxed font-mono">
                  {description}
                </p>
              </div>
            </a>
          ))
        }
      </div>

      <div class="mt-6 pt-4 border-t border-theme-border-subtle flex flex-wrap items-center justify-between gap-3 text-xs font-mono text-theme-muted">
        <span>Help refine our coverage, models catalogue, and benchmark accuracy.</span>
        <a
          href={`${base}/feedback/`}
          class="text-theme-secondary hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors inline-flex items-center gap-1.5"
        >
          <span>Report an issue or suggest a feature</span>
          <span>→</span>
        </a>
      </div>
    </section>
  </main>

  <Footer />

  <script>
    (function () {
      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
      const countElements = document.querySelectorAll<HTMLElement>("[data-count-target]");
      countElements.forEach((el) => {
        const target = parseInt(el.dataset.countTarget || "0", 10);
        if (isNaN(target) || target <= 0) return;
        const duration = 450;
        const startTime = performance.now();
        function tick(now: number) {
          const elapsed = now - startTime;
          const progress = Math.min(elapsed / duration, 1);
          const ease = 1 - Math.pow(1 - progress, 3);
          el.textContent = String(Math.round(ease * target));
          if (progress < 1) requestAnimationFrame(tick);
          else el.textContent = String(target);
        }
        requestAnimationFrame(tick);
      });
    })();
  </script>
</Layout>
