---
// src/pages/index.astro — Homepage / Overview

import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import NewsCard from "../components/NewsCard.astro";
import Footer from "../components/Footer.astro";
import feedData from "../data/feed.json";

// Type the feed records.
interface FeedRecord {
  id: string;
  title: string;
  company: string;
  source: string;
  summary: string;
  url: string;
  date: string | null;
  category: string;
  fetched_at: string;
  _demo?: boolean;
}

const feed = feedData as FeedRecord[];
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

// Latest 6 articles for the homepage hero section.
const latestArticles = feed.slice(0, 6);

// Stats for the intro bar.
const totalArticles = feed.length;
const sourceCount = [...new Set(feed.map((a) => a.source))].length;
const lastUpdated = feed
  .map((a) => a.fetched_at)
  .sort()
  .reverse()[0];

function formatLastUpdated(iso: string | undefined): string {
  if (!iso) return "Never";
  try {
    return new Date(iso).toLocaleDateString("en-US", {
      month: "short",
      day: "numeric",
      hour: "2-digit",
      minute: "2-digit",
      timeZoneName: "short",
    });
  } catch {
    return iso;
  }
}
---

<Layout title="AI Pulse — Intelligence Dashboard">
  <Header currentPath="/" />

  <main id="main-content">
    <!-- Hero / Intro Section -->
    <section class="border-b border-neutral-800/60 bg-neutral-950">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
        <div class="max-w-3xl">
          <h1 class="text-2xl sm:text-3xl font-bold text-neutral-100 tracking-tight mb-3">
            AI Intelligence Dashboard
          </h1>
          <p class="text-sm text-neutral-400 leading-relaxed mb-6 max-w-xl">
            Aggregated news, research, and developments from across the AI
            industry. Updated twice daily from verified public sources.
            Summaries generated by Gemini.
          </p>

          <!-- Stats bar -->
          <div class="flex flex-wrap gap-6">
            {
              [
                { label: "Articles", value: String(totalArticles) },
                { label: "Sources", value: String(sourceCount) },
                {
                  label: "Last updated",
                  value: formatLastUpdated(lastUpdated),
                },
              ].map(({ label, value }) => (
                <div class="flex flex-col gap-1">
                  <span class="font-mono text-[10px] text-neutral-600 tracking-widest uppercase">
                    {label}
                  </span>
                  <span class="font-mono text-sm text-neutral-300">{value}</span>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <!-- Latest Articles Section -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
      <div class="flex items-center justify-between mb-6">
        <h2 class="text-xs font-mono text-neutral-500 tracking-widest uppercase">
          Latest
        </h2>
        <a
          href={`${base}/news/`}
          class="font-mono text-[10px] text-neutral-500 hover:text-emerald-400 tracking-wide transition-colors"
        >
          View all →
        </a>
      </div>

      {
        latestArticles.length === 0 ? (
          <div class="border border-neutral-800 rounded-lg p-10 text-center">
            <p class="font-mono text-xs text-neutral-600">
              No articles yet. Run the pipeline to fetch news.
            </p>
          </div>
        ) : (
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
            {latestArticles.map((article) => (
              <NewsCard
                id={article.id}
                title={article.title}
                company={article.company}
                source={article.source}
                summary={article.summary}
                url={article.url}
                date={article.date}
                category={article.category}
                fetched_at={article.fetched_at}
                isDemo={article._demo === true}
              />
            ))}
          </div>
        )
      }
    </section>

    <!-- Coming-soon sections -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-10">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {
          [
            {
              title: "Model Tracker",
              description:
                "A structured index of AI model releases, capabilities, and benchmarks. Coming in a future release.",
              href: `${base}/models/`,
            },
            {
              title: "Research Feed",
              description:
                "Curated papers, preprints, and technical reports from leading AI research labs. Coming in a future release.",
              href: `${base}/research/`,
            },
            {
              title: "Benchmark Board",
              description:
                "Side-by-side benchmark comparisons across evals, tasks, and hardware. Coming in a future release.",
              href: `${base}/benchmarks/`,
            },
          ].map(({ title, description }) => (
            <div class="border border-neutral-800/50 border-dashed rounded-lg p-6 flex flex-col gap-3 opacity-50">
              <span class="font-mono text-[10px] text-neutral-600 tracking-widest uppercase">
                Coming soon
              </span>
              <h3 class="text-sm font-semibold text-neutral-500">{title}</h3>
              <p class="text-xs text-neutral-600 leading-relaxed">{description}</p>
            </div>
          ))
        }
      </div>
    </section>
  </main>

  <Footer />
</Layout>
