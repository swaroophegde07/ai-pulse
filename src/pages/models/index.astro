<script id="model-updates-data" type="application/json" set:html={JSON.stringify(modelUpdates)} />

<script>
  (function () {
    // -------------------------------------------------------------------------
    // 1. Model Updates Feed Filtering
    // -------------------------------------------------------------------------
    const updateSearchInput = document.getElementById("update-search-input") as HTMLInputElement | null;
    const clearUpdateSearchBtn = document.getElementById("clear-update-search") as HTMLButtonElement | null;
    const updateProviderBtns = document.querySelectorAll<HTMLButtonElement>(".update-provider-btn");
    const updateTypeBtns = document.querySelectorAll<HTMLButtonElement>(".update-type-btn");
    const updateTimeBtns = document.querySelectorAll<HTMLButtonElement>(".update-time-btn");
    const updateCards = document.querySelectorAll<HTMLElement>(".update-card");
    const updateCountLabel = document.getElementById("update-count-label");
    const updateEmptyState = document.getElementById("no-updates-matched");
    const resetUpdatesFilterBtn = document.getElementById("reset-updates-filter-btn") as HTMLButtonElement | null;

    let updateSearch = "";
    let updateProvider = "all";
    let updateType = "all";
    let updateTime = "all";

    function filterUpdates() {
      let visible = 0;
      const now = Date.now();
      const DAY_MS = 24 * 60 * 60 * 1000;

      updateCards.forEach((card) => {
        const title = card.dataset.title || "";
        const summary = card.dataset.summary || "";
        const provider = card.dataset.provider || "";
        const model = card.dataset.model || "";
        const family = card.dataset.family || "";
        const type = card.dataset.type || "";
        const publishedStr = card.dataset.published || "";

        // Text Search
        const matchesSearch =
          !updateSearch ||
          title.includes(updateSearch) ||
          summary.includes(updateSearch) ||
          provider.includes(updateSearch) ||
          model.includes(updateSearch) ||
          family.includes(updateSearch);

        // Provider Filter
        const matchesProvider = updateProvider === "all" || provider === updateProvider;

        // Type Filter
        const matchesType = updateType === "all" || type === updateType;

        // Time Period Filter
        let matchesTime = true;
        if (updateTime === "7d") {
          const pubTime = publishedStr ? new Date(publishedStr).getTime() : 0;
          matchesTime = !isNaN(pubTime) && pubTime > 0 && pubTime <= now && (now - pubTime) <= 7 * DAY_MS;
        } else if (updateTime === "30d") {
          const pubTime = publishedStr ? new Date(publishedStr).getTime() : 0;
          matchesTime = !isNaN(pubTime) && pubTime > 0 && pubTime <= now && (now - pubTime) <= 30 * DAY_MS;
        }

        const show = matchesSearch && matchesProvider && matchesType && matchesTime;
        card.style.display = show ? "" : "none";
        if (show) visible++;
      });

      if (updateCountLabel) {
        updateCountLabel.textContent = `Showing ${visible} of ${updateCards.length} updates`;
      }
      if (updateEmptyState) {
        updateEmptyState.style.display = visible === 0 ? "block" : "none";
      }
      if (clearUpdateSearchBtn) {
        clearUpdateSearchBtn.style.display = updateSearch ? "" : "none";
      }
    }

    if (updateSearchInput) {
      updateSearchInput.addEventListener("input", (e) => {
        updateSearch = (e.target as HTMLInputElement).value.toLowerCase().trim();
        filterUpdates();
      });

      updateSearchInput.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && updateSearchInput.value) {
          updateSearchInput.value = "";
          updateSearch = "";
          filterUpdates();
        }
      });
    }

    if (clearUpdateSearchBtn) {
      clearUpdateSearchBtn.addEventListener("click", () => {
        if (updateSearchInput) updateSearchInput.value = "";
        updateSearch = "";
        filterUpdates();
        updateSearchInput?.focus();
      });
    }

    updateProviderBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        updateProviderBtns.forEach((b) => {
          b.classList.remove("bg-theme-elevated", "text-theme-primary");
          b.classList.add("text-theme-secondary");
          b.setAttribute("aria-pressed", "false");
        });
        btn.classList.remove("text-theme-secondary");
        btn.classList.add("bg-theme-elevated", "text-theme-primary");
        btn.setAttribute("aria-pressed", "true");
        updateProvider = btn.dataset.provider || "all";
        filterUpdates();
      });
    });

    updateTypeBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        updateTypeBtns.forEach((b) => {
          b.classList.remove("bg-theme-elevated", "text-theme-primary");
          b.classList.add("text-theme-secondary");
          b.setAttribute("aria-pressed", "false");
        });
        btn.classList.remove("text-theme-secondary");
        btn.classList.add("bg-theme-elevated", "text-theme-primary");
        btn.setAttribute("aria-pressed", "true");
        updateType = btn.dataset.type || "all";
        filterUpdates();
      });
    });

    updateTimeBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        updateTimeBtns.forEach((b) => {
          b.classList.remove("bg-theme-elevated", "text-theme-primary");
          b.classList.add("text-theme-secondary");
          b.setAttribute("aria-pressed", "false");
        });
        btn.classList.remove("text-theme-secondary");
        btn.classList.add("bg-theme-elevated", "text-theme-primary");
        btn.setAttribute("aria-pressed", "true");
        updateTime = btn.dataset.time || "all";
        filterUpdates();
      });
    });

    if (resetUpdatesFilterBtn) {
      resetUpdatesFilterBtn.addEventListener("click", () => {
        if (updateSearchInput) updateSearchInput.value = "";
        updateSearch = "";
        updateProvider = "all";
        updateType = "all";
        updateTime = "all";

        updateProviderBtns.forEach((b) => {
          const isAll = (b.dataset.provider || "all") === "all";
          b.setAttribute("aria-pressed", isAll ? "true" : "false");
          b.classList.toggle("bg-theme-elevated", isAll);
          b.classList.toggle("text-theme-primary", isAll);
          b.classList.toggle("text-theme-secondary", !isAll);
        });

        updateTypeBtns.forEach((b) => {
          const isAll = (b.dataset.type || "all") === "all";
          b.setAttribute("aria-pressed", isAll ? "true" : "false");
          b.classList.toggle("bg-theme-elevated", isAll);
          b.classList.toggle("text-theme-primary", isAll);
          b.classList.toggle("text-theme-secondary", !isAll);
        });

        updateTimeBtns.forEach((b) => {
          const isAll = (b.dataset.time || "all") === "all";
          b.setAttribute("aria-pressed", isAll ? "true" : "false");
          b.classList.toggle("bg-theme-elevated", isAll);
          b.classList.toggle("text-theme-primary", isAll);
          b.classList.toggle("text-theme-secondary", !isAll);
        });

        filterUpdates();
      });
    }

    // -------------------------------------------------------------------------
    // 2. Model-Specific Changelog Modal
    // -------------------------------------------------------------------------
    const modal = document.getElementById("model-changelog-modal");
    const modalTitle = document.getElementById("modal-model-title");
    const modalProvider = document.getElementById("modal-model-provider");
    const modalCount = document.getElementById("modal-update-count");
    const modalBody = document.getElementById("modal-changelog-body");
    const closeModalBtn = document.getElementById("close-changelog-modal");
    const closeModalBottomBtn = document.getElementById("close-modal-bottom-btn");
    const jumpToTimelineBtn = document.getElementById("jump-to-timeline-btn");

    let activeModalModelName = "";
    let lastFocusedElement: HTMLElement | null = null;

    // Load full JSON updates from data script tag
    let allUpdatesData: any[] = [];
    try {
      const dataScript = document.getElementById("model-updates-data");
      if (dataScript && dataScript.textContent) {
        allUpdatesData = JSON.parse(dataScript.textContent);
      }
    } catch (e) {
      console.warn("Could not parse embedded model updates data:", e);
    }

    function isSafeUrl(rawUrl: string): boolean {
      if (!rawUrl || typeof rawUrl !== "string") return false;
      try {
        const parsed = new URL(rawUrl);
        if (parsed.protocol !== "https:" && parsed.protocol !== "http:") return false;
        const hostname = parsed.hostname.toLowerCase();
        const ALLOWED = [
          "openai.com",
          "anthropic.com",
          "google.com",
          "deepmind.google",
          "deepseek.com",
          "meta.com",
          "ai.meta.com",
          "mistral.ai",
          "cohere.com",
          "x.ai",
          "microsoft.com",
          "huggingface.co",
          "github.com",
        ];
        return ALLOWED.some((d) => hostname === d || hostname.endsWith("." + d));
      } catch {
        return false;
      }
    }

    function createUpdateItemElement(u: any, isExact: boolean): HTMLElement {
      const card = document.createElement("div");
      card.className = "p-4 border border-theme-border bg-theme-surface rounded-lg space-y-2 mb-3";

      const topRow = document.createElement("div");
      topRow.className = "flex items-center justify-between gap-2 flex-wrap";

      const typeSpan = document.createElement("span");
      typeSpan.className = "px-2 py-0.5 rounded text-[9px] uppercase border border-theme-border bg-theme-elevated text-theme-primary font-bold";
      typeSpan.textContent = (u.update_type || "model_release").replace(/_/g, " ");

      const dateSpan = document.createElement("span");
      dateSpan.className = "text-theme-muted text-[10px]";
      dateSpan.textContent = u.published_at || "Date unconfirmed";

      topRow.appendChild(typeSpan);
      topRow.appendChild(dateSpan);
      card.appendChild(topRow);

      const titleEl = document.createElement("h4");
      titleEl.className = "text-sm font-bold text-theme-primary leading-snug";
      titleEl.textContent = u.title || "Untitled update";
      card.appendChild(titleEl);

      const summaryEl = document.createElement("p");
      summaryEl.className = "text-xs text-theme-secondary leading-relaxed";
      summaryEl.textContent = u.summary || "";
      card.appendChild(summaryEl);

      if (u.provider_claims && Array.isArray(u.provider_claims) && u.provider_claims.length > 0) {
        const claimDiv = document.createElement("div");
        claimDiv.className = "text-[10px] p-2 rounded border border-amber-500/30 bg-amber-500/10 text-amber-800 dark:text-amber-300";
        claimDiv.textContent = "⚠️ Provider claim — not an independent benchmark result.";
        card.appendChild(claimDiv);
      }

      const bottomRow = document.createElement("div");
      bottomRow.className = "pt-2 border-t border-theme-border-subtle flex items-center justify-between text-[10px]";

      const scopeSpan = document.createElement("span");
      scopeSpan.className = "text-theme-muted";
      scopeSpan.textContent = `Scope: ${u.scope || (isExact ? "model" : "model_family")}`;
      bottomRow.appendChild(scopeSpan);

      const safeUrl = isSafeUrl(u.source_url) ? u.source_url : "#";
      const linkEl = document.createElement("a");
      linkEl.href = safeUrl;
      if (safeUrl !== "#") {
        linkEl.target = "_blank";
        linkEl.rel = "noopener noreferrer";
      }
      linkEl.className = "text-theme-muted hover:text-theme-accent inline-flex items-center gap-1";

      const linkText = document.createElement("span");
      linkText.textContent = "Official Source";
      const linkArrow = document.createElement("span");
      linkArrow.textContent = "↗";
      linkEl.appendChild(linkText);
      linkEl.appendChild(linkArrow);
      bottomRow.appendChild(linkEl);

      card.appendChild(bottomRow);
      return card;
    }

    function openModelModal(modelId: string, modelName: string, modelFamily: string, provider: string) {
      if (!modal || !modalTitle || !modalProvider || !modalCount || !modalBody) return;

      lastFocusedElement = document.activeElement as HTMLElement | null;
      activeModalModelName = modelName;
      modalTitle.textContent = modelName;
      modalProvider.textContent = provider;

      // 1. Separate exact checkpoint updates from broad family announcements
      const exactUpdates = allUpdatesData.filter(
        (u) =>
          (u.model_id && u.model_id === modelId) ||
          (u.model_name && u.model_name.toLowerCase() === modelName.toLowerCase())
      );

      const familyKey = (modelFamily || "").toLowerCase();
      const familyUpdates = allUpdatesData.filter(
        (u) =>
          !exactUpdates.includes(u) &&
          u.model_family &&
          u.model_family.toLowerCase() === familyKey &&
          (u.scope === "model_family" || !u.model_id)
      );

      const total = exactUpdates.length + familyUpdates.length;
      modalCount.textContent = `${total} verified ${total === 1 ? "entry" : "entries"}`;

      modalBody.replaceChildren();

      if (total === 0) {
        const emptyBox = document.createElement("div");
        emptyBox.className = "p-8 text-center bg-theme-elevated/30 rounded border border-theme-border-subtle";
        const p1 = document.createElement("p");
        p1.className = "text-theme-primary font-medium mb-1";
        p1.textContent = "No tracked official release notes yet";
        const p2 = document.createElement("p");
        p2.className = "text-theme-muted text-[11px] leading-relaxed max-w-md mx-auto";
        p2.textContent = `No historical changelog records are associated with ${modelName} or the ${modelFamily} family yet. Official release notes will appear here automatically when published by ${provider}.`;
        emptyBox.appendChild(p1);
        emptyBox.appendChild(p2);
        modalBody.appendChild(emptyBox);
      } else {
        if (exactUpdates.length > 0) {
          const secHeader = document.createElement("div");
          secHeader.className = "flex items-center justify-between pb-1 mb-2 border-b border-theme-border-subtle";
          const hTitle = document.createElement("h4");
          hTitle.className = "text-xs font-bold text-theme-primary tracking-wide uppercase";
          hTitle.textContent = `Exact Model Updates (${exactUpdates.length})`;
          const badge = document.createElement("span");
          badge.className = "font-mono text-[9px] px-1.5 py-0.5 rounded border border-emerald-500/30 bg-emerald-500/10 text-emerald-700 dark:text-emerald-400 font-bold";
          badge.textContent = "Checkpoint-Specific";
          secHeader.appendChild(hTitle);
          secHeader.appendChild(badge);
          modalBody.appendChild(secHeader);

          exactUpdates.forEach((u) => {
            modalBody.appendChild(createUpdateItemElement(u, true));
          });
        } else if (familyUpdates.length > 0) {
          const noteBox = document.createElement("div");
          noteBox.className = "p-3 rounded border border-blue-500/30 bg-blue-500/10 text-blue-700 dark:text-blue-300 text-[11px] mb-3";
          noteBox.textContent = `No checkpoint-specific updates verified for ${modelName} yet. Showing ${familyUpdates.length} general ${modelFamily} family announcements below:`;
          modalBody.appendChild(noteBox);
        }

        if (familyUpdates.length > 0) {
          const famHeader = document.createElement("div");
          famHeader.className = `flex items-center justify-between pb-1 ${exactUpdates.length > 0 ? "mt-5" : ""} mb-2 border-b border-theme-border-subtle`;
          const fTitle = document.createElement("h4");
          fTitle.className = "text-xs font-bold text-theme-secondary tracking-wide uppercase";
          fTitle.textContent = `${modelFamily} Family Announcements (${familyUpdates.length})`;
          const fBadge = document.createElement("span");
          fBadge.className = "font-mono text-[9px] px-1.5 py-0.5 rounded border border-theme-border bg-theme-elevated text-theme-muted";
          fBadge.textContent = "Family-Wide";
          famHeader.appendChild(fTitle);
          famHeader.appendChild(fBadge);
          modalBody.appendChild(famHeader);

          familyUpdates.forEach((u) => {
            modalBody.appendChild(createUpdateItemElement(u, false));
          });
        }
      }

      modal.style.display = "flex";
      closeModalBtn?.focus();
    }

    function closeModal() {
      if (modal) modal.style.display = "none";
      if (lastFocusedElement) {
        lastFocusedElement.focus();
        lastFocusedElement = null;
      }
    }

    document.querySelectorAll<HTMLButtonElement>(".view-changelog-btn").forEach((btn) => {
      btn.addEventListener("click", () => {
        const modelId = btn.dataset.modelId || "";
        const modelName = btn.dataset.modelName || "";
        const modelFamily = btn.dataset.modelFamily || "";
        const provider = btn.dataset.provider || "";
        openModelModal(modelId, modelName, modelFamily, provider);
      });
    });

    closeModalBtn?.addEventListener("click", closeModal);
    closeModalBottomBtn?.addEventListener("click", closeModal);

    modal?.addEventListener("click", (e) => {
      if (e.target === modal) closeModal();
    });

    window.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && modal && modal.style.display === "flex") {
        closeModal();
      }
    });

    jumpToTimelineBtn?.addEventListener("click", () => {
      closeModal();
      if (updateSearchInput && activeModalModelName) {
        updateSearchInput.value = activeModalModelName;
        updateSearch = activeModalModelName.toLowerCase();
        filterUpdates();
        const section = document.getElementById("model-updates");
        section?.scrollIntoView({ behavior: "smooth" });
      }
    });

    // -------------------------------------------------------------------------
    // 3. Existing Model Catalogue Table Search & Filtering (Preserved 100%)
    // -------------------------------------------------------------------------
    const searchInput = document.getElementById("model-search-input") as HTMLInputElement | null;
    const filterButtons = document.querySelectorAll<HTMLButtonElement>(".model-filter-btn");
    const rows = document.querySelectorAll<HTMLTableRowElement>(".model-row");
    const countLabel = document.getElementById("model-count-label");
    const emptyState = document.getElementById("no-models-matched");
    const clearSearchBtn = document.getElementById("clear-model-search") as HTMLButtonElement | null;
    const resetFilterBtn = document.getElementById("reset-models-filter-btn") as HTMLButtonElement | null;

    let currentSearch = "";
    let currentFilter = "all";

    function filterModels() {
      let visible = 0;

      rows.forEach((row) => {
        const name = row.dataset.name || "";
        const provider = row.dataset.provider || "";
        const family = row.dataset.family || "";
        const license = row.dataset.license || "";
        const category = row.dataset.category || "";
        const modalities = row.dataset.modalities || "";
        const status = row.dataset.status || "";

        const matchesSearch =
          !currentSearch ||
          name.includes(currentSearch) ||
          provider.includes(currentSearch) ||
          family.includes(currentSearch);

        let matchesFilter = true;
        if (currentFilter === "reasoning") {
          matchesFilter = category.includes("reasoning");
        } else if (currentFilter === "coding") {
          matchesFilter = category.includes("coding") || name.includes("code") || name.includes("devstral") || name.includes("codestral");
        } else if (currentFilter === "multimodal") {
          matchesFilter = modalities.includes("image") || modalities.includes("audio") || modalities.includes("vision") || name.includes("vision") || name.includes("omni");
        } else if (currentFilter === "open") {
          matchesFilter = license.includes("open");
        } else if (currentFilter === "historical") {
          matchesFilter = status.includes("deprecated") || status.includes("historical") || status.includes("archive");
        }

        const show = matchesSearch && matchesFilter;
        row.style.display = show ? "" : "none";
        if (show) visible++;
      });

      if (countLabel) {
        countLabel.textContent = `Showing ${visible} of ${rows.length} models`;
      }

      if (emptyState) {
        emptyState.style.display = visible === 0 ? "block" : "none";
      }

      if (clearSearchBtn) {
        clearSearchBtn.style.display = currentSearch ? "" : "none";
      }
    }

    let currentModelSort = "release";
    let modelSortAsc = false;

    // Interactive Model Table Header Sorting
    const sortHeaders = document.querySelectorAll<HTMLTableCellElement>("#models-table th[data-sort]");
    sortHeaders.forEach((th) => {
      th.addEventListener("click", () => {
        const sortKey = th.dataset.sort;
        if (!sortKey) return;

        if (currentModelSort === sortKey) {
          modelSortAsc = !modelSortAsc;
        } else {
          currentModelSort = sortKey;
          modelSortAsc = sortKey === "release" ? false : true;
        }

        const tbody = document.querySelector("#models-table tbody");
        if (!tbody) return;

        const rowArray = Array.from(tbody.querySelectorAll<HTMLTableRowElement>(".model-row"));
        rowArray.sort((a, b) => {
          if (sortKey === "release") {
            const da = a.dataset.release ? new Date(a.dataset.release).getTime() : 0;
            const db = b.dataset.release ? new Date(b.dataset.release).getTime() : 0;
            return modelSortAsc ? da - db : db - da;
          } else if (sortKey === "context") {
            const ca = parseInt(a.dataset.context || "0", 10);
            const cb = parseInt(b.dataset.context || "0", 10);
            return modelSortAsc ? ca - cb : cb - ca;
          } else if (sortKey === "price") {
            const pa = parseFloat(a.dataset.price || "999999");
            const pb = parseFloat(b.dataset.price || "999999");
            return modelSortAsc ? pa - pb : pb - pa;
          } else {
            const va = a.dataset[sortKey] || "";
            const vb = b.dataset[sortKey] || "";
            return modelSortAsc ? va.localeCompare(vb) : vb.localeCompare(va);
          }
        });

        rowArray.forEach((r) => tbody.appendChild(r));

        sortHeaders.forEach((h) => {
          const k = h.dataset.sort;
          const label = h.textContent?.replace(/[▼▲]/g, "").trim() || "";
          if (k === currentModelSort) {
            h.textContent = `${label} ${modelSortAsc ? "▲" : "▼"}`;
            h.classList.add("text-emerald-700", "dark:text-emerald-400", "font-bold");
          } else {
            h.textContent = label;
            h.classList.remove("text-emerald-700", "dark:text-emerald-400", "font-bold");
          }
        });

        filterModels();
      });
    });

    if (searchInput) {
      searchInput.addEventListener("input", (e) => {
        currentSearch = (e.target as HTMLInputElement).value.toLowerCase().trim();
        filterModels();
      });

      searchInput.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && searchInput.value) {
          searchInput.value = "";
          currentSearch = "";
          filterModels();
        }
      });
    }

    if (clearSearchBtn) {
      clearSearchBtn.addEventListener("click", () => {
        if (searchInput) searchInput.value = "";
        currentSearch = "";
        filterModels();
        searchInput?.focus();
      });
    }

    filterButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        if (btn.disabled) return;
        filterButtons.forEach((b) => {
          b.classList.remove("bg-theme-elevated", "text-theme-primary");
          b.classList.add("text-theme-secondary");
          b.setAttribute("aria-pressed", "false");
        });

        btn.classList.remove("text-theme-secondary");
        btn.classList.add("bg-theme-elevated", "text-theme-primary");
        btn.setAttribute("aria-pressed", "true");

        currentFilter = btn.dataset.filter || "all";
        filterModels();
      });
    });

    if (resetFilterBtn) {
      resetFilterBtn.addEventListener("click", () => {
        if (searchInput) searchInput.value = "";
        currentSearch = "";
        currentFilter = "all";
        filterButtons.forEach((b) => {
          const isAll = (b.dataset.filter || "all") === "all";
          b.setAttribute("aria-pressed", isAll ? "true" : "false");
          if (isAll) {
            b.classList.add("bg-theme-elevated", "text-theme-primary");
            b.classList.remove("text-theme-secondary");
          } else if (!b.disabled) {
            b.classList.remove("bg-theme-elevated", "text-theme-primary");
            b.classList.add("text-theme-secondary");
          }
        });
        filterModels();
      });
    }
  })();
</script>
