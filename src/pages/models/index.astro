---
// src/pages/models/index.astro — Model Tracker
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import NewsCard from "../../components/NewsCard.astro";
import Footer from "../../components/Footer.astro";
import feedData from "../../data/feed.json";

interface FeedRecord {
  id: string;
  title: string;
  company: string;
  source: string;
  summary: string;
  url: string;
  date: string | null;
  category: string;
  fetched_at: string;
  _demo?: boolean;
}

const feed = feedData as FeedRecord[];
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

// Only real articles
const realArticles = feed.filter((a) => !a._demo);

// Filter articles related to models & product releases
const modelArticles = realArticles
  .filter(
    (a) =>
      a.category === "Product Release" ||
      /model|llm|weights|checkpoint|gpt|claude|gemini|llama|deepseek/i.test(a.title)
  )
  .sort((a, b) => {
    const da = a.date ? new Date(a.date).getTime() : 0;
    const db = b.date ? new Date(b.date).getTime() : 0;
    if (da !== db) return db - da;
    return new Date(b.fetched_at).getTime() - new Date(a.fetched_at).getTime();
  });

// Frontier foundation models index for quick reference
const frontierModels = [
  {
    name: "GPT-4o / o1 / o3-mini",
    developer: "OpenAI",
    type: "Frontier / Reasoning",
    context: "128k - 200k tokens",
    weights: "Proprietary API",
    status: "Active",
  },
  {
    name: "Claude 3.5 / 3.7 Sonnet",
    developer: "Anthropic",
    type: "Frontier / Coding & Reasoning",
    context: "200k tokens",
    weights: "Proprietary API",
    status: "Active",
  },
  {
    name: "Gemini 2.0 Flash / Pro",
    developer: "Google DeepMind",
    type: "Multimodal Frontier",
    context: "1M - 2M tokens",
    weights: "Proprietary API",
    status: "Active",
  },
  {
    name: "Llama 3.3 (70B) / Llama 3.1",
    developer: "Meta AI",
    type: "Dense / Open Weights",
    context: "128k tokens",
    weights: "Open Weights (Community)",
    status: "Active",
  },
  {
    name: "DeepSeek-V3 / DeepSeek-R1",
    developer: "DeepSeek",
    type: "MoE (671B) Reasoning",
    context: "128k tokens",
    weights: "Open Weights (MIT)",
    status: "Active",
  },
  {
    name: "Phi-4 / Phi-3.5",
    developer: "Microsoft",
    type: "Small Language Model (SLM)",
    context: "16k - 128k tokens",
    weights: "Open Weights (MIT)",
    status: "Active",
  },
];
---

<Layout title="AI Models Tracker — AI Pulse">
  <Header currentPath="/models/" />

  <main id="main-content" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <!-- Header banner -->
    <div class="mb-10">
      <div class="inline-flex items-center gap-2 font-mono text-[10px] tracking-widest uppercase px-2.5 py-1 rounded border border-emerald-500/30 bg-emerald-500/10 text-emerald-400 mb-3">
        <span>Live Tracker</span>
      </div>
      <h1 class="text-2xl sm:text-3xl font-bold text-neutral-100 tracking-tight mb-2">
        Model Tracker
      </h1>
      <p class="text-sm text-neutral-400 leading-relaxed max-w-2xl">
        Frontier architecture milestones, open-weights releases, and model deployment news across OpenAI, Anthropic, Google, Meta, DeepSeek, and the open-source community.
      </p>
    </div>

    <!-- Frontier Model Reference Table -->
    <section class="mb-12 border border-neutral-800 bg-neutral-900/40 rounded-lg p-6">
      <h2 class="text-xs font-mono text-neutral-400 tracking-widest uppercase mb-4">
        Frontier Model Landscape
      </h2>
      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs font-mono">
          <thead>
            <tr class="border-b border-neutral-800 text-neutral-500 text-[11px]">
              <th class="pb-3 pr-4 font-medium">Model</th>
              <th class="pb-3 pr-4 font-medium">Lab</th>
              <th class="pb-3 pr-4 font-medium">Category</th>
              <th class="pb-3 pr-4 font-medium">Context Window</th>
              <th class="pb-3 font-medium">Availability</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-neutral-800/60 text-neutral-300">
            {
              frontierModels.map((m) => (
                <tr class="hover:bg-neutral-800/20 transition-colors">
                  <td class="py-3 pr-4 font-semibold text-neutral-100">{m.name}</td>
                  <td class="py-3 pr-4 text-neutral-400">{m.developer}</td>
                  <td class="py-3 pr-4 text-neutral-400">{m.type}</td>
                  <td class="py-3 pr-4 text-emerald-400">{m.context}</td>
                  <td class="py-3">
                    <span class={`inline-block px-2 py-0.5 rounded text-[10px] ${
                      m.weights.includes("Open")
                        ? "border border-emerald-500/30 bg-emerald-500/10 text-emerald-400"
                        : "border border-neutral-700 bg-neutral-800 text-neutral-300"
                    }`}>
                      {m.weights}
                    </span>
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </section>

    <!-- Model Release News Feed -->
    <section>
      <div class="flex items-center justify-between mb-6">
        <h2 class="text-xs font-mono text-neutral-400 tracking-widest uppercase">
          Latest Model & Release News ({modelArticles.length})
        </h2>
        <a
          href={`${base}/news/`}
          class="font-mono text-[10px] text-neutral-500 hover:text-emerald-400 transition-colors"
        >
          View all news →
        </a>
      </div>

      {
        modelArticles.length === 0 ? (
          <div class="border border-neutral-800 rounded-lg p-10 text-center bg-neutral-900/30">
            <p class="font-mono text-xs text-neutral-400">
              No model release articles indexed yet. New releases from OpenAI, Hugging Face, Google, and VS Code will populate automatically after pipeline ingestion.
            </p>
          </div>
        ) : (
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
            {modelArticles.map((article) => (
              <NewsCard
                id={article.id}
                title={article.title}
                company={article.company}
                source={article.source}
                summary={article.summary}
                url={article.url}
                date={article.date}
                category={article.category}
                fetched_at={article.fetched_at}
                isDemo={false}
              />
            ))}
          </div>
        )
      }
    </section>
  </main>

  <Footer />
</Layout>
