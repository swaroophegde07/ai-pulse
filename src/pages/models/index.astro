---
// src/pages/models/index.astro — Model Tracker
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import NewsCard from "../../components/NewsCard.astro";
import Footer from "../../components/Footer.astro";
import feedData from "../../data/feed.json";
import modelsData from "../../data/models.json";

interface FeedRecord {
  id: string;
  title: string;
  company: string;
  source: string;
  summary: string;
  url: string;
  date: string | null;
  category: string;
  fetched_at: string;
  _demo?: boolean;
}

interface ModelRecord {
  id: string;
  name: string;
  provider: string;
  family: string;
  release_date?: string | null;
  lifecycle_status: string;
  context_window: number;
  input_modalities?: string[];
  output_modalities?: string[];
  license_type: string;
  api_available: boolean;
  consumer_available: boolean;
  pricing?: {
    input_per_1m: number;
    output_per_1m: number;
    unit: string;
  };
  documentation_url: string;
  source_url: string;
  last_verified: string;
  notes?: string;
  category?: string;
  is_featured_frontier?: boolean;
  verification_sources?: Record<string, string>;
}

const feed = feedData as FeedRecord[];
const models = modelsData as ModelRecord[];
const featuredFrontierModels = models.filter((m) => m.is_featured_frontier);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

// Only real articles
const realArticles = feed.filter((a) => !a._demo);

// Filter articles related to models & product releases
const modelArticles = realArticles
  .filter(
    (a) =>
      a.category === "Product Release" ||
      /model|llm|weights|checkpoint|gpt|claude|gemini|llama|deepseek|phi/i.test(a.title)
  )
  .sort((a, b) => {
    const da = a.date ? new Date(a.date).getTime() : 0;
    const db = b.date ? new Date(b.date).getTime() : 0;
    if (da !== db) return db - da;
    return new Date(b.fetched_at).getTime() - new Date(a.fetched_at).getTime();
  });

function formatTokens(tokens: number): string {
  if (tokens >= 1_000_000) {
    return `${(tokens / 1_000_000).toFixed(tokens % 1_000_000 === 0 ? 0 : 1)}M`;
  }
  return `${Math.round(tokens / 1000)}k`;
}

const providers = ["All", ...Array.from(new Set(models.map((m) => m.provider)))];
---

<Layout title="AI Models Tracker — AI Pulse">
  <Header currentPath="/models/" />

  <main id="main-content" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <!-- Header banner -->
    <div class="mb-10">
      <div class="inline-flex items-center gap-2 font-mono text-[10px] tracking-widest uppercase px-2.5 py-1 rounded border border-emerald-500/30 bg-emerald-500/10 text-emerald-400 mb-3">
        <span>Verified Specifications</span>
      </div>
      <h1 class="text-2xl sm:text-3xl font-bold text-neutral-100 tracking-tight mb-2">
        Model Tracker
      </h1>
      <p class="text-sm text-neutral-400 leading-relaxed max-w-3xl">
        Frontier architecture specifications, verified context windows, API & consumer pricing, modalities, and open-weights licensing across leading research labs.
      </p>
    </div>

    <!-- Quick stats overview -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-8">
      <div class="border border-neutral-800 bg-neutral-900/40 p-4 rounded-lg">
        <span class="font-mono text-[10px] text-neutral-500 tracking-widest uppercase block mb-1">
          Cataloged Models
        </span>
        <span class="font-mono text-xl font-bold text-neutral-100">{models.length}</span>
      </div>
      <div class="border border-neutral-800 bg-neutral-900/40 p-4 rounded-lg">
        <span class="font-mono text-[10px] text-neutral-500 tracking-widest uppercase block mb-1">
          Open Weights
        </span>
        <span class="font-mono text-xl font-bold text-emerald-400">
          {models.filter((m) => m.license_type.includes("Open")).length}
        </span>
      </div>
      <div class="border border-neutral-800 bg-neutral-900/40 p-4 rounded-lg">
        <span class="font-mono text-[10px] text-neutral-500 tracking-widest uppercase block mb-1">
          Max Context Window
        </span>
        <span class="font-mono text-xl font-bold text-neutral-100">
          {formatTokens(Math.max(...models.map((m) => m.context_window)))}
        </span>
      </div>
      <div class="border border-neutral-800 bg-neutral-900/40 p-4 rounded-lg">
        <span class="font-mono text-[10px] text-neutral-500 tracking-widest uppercase block mb-1">
          Active Providers
        </span>
        <span class="font-mono text-xl font-bold text-neutral-100">{providers.length - 1}</span>
      </div>
    </div>

    <!-- Featured Frontier Models Section -->
    <section class="mb-14">
      <div class="flex items-center justify-between mb-6">
        <div>
          <h2 class="text-xs font-mono text-neutral-300 tracking-widest uppercase mb-1">
            Featured Frontier Models
          </h2>
          <p class="text-xs text-neutral-500 font-mono">
            Flagship reasoning, coding, and multimodal models actively deployed across primary AI research laboratories.
          </p>
        </div>
        <span class="font-mono text-[10px] text-neutral-400 border border-neutral-800 bg-neutral-900/60 px-2.5 py-1 rounded">
          {featuredFrontierModels.length} Featured Flagships
        </span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        {
          featuredFrontierModels.map((m) => (
            <div class="border border-neutral-800 bg-neutral-900/40 rounded-lg p-5 flex flex-col justify-between hover:border-neutral-700 transition-colors">
              <div>
                <div class="flex items-center justify-between gap-2 mb-2.5">
                  <span class="font-mono text-[10px] uppercase tracking-wider px-2 py-0.5 rounded border border-neutral-700 bg-neutral-800 text-neutral-300">
                    {m.provider}
                  </span>
                  <span
                    class={`font-mono text-[9px] uppercase tracking-wider px-1.5 py-0.5 rounded border ${
                      m.license_type.includes("Open")
                        ? "border-emerald-500/30 bg-emerald-500/10 text-emerald-400"
                        : "border-blue-500/30 bg-blue-500/10 text-blue-400"
                    }`}
                  >
                    {m.license_type}
                  </span>
                </div>

                <h3 class="text-sm font-bold text-neutral-100 mb-1">
                  {m.name}
                </h3>
                <p class="text-[11px] text-neutral-400 mb-4 line-clamp-2">
                  {m.notes || `${m.provider} foundation model in the ${m.family} family.`}
                </p>

                <div class="grid grid-cols-2 gap-2 text-[11px] font-mono border-t border-neutral-800/80 pt-3 mb-3">
                  <div>
                    <span class="text-[10px] text-neutral-500 block">Context Window</span>
                    <span class="font-semibold text-neutral-200">
                      {formatTokens(m.context_window)} tokens
                    </span>
                  </div>
                  <div>
                    <span class="text-[10px] text-neutral-500 block">Pricing / 1M In/Out</span>
                    <span class="font-semibold text-neutral-200">
                      {m.pricing
                        ? `$${m.pricing.input_per_1m.toFixed(2)} / $${m.pricing.output_per_1m.toFixed(2)}`
                        : "Not specified"}
                    </span>
                  </div>
                </div>
              </div>

              <div class="flex items-center justify-between pt-2 border-t border-neutral-800/60 font-mono text-[10px]">
                <span class="text-neutral-500">
                  Released: {m.release_date || "Active"}
                </span>
                <a
                  href={m.documentation_url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-neutral-400 hover:text-emerald-400 transition-colors inline-flex items-center gap-1"
                >
                  Docs ↗
                </a>
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Complete Model Catalogue: Interactive Filters & Search -->
    <div class="border border-neutral-800 bg-neutral-900/50 rounded-lg p-5 mb-8">
      <div class="flex flex-col sm:flex-row gap-4 justify-between items-start sm:items-center">
        <!-- Search -->
        <div class="w-full sm:w-72 relative">
          <label for="model-search-input" class="sr-only">Search models</label>
          <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-neutral-500">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
            </svg>
          </div>
          <input
            type="search"
            id="model-search-input"
            placeholder="Search model, provider, family..."
            class="w-full bg-neutral-950 border border-neutral-800 rounded pl-9 pr-8 py-2 text-xs text-neutral-100 placeholder:text-neutral-600 font-mono focus:outline-none focus:border-emerald-500"
          />
          <button
            type="button"
            id="clear-model-search"
            style="display: none;"
            class="absolute inset-y-0 right-0 pr-2.5 flex items-center text-neutral-500 hover:text-neutral-200 transition-colors cursor-pointer"
            aria-label="Clear model search"
          >
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
          </button>
        </div>

        <!-- Filter tabs -->
        <div class="flex flex-wrap gap-2" role="toolbar" aria-label="Filter models by category">
          <button
            type="button"
            class="model-filter-btn font-mono text-[10px] uppercase tracking-wider px-3 py-1.5 rounded border border-neutral-700 bg-neutral-800 text-neutral-100 transition-colors"
            data-filter="all"
            aria-pressed="true"
          >
            All ({models.length})
          </button>
          <button
            type="button"
            class="model-filter-btn font-mono text-[10px] uppercase tracking-wider px-3 py-1.5 rounded border border-neutral-800 text-neutral-400 hover:text-neutral-200 hover:border-neutral-700 transition-colors"
            data-filter="reasoning"
            aria-pressed="false"
          >
            Frontier Reasoning
          </button>
          <button
            type="button"
            class="model-filter-btn font-mono text-[10px] uppercase tracking-wider px-3 py-1.5 rounded border border-neutral-800 text-neutral-400 hover:text-neutral-200 hover:border-neutral-700 transition-colors"
            data-filter="coding"
            aria-pressed="false"
          >
            Coding
          </button>
          <button
            type="button"
            class="model-filter-btn font-mono text-[10px] uppercase tracking-wider px-3 py-1.5 rounded border border-neutral-800 text-neutral-400 hover:text-neutral-200 hover:border-neutral-700 transition-colors"
            data-filter="multimodal"
            aria-pressed="false"
          >
            Multimodal
          </button>
          <button
            type="button"
            class="model-filter-btn font-mono text-[10px] uppercase tracking-wider px-3 py-1.5 rounded border border-neutral-800 text-neutral-400 hover:text-neutral-200 hover:border-neutral-700 transition-colors"
            data-filter="open"
            aria-pressed="false"
          >
            Open Weights
          </button>
          <button
            type="button"
            class="model-filter-btn font-mono text-[10px] uppercase tracking-wider px-3 py-1.5 rounded border border-neutral-800 text-neutral-400 hover:text-neutral-200 hover:border-neutral-700 transition-colors"
            data-filter="historical"
            aria-pressed="false"
          >
            Historical
          </button>
        </div>
      </div>
    </div>

    <!-- Complete Model Catalogue Table -->
    <section class="mb-14 border border-neutral-800 bg-neutral-900/30 rounded-lg overflow-hidden">
      <div class="px-6 py-4 border-b border-neutral-800 flex justify-between items-center">
        <div>
          <h2 class="text-xs font-mono text-neutral-300 tracking-widest uppercase">
            Complete Model Catalogue
          </h2>
          <p class="text-[10px] text-neutral-500 font-mono mt-0.5">
            Full inventory of verified frontier models, open weights, and catalog telemetry.
          </p>
        </div>
        <div class="flex items-center gap-3">
          <span class="font-mono text-[10px] text-neutral-500" id="model-count-label">
            Showing {models.length} models
          </span>
          <span class="text-neutral-700 hidden sm:inline">&middot;</span>
          <a
            href="https://github.com/swaroophegde07/ai-pulse/issues/new?template=data_correction.yml&title=%5BData+Correction%5D%3A+Model+Specification+Inaccuracy&affected_page=https%3A%2F%2Fswaroophegde07.github.io%2Fai-pulse%2Fmodels%2F&entity_type=AI+Model+%28Specs%2C+Pricing%2C+Context+Window%2C+License%2C+Architecture%29"
            target="_blank"
            rel="noopener noreferrer"
            class="hidden sm:inline-flex items-center gap-1 font-mono text-[10px] text-neutral-400 hover:text-blue-400 transition-colors"
            title="Report incorrect model specifications or pricing via GitHub Issue Form"
          >
            <span>Report incorrect model info</span>
            <span>↗</span>
          </a>
        </div>
      </div>

      <div class="overflow-x-auto custom-scrollbar">
        <div class="block sm:hidden text-[10px] text-neutral-400 font-mono px-6 py-2 bg-neutral-950/80 border-b border-neutral-800/80">
          Swipe table horizontally for pricing & context details →
        </div>
        <table class="w-full text-left text-xs font-mono" id="models-table">
          <thead>
            <tr class="border-b border-neutral-800 bg-neutral-950/40 text-neutral-500 text-[11px]">
              <th class="py-3.5 pl-6 pr-4 font-medium">Model</th>
              <th class="py-3.5 pr-4 font-medium">Provider</th>
              <th class="py-3.5 pr-4 font-medium">Context</th>
              <th class="py-3.5 pr-4 font-medium">Modalities</th>
              <th class="py-3.5 pr-4 font-medium">Pricing (In / Out per 1M)</th>
              <th class="py-3.5 pr-4 font-medium">Availability</th>
              <th class="py-3.5 pr-6 text-right font-medium">Docs</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-neutral-800/60 text-neutral-300">
            {
              models.map((m) => (
                <tr
                  class="model-row hover:bg-neutral-800/30 transition-colors"
                  data-name={m.name.toLowerCase()}
                  data-provider={m.provider.toLowerCase()}
                  data-family={m.family.toLowerCase()}
                  data-license={m.license_type.toLowerCase()}
                  data-category={(m.category || "").toLowerCase()}
                  data-modalities={(m.input_modalities || []).join(" ").toLowerCase()}
                  data-status={(m.lifecycle_status || "").toLowerCase()}
                  data-frontier={m.is_featured_frontier ? "true" : "false"}
                >
                  <td class="py-4 pl-6 pr-4">
                    <div class="flex items-center gap-2">
                      <span class="font-semibold text-neutral-100">{m.name}</span>
                      {m.category && (
                        <span class="text-[9px] font-mono px-1.5 py-0.5 rounded border border-neutral-700 bg-neutral-800 text-neutral-400">
                          {m.category}
                        </span>
                      )}
                    </div>
                    <div class="text-[10px] text-neutral-500 font-mono mt-0.5">
                      Released: {m.release_date || "Unknown"}
                    </div>
                  </td>
                  <td class="py-4 pr-4 text-neutral-300 font-medium">{m.provider}</td>
                  <td class="py-4 pr-4 text-emerald-400 font-semibold">
                    {formatTokens(m.context_window)} tokens
                  </td>
                  <td class="py-4 pr-4">
                    <div class="text-[11px] text-neutral-300">
                      In: {(m.input_modalities || ["text"]).join(", ")}
                    </div>
                    <div class="text-[10px] text-neutral-500">
                      Out: {(m.output_modalities || ["text"]).join(", ")}
                    </div>
                  </td>
                  <td class="py-4 pr-4">
                    {m.pricing ? (
                      <div>
                        <span class="text-neutral-200 font-medium">
                          ${m.pricing.input_per_1m.toFixed(2)}
                        </span>{" "}
                        /{" "}
                        <span class="text-neutral-400">
                          ${m.pricing.output_per_1m.toFixed(2)}
                        </span>
                      </div>
                    ) : (
                      <span class="text-neutral-600">Not verified</span>
                    )}
                  </td>
                  <td class="py-4 pr-4">
                    <span
                      class={`inline-block px-2 py-0.5 rounded text-[10px] ${
                        (m.license_type || "").includes("Open")
                          ? "border border-emerald-500/30 bg-emerald-500/10 text-emerald-400"
                          : "border border-neutral-700 bg-neutral-800 text-neutral-300"
                      }`}
                    >
                      {m.license_type}
                    </span>
                    <div class="text-[9px] text-neutral-500 mt-1 font-mono">
                      {m.verification_sources?.telemetry
                        ? `Telemetry: ${m.verification_sources.telemetry}`
                        : m.consumer_available
                          ? "API + Web Chat"
                          : "API Only"}
                    </div>
                  </td>
                  <td class="py-4 pr-6 text-right">
                    <a
                      href={m.documentation_url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-1 font-mono text-[10px] text-neutral-400 hover:text-emerald-400 transition-colors"
                      aria-label={`Official docs for ${m.name} (opens in new tab)`}
                    >
                      <span>Docs</span>
                      <span>↗</span>
                    </a>
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <div
        id="no-models-matched"
        style="display: none;"
        class="p-12 text-center font-mono text-xs text-neutral-400 bg-neutral-950/40"
      >
        <p class="mb-3 text-neutral-300">No models match the search or filter criteria.</p>
        <button
          type="button"
          id="reset-models-filter-btn"
          class="font-mono text-[10px] uppercase tracking-wider text-neutral-300 hover:text-white px-3 py-1.5 rounded border border-neutral-700 bg-neutral-800 hover:bg-neutral-700 transition-colors cursor-pointer"
        >
          Reset model filters
        </button>
      </div>

      <div class="px-6 py-2.5 bg-neutral-950/60 border-t border-neutral-800/80 flex flex-wrap items-center justify-between gap-2 text-[10px] font-mono text-neutral-500">
        <span>Verified against OpenRouter &amp; provider disclosures</span>
        <a
          href="https://github.com/swaroophegde07/ai-pulse/issues/new?template=data_correction.yml&title=%5BData+Correction%5D%3A+Model+Specification+Inaccuracy&affected_page=https%3A%2F%2Fswaroophegde07.github.io%2Fai-pulse%2Fmodels%2F&entity_type=AI+Model+%28Specs%2C+Pricing%2C+Context+Window%2C+License%2C+Architecture%29"
          target="_blank"
          rel="noopener noreferrer"
          class="text-neutral-400 hover:text-blue-400 transition-colors inline-flex items-center gap-1"
        >
          <span>Report incorrect model information</span>
          <span>↗</span>
        </a>
      </div>
    </section>

    <!-- Model Release News Feed -->
    <section>
      <div class="flex items-center justify-between mb-6">
        <div>
          <h2 class="text-xs font-mono text-neutral-400 tracking-widest uppercase">
            Model Releases & Architecture Coverage ({modelArticles.length})
          </h2>
          <p class="text-[11px] text-neutral-500 font-mono mt-0.5">
            Verified release announcements and model drop coverage from provider blogs.
          </p>
        </div>
        <a
          href={`${base}/news/`}
          class="font-mono text-[10px] text-neutral-500 hover:text-emerald-400 transition-colors"
        >
          View all news →
        </a>
      </div>

      {
        modelArticles.length === 0 ? (
          <div class="border border-neutral-800 rounded-lg p-10 text-center bg-neutral-900/30">
            <p class="font-mono text-xs text-neutral-400">
              No recent model release articles ingested yet. New releases from OpenAI, Hugging Face, and Google will populate automatically after pipeline runs.
            </p>
          </div>
        ) : (
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
            {modelArticles.map((article) => (
              <NewsCard
                id={article.id}
                title={article.title}
                company={article.company}
                source={article.source}
                summary={article.summary}
                url={article.url}
                date={article.date}
                category={article.category}
                fetched_at={article.fetched_at}
                isDemo={false}
              />
            ))}
          </div>
        )
      }
    </section>
  </main>

  <Footer />
</Layout>

<script>
  (function () {
    const searchInput = document.getElementById("model-search-input") as HTMLInputElement | null;
    const filterButtons = document.querySelectorAll<HTMLButtonElement>(".model-filter-btn");
    const rows = document.querySelectorAll<HTMLTableRowElement>(".model-row");
    const countLabel = document.getElementById("model-count-label");
    const emptyState = document.getElementById("no-models-matched");
    const clearSearchBtn = document.getElementById("clear-model-search") as HTMLButtonElement | null;
    const resetFilterBtn = document.getElementById("reset-models-filter-btn") as HTMLButtonElement | null;

    let currentSearch = "";
    let currentFilter = "all";

    function filterModels() {
      let visible = 0;

      rows.forEach((row) => {
        const name = row.dataset.name || "";
        const provider = row.dataset.provider || "";
        const family = row.dataset.family || "";
        const license = row.dataset.license || "";
        const category = row.dataset.category || "";
        const modalities = row.dataset.modalities || "";
        const status = row.dataset.status || "";
        const isFrontier = row.dataset.frontier === "true";

        const matchesSearch =
          !currentSearch ||
          name.includes(currentSearch) ||
          provider.includes(currentSearch) ||
          family.includes(currentSearch);

        let matchesFilter = true;
        if (currentFilter === "reasoning") {
          matchesFilter = category.includes("reasoning") || isFrontier;
        } else if (currentFilter === "coding") {
          matchesFilter = category.includes("coding") || name.includes("code") || name.includes("devstral");
        } else if (currentFilter === "multimodal") {
          matchesFilter = modalities.includes("image") || modalities.includes("audio") || modalities.includes("vision") || name.includes("vision") || name.includes("omni");
        } else if (currentFilter === "open") {
          matchesFilter = license.includes("open");
        } else if (currentFilter === "historical") {
          matchesFilter = status.includes("deprecated") || status.includes("historical") || status.includes("archive");
        }

        const show = matchesSearch && matchesFilter;
        row.style.display = show ? "" : "none";
        if (show) visible++;
      });

      if (countLabel) {
        countLabel.textContent = `Showing ${visible} of ${rows.length} models`;
      }

      if (emptyState) {
        emptyState.style.display = visible === 0 ? "block" : "none";
      }

      if (clearSearchBtn) {
        clearSearchBtn.style.display = currentSearch ? "" : "none";
      }
    }

    if (searchInput) {
      searchInput.addEventListener("input", (e) => {
        currentSearch = (e.target as HTMLInputElement).value.toLowerCase().trim();
        filterModels();
      });

      searchInput.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && searchInput.value) {
          searchInput.value = "";
          currentSearch = "";
          filterModels();
        }
      });
    }

    if (clearSearchBtn) {
      clearSearchBtn.addEventListener("click", () => {
        if (searchInput) searchInput.value = "";
        currentSearch = "";
        filterModels();
        searchInput?.focus();
      });
    }

    filterButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        filterButtons.forEach((b) => {
          b.classList.remove("border-neutral-700", "bg-neutral-800", "text-neutral-100");
          b.classList.add("border-neutral-800", "text-neutral-400");
          b.setAttribute("aria-pressed", "false");
        });

        btn.classList.remove("border-neutral-800", "text-neutral-400");
        btn.classList.add("border-neutral-700", "bg-neutral-800", "text-neutral-100");
        btn.setAttribute("aria-pressed", "true");

        currentFilter = btn.dataset.filter || "all";
        filterModels();
      });
    });

    if (resetFilterBtn) {
      resetFilterBtn.addEventListener("click", () => {
        if (searchInput) searchInput.value = "";
        currentSearch = "";
        currentFilter = "all";
        filterButtons.forEach((b) => {
          const isAll = (b.dataset.filter || "all") === "all";
          b.setAttribute("aria-pressed", isAll ? "true" : "false");
          if (isAll) {
            b.classList.add("border-neutral-700", "bg-neutral-800", "text-neutral-100");
            b.classList.remove("border-neutral-800", "text-neutral-400");
          } else {
            b.classList.remove("border-neutral-700", "bg-neutral-800", "text-neutral-100");
            b.classList.add("border-neutral-800", "text-neutral-400");
          }
        });
        filterModels();
      });
    }
  })();
</script>
