---
// src/pages/models/index.astro — Model Tracker & Official Changelog
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import NewsCard from "../../components/NewsCard.astro";
import Footer from "../../components/Footer.astro";
import feedData from "../../data/feed.json";
import modelsData from "../../data/models.json";
import modelUpdatesData from "../../data/model-updates.json";

interface FeedRecord {
  id: string;
  title: string;
  company: string;
  source: string;
  summary: string;
  url: string;
  date: string | null;
  category: string;
  fetched_at: string;
  _demo?: boolean;
  topics?: string[];
  tags?: string[];
  key_points?: string[];
  impact_score?: number | null;
  sources?: { title?: string; url: string; publisher?: string }[];
  priority_label?: string;
  priority_explanation?: string;
  why_it_matters?: string;
  source_type?: string;
  summary_status?: string;
}

interface ModelRecord {
  id: string;
  name: string;
  provider: string;
  family: string;
  release_date?: string | null;
  lifecycle_status: string;
  context_window: number;
  input_modalities?: string[];
  output_modalities?: string[];
  license_type: string;
  api_available: boolean;
  consumer_available: boolean;
  pricing?: {
    input_per_1m: number;
    output_per_1m: number;
    unit: string;
  };
  documentation_url: string;
  source_url: string;
  last_verified: string;
  notes?: string;
  category?: string;
  is_featured_frontier?: boolean;
  verification_sources?: Record<string, string>;
}

interface ModelUpdateRecord {
  id: string;
  provider_id: string;
  provider_name: string;
  title: string;
  summary: string;
  update_type: string;
  scope: string;
  model_name?: string | null;
  model_family?: string | null;
  model_id?: string | null;
  published_at?: string | null;
  detected_at: string;
  source_type: string;
  source_url: string;
  verification_status: string;
  source_id: string;
  provider_claims?: string[];
}

const feed = feedData as FeedRecord[];
const models = (modelsData as ModelRecord[]).slice().sort((a, b) => {
  const da = a.release_date ? new Date(a.release_date).getTime() : 0;
  const db = b.release_date ? new Date(b.release_date).getTime() : 0;
  if (da !== db) return db - da;
  return a.name.localeCompare(b.name);
});
const featuredFrontierModels = models.filter((m) => m.is_featured_frontier);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

// Sort model updates chronologically descending
const modelUpdates = (modelUpdatesData as ModelUpdateRecord[]).slice().sort((a, b) => {
  const da = a.published_at ? new Date(a.published_at).getTime() : 0;
  const db = b.published_at ? new Date(b.published_at).getTime() : 0;
  if (da !== db) return db - da;
  return new Date(b.detected_at).getTime() - new Date(a.detected_at).getTime();
});

// Group exact updates by model_id and family updates by family
const exactUpdatesByModelId = new Map<string, ModelUpdateRecord[]>();
const familyUpdatesByFamily = new Map<string, ModelUpdateRecord[]>();

for (const u of modelUpdates) {
  if (u.model_id) {
    const list = exactUpdatesByModelId.get(u.model_id) || [];
    list.push(u);
    exactUpdatesByModelId.set(u.model_id, list);
  }
  if (u.model_family) {
    const key = u.model_family.toLowerCase();
    const list = familyUpdatesByFamily.get(key) || [];
    list.push(u);
    familyUpdatesByFamily.set(key, list);
  }
}

// Model counts for category filters
const reasoningModelsCount = models.filter((m) =>
  (m.category || "").toLowerCase().includes("reasoning")
).length;

const codingModelsCount = models.filter((m) => {
  const cat = (m.category || "").toLowerCase();
  const name = m.name.toLowerCase();
  return cat.includes("coding") || name.includes("code") || name.includes("devstral") || name.includes("codestral");
}).length;

const multimodalModelsCount = models.filter((m) => {
  const mods = (m.input_modalities || []).join(" ").toLowerCase() + " " + (m.output_modalities || []).join(" ").toLowerCase();
  const name = m.name.toLowerCase();
  return mods.includes("image") || mods.includes("audio") || mods.includes("vision") || name.includes("vision") || name.includes("omni");
}).length;

const openWeightsModelsCount = models.filter((m) =>
  m.license_type.toLowerCase().includes("open")
).length;

const historicalModelsCount = models.filter((m) => {
  const s = (m.lifecycle_status || "").toLowerCase();
  return s.includes("deprecated") || s.includes("historical") || s.includes("archive");
}).length;

function formatPrice(num: number | null | undefined): string {
  if (num === null || num === undefined || isNaN(num)) return "0.00";
  if (num === 0) return "0.00";
  const rounded = Number(num.toFixed(4));
  if (rounded >= 1 && Number.isInteger(rounded)) {
    return rounded.toFixed(2);
  }
  const str = rounded.toString();
  const parts = str.split(".");
  if (parts.length === 1) {
    return `${parts[0]}.00`;
  }
  if (parts[1].length === 1) {
    return `${parts[0]}.${parts[1]}0`;
  }
  return str;
}

// Providers for model updates filter
const updateProviders = ["All", ...Array.from(new Set(modelUpdates.map((u) => u.provider_name)))];

// Only real articles
const realArticles = feed.filter((a) => !a._demo);

// Filter articles related to models & product releases
const modelArticles = realArticles
  .filter(
    (a) =>
      a.category === "Product Release" ||
      /model|llm|weights|checkpoint|gpt|claude|gemini|llama|deepseek|phi/i.test(a.title)
  )
  .sort((a, b) => {
    const da = a.date ? new Date(a.date).getTime() : 0;
    const db = b.date ? new Date(b.date).getTime() : 0;
    if (da !== db) return db - da;
    return new Date(b.fetched_at).getTime() - new Date(a.fetched_at).getTime();
  });

function formatTokens(tokens: number): string {
  if (tokens >= 1_000_000) {
    return `${(tokens / 1_000_000).toFixed(tokens % 1_000_000 === 0 ? 0 : 1)}M`;
  }
  return `${Math.round(tokens / 1000)}k`;
}

function formatUpdateTypeLabel(t: string): string {
  switch (t) {
    case "model_release":
      return "Model Release";
    case "capability_change":
      return "Capability";
    case "pricing_change":
      return "Pricing";
    case "context_window_change":
      return "Context Window";
    case "api_availability":
      return "API";
    case "modality_change":
      return "Modality";
    case "deprecation":
      return "Deprecation";
    case "product_update":
      return "Product";
    case "research_release":
      return "Research";
    default:
      return t.replace(/_/g, " ");
  }
}

function getUpdateBadgeClass(t: string): string {
  switch (t) {
    case "model_release":
      return "border-emerald-500/30 bg-emerald-500/10 text-emerald-700 dark:text-emerald-400";
    case "capability_change":
      return "border-blue-500/30 bg-blue-500/10 text-blue-700 dark:text-blue-400";
    case "pricing_change":
      return "border-amber-500/30 bg-amber-500/10 text-amber-800 dark:text-amber-400";
    case "context_window_change":
      return "border-cyan-500/30 bg-cyan-500/10 text-cyan-800 dark:text-cyan-400";
    case "api_availability":
      return "border-indigo-500/30 bg-indigo-500/10 text-indigo-700 dark:text-indigo-400";
    case "deprecation":
      return "border-rose-500/30 bg-rose-500/10 text-rose-700 dark:text-rose-400";
    case "product_update":
      return "border-purple-500/30 bg-purple-500/10 text-purple-700 dark:text-purple-400";
    case "research_release":
      return "border-teal-500/30 bg-teal-500/10 text-teal-800 dark:text-teal-400";
    default:
      return "border-theme-border bg-theme-elevated text-theme-secondary";
  }
}

const providers = ["All", ...Array.from(new Set(models.map((m) => m.provider)))];
---

<Layout title="AI Models Tracker & Official Changelog — AI Pulse">
  <Header currentPath="/models/" />

  <main id="main-content" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <!-- Header banner -->
    <div class="mb-10 animate-reveal">
      <div class="inline-flex items-center gap-2 font-mono text-[10px] tracking-widest uppercase px-2.5 py-1 rounded border border-emerald-500/30 bg-emerald-500/10 text-emerald-700 dark:text-emerald-400 mb-3">
        <span>Verified Specifications &amp; Official Changelogs</span>
      </div>
      <h1 class="text-2xl sm:text-3xl font-bold text-theme-primary tracking-tight mb-2">
        Model Tracker &amp; Updates
      </h1>
      <p class="text-sm text-theme-secondary leading-relaxed max-w-3xl">
        Frontier architecture specifications, verified context windows, API &amp; consumer pricing, modalities, open-weights licensing, and traceable official release notes across leading research labs.
      </p>
    </div>

    <!-- Quick stats overview -->
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-4 mb-8">
      <div class="border border-theme-border bg-theme-surface p-4 rounded-lg">
        <span class="font-mono text-[10px] text-theme-muted tracking-widest uppercase block mb-1">
          Cataloged Models
        </span>
        <span class="font-mono text-xl font-bold text-theme-primary">{models.length}</span>
      </div>
      <div class="border border-theme-border bg-theme-surface p-4 rounded-lg">
        <span class="font-mono text-[10px] text-theme-muted tracking-widest uppercase block mb-1">
          Official Updates
        </span>
        <span class="font-mono text-xl font-bold text-blue-700 dark:text-blue-400">
          {modelUpdates.length}
        </span>
      </div>
      <div class="border border-theme-border bg-theme-surface p-4 rounded-lg">
        <span class="font-mono text-[10px] text-theme-muted tracking-widest uppercase block mb-1">
          Open Weights
        </span>
        <span class="font-mono text-xl font-bold text-emerald-700 dark:text-emerald-400">
          {models.filter((m) => m.license_type.includes("Open")).length}
        </span>
      </div>
      <div class="border border-theme-border bg-theme-surface p-4 rounded-lg">
        <span class="font-mono text-[10px] text-theme-muted tracking-widest uppercase block mb-1">
          Max Context Window
        </span>
        <span class="font-mono text-xl font-bold text-theme-primary">
          {formatTokens(Math.max(...models.map((m) => m.context_window)))}
        </span>
      </div>
      <div class="border border-theme-border bg-theme-surface p-4 rounded-lg">
        <span class="font-mono text-[10px] text-theme-muted tracking-widest uppercase block mb-1">
          Active Providers
        </span>
        <span class="font-mono text-xl font-bold text-theme-primary">{providers.length - 1}</span>
      </div>
    </div>

    <!-- Featured Frontier Models Section -->
    <section class="mb-14">
      <div class="flex items-center justify-between mb-6">
        <div>
          <h2 class="text-xs font-mono text-theme-muted tracking-widest uppercase mb-1">
            Featured Frontier Models
          </h2>
          <p class="text-xs text-theme-muted font-mono">
            Flagship reasoning, coding, and multimodal models actively deployed across primary AI research laboratories.
          </p>
        </div>
        <span class="font-mono text-[10px] text-theme-secondary border border-theme-border bg-theme-elevated px-2.5 py-1 rounded">
          {featuredFrontierModels.length} Featured Flagships
        </span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        {
          featuredFrontierModels.map((m) => {
            const exactCount = (exactUpdatesByModelId.get(m.id) || []).length;
            const familyKey = (m.family || "").toLowerCase();
            const familyCount = (familyUpdatesByFamily.get(familyKey) || []).length;
            const totalCount = exactCount + familyCount;
            let badgeText = "0";
            if (exactCount > 0 && familyCount > 0) {
              badgeText = `${exactCount} (+${familyCount} fam)`;
            } else if (exactCount > 0) {
              badgeText = `${exactCount}`;
            } else if (familyCount > 0) {
              badgeText = `${familyCount} fam`;
            }
            return (
              <div class="border border-theme-border bg-theme-surface rounded-lg p-5 flex flex-col justify-between hover:border-theme-border-accent transition-colors">
                <div>
                  <div class="flex items-center justify-between gap-2 mb-2.5">
                    <span class="font-mono text-[10px] uppercase tracking-wider px-2 py-0.5 rounded border border-theme-border bg-theme-elevated text-theme-secondary">
                      {m.provider}
                    </span>
                    <span
                      class={`font-mono text-[9px] uppercase tracking-wider px-1.5 py-0.5 rounded border ${
                        m.license_type.includes("Open")
                          ? "border-emerald-500/30 bg-emerald-500/10 text-emerald-700 dark:text-emerald-400"
                          : "border-blue-500/30 bg-blue-500/10 text-blue-600 dark:text-blue-400"
                      }`}
                    >
                      {m.license_type}
                    </span>
                  </div>

                  <h3 class="text-sm font-bold text-theme-primary mb-1">
                    {m.name}
                  </h3>
                  <p class="text-[11px] text-theme-secondary mb-4 line-clamp-2">
                    {m.notes || `${m.provider} foundation model in the ${m.family} family.`}
                  </p>

                  <div class="grid grid-cols-2 gap-2 text-[11px] font-mono border-t border-theme-border-subtle pt-3 mb-3">
                    <div>
                      <span class="text-[10px] text-theme-muted block">Context Window</span>
                      <span class="font-semibold text-theme-primary">
                        {formatTokens(m.context_window)} tokens
                      </span>
                    </div>
                    <div>
                      <span class="text-[10px] text-theme-muted block">Pricing / 1M In/Out</span>
                      <span class="font-semibold text-theme-primary">
                        {m.pricing
                          ? `$${formatPrice(m.pricing.input_per_1m)} / $${formatPrice(m.pricing.output_per_1m)}`
                          : "Not specified"}
                      </span>
                    </div>
                  </div>
                </div>

                <div class="flex items-center justify-between pt-2 border-t border-theme-border-subtle font-mono text-[10px]">
                  <button
                    type="button"
                    class="view-changelog-btn inline-flex items-center gap-1.5 text-theme-primary hover:text-theme-accent transition-colors cursor-pointer"
                    data-model-id={m.id}
                    data-model-name={m.name}
                    data-model-family={m.family}
                    data-provider={m.provider}
                    title={
                      exactCount > 0
                        ? `${exactCount} exact checkpoint ${exactCount === 1 ? 'update' : 'updates'}${familyCount > 0 ? `, ${familyCount} ${m.family} family updates` : ''}`
                        : familyCount > 0
                          ? `${familyCount} ${m.family} family updates`
                          : "No updates recorded yet"
                    }
                  >
                    <span>Changelog</span>
                    <span class={`px-1 py-0.2 rounded text-[9px] ${
                      totalCount > 0
                        ? "bg-emerald-500/20 text-emerald-700 dark:text-emerald-400 font-bold"
                        : "bg-theme-elevated text-theme-muted"
                    }`}>
                      {badgeText}
                    </span>
                  </button>
                  <a
                    href={m.documentation_url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-theme-muted hover:text-theme-accent transition-colors inline-flex items-center gap-1"
                  >
                    Docs ↗
                  </a>
                </div>
              </div>
            );
          })
        }
      </div>
    </section>

    <!-- Dedicated Official Model Updates & Release Notes Section -->
    <section id="model-updates" class="mb-14 border border-theme-border bg-theme-surface rounded-lg p-5 sm:p-6">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-6">
        <div>
          <div class="inline-flex items-center gap-2 font-mono text-[10px] tracking-widest uppercase px-2 py-0.5 rounded border border-blue-500/30 bg-blue-500/10 text-blue-700 dark:text-blue-400 mb-1.5">
            <span>Official Release Notes</span>
          </div>
          <h2 class="text-base sm:text-lg font-bold text-theme-primary tracking-tight">
            Official Model Updates &amp; Changelog
          </h2>
          <p class="text-xs text-theme-muted font-mono mt-0.5">
            Verified model releases, API capabilities, pricing updates, and deprecations from official lab sources.
          </p>
        </div>
        <div class="flex items-center gap-2 text-[11px] font-mono text-theme-muted">
          <span id="update-count-label">Showing {modelUpdates.length} updates</span>
        </div>
      </div>

      <!-- Controls: Search + Provider Filter + Update Type + Time Period -->
      <div class="flex flex-col gap-3.5 mb-6">
        <div class="flex flex-col sm:flex-row gap-3 items-stretch sm:items-center justify-between">
          <!-- Text Search -->
          <div class="w-full sm:w-80 relative">
            <label for="update-search-input" class="sr-only">Search model updates</label>
            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-theme-muted">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
              </svg>
            </div>
            <input
              type="search"
              id="update-search-input"
              placeholder="Search updates, models, providers..."
              class="w-full bg-theme-input border border-theme-border rounded pl-9 pr-8 py-2 text-xs text-theme-primary placeholder:text-theme-placeholder font-mono focus:outline-none focus:border-theme-accent"
            />
            <button
              type="button"
              id="clear-update-search"
              style="display: none;"
              class="absolute inset-y-0 right-0 pr-2.5 flex items-center text-theme-muted hover:text-theme-primary transition-colors cursor-pointer"
              aria-label="Clear update search"
            >
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
              </svg>
            </button>
          </div>

          <!-- Time Period filter -->
          <div class="flex items-center gap-1.5" role="group" aria-label="Filter updates by time period">
            <span class="text-[10px] font-mono text-theme-muted mr-1 hidden sm:inline">Time:</span>
            <button
              type="button"
              class="update-time-btn font-mono text-[10px] uppercase tracking-wider px-2.5 py-1 rounded border border-theme-border bg-theme-elevated text-theme-primary transition-colors cursor-pointer"
              data-time="all"
              aria-pressed="true"
            >
              All
            </button>
            <button
              type="button"
              class="update-time-btn font-mono text-[10px] uppercase tracking-wider px-2.5 py-1 rounded border border-theme-border text-theme-secondary hover:text-theme-primary hover:border-theme-border-accent transition-colors cursor-pointer"
              data-time="30d"
              aria-pressed="false"
            >
              30 Days
            </button>
            <button
              type="button"
              class="update-time-btn font-mono text-[10px] uppercase tracking-wider px-2.5 py-1 rounded border border-theme-border text-theme-secondary hover:text-theme-primary hover:border-theme-border-accent transition-colors cursor-pointer"
              data-time="7d"
              aria-pressed="false"
            >
              7 Days
            </button>
          </div>
        </div>

        <!-- Filter rows: Providers & Update Types -->
        <div class="flex flex-wrap items-center gap-1.5 text-xs">
          <span class="text-[10px] font-mono text-theme-muted mr-1">Provider:</span>
          <button
            type="button"
            class="update-provider-btn font-mono text-[10px] uppercase tracking-wider px-2.5 py-1 rounded border border-theme-border bg-theme-elevated text-theme-primary transition-colors cursor-pointer"
            data-provider="all"
            aria-pressed="true"
          >
            All
          </button>
          {
            updateProviders.filter((p) => p !== "All").map((prov) => (
              <button
                type="button"
                class="update-provider-btn font-mono text-[10px] uppercase tracking-wider px-2.5 py-1 rounded border border-theme-border text-theme-secondary hover:text-theme-primary hover:border-theme-border-accent transition-colors cursor-pointer"
                data-provider={prov.toLowerCase()}
                aria-pressed="false"
              >
                {prov}
              </button>
            ))
          }
        </div>

        <div class="flex flex-wrap items-center gap-1.5 text-xs">
          <span class="text-[10px] font-mono text-theme-muted mr-1">Type:</span>
          <button
            type="button"
            class="update-type-btn font-mono text-[10px] uppercase tracking-wider px-2.5 py-1 rounded border border-theme-border bg-theme-elevated text-theme-primary transition-colors cursor-pointer"
            data-type="all"
            aria-pressed="true"
          >
            All Types
          </button>
          <button
            type="button"
            class="update-type-btn font-mono text-[10px] uppercase tracking-wider px-2.5 py-1 rounded border border-theme-border text-theme-secondary hover:text-theme-primary hover:border-theme-border-accent transition-colors cursor-pointer"
            data-type="model_release"
            aria-pressed="false"
          >
            Model Releases
          </button>
          <button
            type="button"
            class="update-type-btn font-mono text-[10px] uppercase tracking-wider px-2.5 py-1 rounded border border-theme-border text-theme-secondary hover:text-theme-primary hover:border-theme-border-accent transition-colors cursor-pointer"
            data-type="capability_change"
            aria-pressed="false"
          >
            Capabilities
          </button>
          <button
            type="button"
            class="update-type-btn font-mono text-[10px] uppercase tracking-wider px-2.5 py-1 rounded border border-theme-border text-theme-secondary hover:text-theme-primary hover:border-theme-border-accent transition-colors cursor-pointer"
            data-type="pricing_change"
            aria-pressed="false"
          >
            Pricing
          </button>
          <button
            type="button"
            class="update-type-btn font-mono text-[10px] uppercase tracking-wider px-2.5 py-1 rounded border border-theme-border text-theme-secondary hover:text-theme-primary hover:border-theme-border-accent transition-colors cursor-pointer"
            data-type="api_availability"
            aria-pressed="false"
          >
            API
          </button>
          <button
            type="button"
            class="update-type-btn font-mono text-[10px] uppercase tracking-wider px-2.5 py-1 rounded border border-theme-border text-theme-secondary hover:text-theme-primary hover:border-theme-border-accent transition-colors cursor-pointer"
            data-type="deprecation"
            aria-pressed="false"
          >
            Deprecations
          </button>
        </div>
      </div>

      <!-- Updates List / Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4" id="updates-list">
        {
          modelUpdates.map((u) => {
            const hasClaims = u.provider_claims && u.provider_claims.length > 0;
            return (
              <article
                class="update-card border border-theme-border bg-theme-surface hover:border-theme-border-accent rounded-lg p-4 flex flex-col justify-between transition-colors"
                data-id={u.id}
                data-title={u.title.toLowerCase()}
                data-summary={u.summary.toLowerCase()}
                data-provider={u.provider_name.toLowerCase()}
                data-provider-id={u.provider_id.toLowerCase()}
                data-model={u.model_name ? u.model_name.toLowerCase() : ""}
                data-family={u.model_family ? u.model_family.toLowerCase() : ""}
                data-model-id={u.model_id || ""}
                data-type={u.update_type}
                data-scope={u.scope}
                data-published={u.published_at || ""}
              >
                <div>
                  <div class="flex flex-wrap items-center justify-between gap-2 mb-2">
                    <div class="flex items-center gap-1.5 flex-wrap">
