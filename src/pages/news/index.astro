---
// src/pages/news/index.astro — Full news feed with search, category, date filters, sorting, bookmarks, and pagination

import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import NewsCard from "../../components/NewsCard.astro";
import CategoryFilter from "../../components/CategoryFilter.astro";
import Footer from "../../components/Footer.astro";
import sourcesData from "../../data/sources.json";
import feedData from "../../data/feed.json";

interface FeedRecord {
  id: string;
  title: string;
  company: string;
  source: string;
  summary: string;
  url: string;
  date: string | null;
  category: string;
  fetched_at: string;
  _demo?: boolean;
  topics?: string[];
  priority_label?: string;
  priority_explanation?: string;
  why_it_matters?: string;
  source_type?: string;
}

const feed = feedData as FeedRecord[];

const categories = [
  "News",
  "Research",
  "Benchmark",
  "Product Release",
  "Opinion",
];

// Only genuine, non-demonstration articles in production
const realArticles = feed.filter((a) => !a._demo);

// Distinct publishers represented in real dataset
const distinctPublishers = Array.from(
  new Set(realArticles.map((a) => a.company).filter(Boolean))
).sort();

// Distinct topics represented in dataset
const distinctTopics = Array.from(
  new Set(realArticles.flatMap((a) => a.topics || []).filter(Boolean))
).sort();

// Sort by actual publication date descending (dated first, newest first)
const sortedArticles = [...realArticles].sort((a, b) => {
  const da = a.date ? new Date(a.date).getTime() : 0;
  const db = b.date ? new Date(b.date).getTime() : 0;
  if (da !== db) return db - da;
  const fa = a.fetched_at ? new Date(a.fetched_at).getTime() : 0;
  const fb = b.fetched_at ? new Date(b.fetched_at).getTime() : 0;
  return fb - fa;
});

const lastUpdated = realArticles
  .map((a) => a.fetched_at)
  .sort()
  .reverse()[0];

function formatLastUpdated(iso: string | undefined): string {
  if (!iso) return "Awaiting first ingestion";
  try {
    return new Date(iso).toUTCString();
  } catch {
    return iso ?? "Unknown";
  }
}
---

<Layout title="News — AI Pulse">
  <Header currentPath="/news/" />

  <main id="main-content">
    <!-- Page header -->
    <section class="border-b border-neutral-800/60 bg-neutral-950">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
        <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4">
          <div>
            <h1 class="text-xl font-bold text-neutral-100 tracking-tight mb-1">
              AI News Feed
            </h1>
            <p class="text-xs text-neutral-500 font-mono">
              {realArticles.length} article{realArticles.length !== 1 ? "s" : ""} across{" "}
              {distinctPublishers.length} publisher{distinctPublishers.length !== 1 ? "s" : ""} · {sourcesData.length} feeds monitored
            </p>
          </div>
          <p class="font-mono text-[10px] text-neutral-600 tracking-wide">
            Last ingestion: {formatLastUpdated(lastUpdated)}
          </p>
        </div>
      </div>
    </section>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <!-- Filter controls -->
      <div class="mb-8">
        <CategoryFilter
          categories={categories}
          publishers={distinctPublishers}
          topics={distinctTopics}
        />
      </div>

      <!-- Article grid -->
      {
        sortedArticles.length === 0 ? (
          <div
            id="empty-state"
            class="border border-neutral-800 rounded-lg p-16 text-center bg-neutral-900/30"
          >
            <p class="font-mono text-xs text-neutral-400 mb-2 font-medium">
              No genuine news articles ingested yet.
            </p>
            <p class="font-mono text-[11px] text-neutral-600 max-w-md mx-auto leading-relaxed mb-4">
              The automated ingestion pipeline runs twice daily across {sourcesData.length} public feeds,
              or can be triggered on demand via GitHub Actions.
            </p>
            <p class="font-mono text-[10px] text-neutral-700">
              Run locally: <code class="text-neutral-500">python3 -m pipeline.run</code>
            </p>
          </div>
        ) : (
          <>
            <div
              id="news-grid"
              class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4"
            >
              {sortedArticles.map((article) => (
                <NewsCard
                  id={article.id}
                  title={article.title}
                  company={article.company}
                  source={article.source}
                  summary={article.summary}
                  url={article.url}
                  date={article.date}
                  category={article.category}
                  fetched_at={article.fetched_at}
                  isDemo={false}
                  topics={article.topics || []}
                  priority_label={article.priority_label}
                  priority_explanation={article.priority_explanation}
                  why_it_matters={article.why_it_matters}
                  source_type={article.source_type}
                />
              ))}
            </div>

            <!-- Empty state for filtered results -->
            <div
              id="empty-state"
              style="display: none;"
              class="border border-neutral-800 rounded-lg p-16 text-center mt-4 bg-neutral-900/30"
            >
              <p class="font-mono text-xs text-neutral-400 mb-1">
                No articles match your search or filter criteria.
              </p>
              <p class="font-mono text-[10px] text-neutral-600 mb-4">
                Try a different keyword, publisher name, date window, or clear all filters.
              </p>
              <button
                type="button"
                id="reset-filter-btn"
                class="font-mono text-[10px] uppercase tracking-wider text-neutral-300 hover:text-white px-3 py-1.5 rounded border border-neutral-700 bg-neutral-800 hover:bg-neutral-700 transition-colors"
              >
                Clear all filters
              </button>
            </div>

            <!-- Pagination Load More button -->
            <div
              id="pagination-controls"
              class="mt-10 flex justify-center"
              style="display: none;"
            >
              <button
                type="button"
                id="load-more-btn"
                class="font-mono text-xs text-neutral-300 hover:text-white bg-neutral-900 hover:bg-neutral-800 border border-neutral-800 hover:border-neutral-700 px-6 py-2.5 rounded-md transition-colors"
              >
                Load more articles ↓
              </button>
            </div>
          </>
        )
      }
    </div>
  </main>

  <Footer />
</Layout>
