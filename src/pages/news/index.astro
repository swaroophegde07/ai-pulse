---
// src/pages/news/index.astro — Full news feed with search, category, date filters, sorting, bookmarks, and pagination

import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import NewsCard from "../../components/NewsCard.astro";
import CategoryFilter from "../../components/CategoryFilter.astro";
import Footer from "../../components/Footer.astro";
import sourcesData from "../../data/sources.json";
import feedData from "../../data/feed.json";

interface FeedRecord {
  id: string;
  title: string;
  company: string;
  source: string;
  summary: string;
  url: string;
  date: string | null;
  category: string;
  fetched_at: string;
  _demo?: boolean;
  topics?: string[];
  tags?: string[];
  key_points?: string[];
  impact_score?: number | null;
  sources?: { title?: string; url: string; publisher?: string }[];
  priority_label?: string;
  priority_explanation?: string;
  why_it_matters?: string;
  source_type?: string;
  summary_status?: string;
}

const feed = feedData as FeedRecord[];
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const categories = [
  "News",
  "Research",
  "Benchmark",
  "Product Release",
  "Opinion",
];

// Only genuine, non-demonstration articles in production
const realArticles = feed.filter((a) => !a._demo);

// Distinct publishers represented in real dataset
const distinctPublishers = Array.from(
  new Set(realArticles.map((a) => a.company).filter(Boolean))
).sort();

// Distinct topics represented in dataset
const distinctTopics = Array.from(
  new Set(realArticles.flatMap((a) => a.topics || []).filter(Boolean))
).sort();

// Sort by actual publication date descending (dated first, newest first)
const sortedArticles = [...realArticles].sort((a, b) => {
  const da = a.date ? new Date(a.date).getTime() : 0;
  const db = b.date ? new Date(b.date).getTime() : 0;
  if (da !== db) return db - da;
  const fa = a.fetched_at ? new Date(a.fetched_at).getTime() : 0;
  const fb = b.fetched_at ? new Date(b.fetched_at).getTime() : 0;
  return fb - fa;
});

const lastUpdated = realArticles
  .map((a) => a.fetched_at)
  .sort()
  .reverse()[0];

function formatLastUpdated(iso: string | undefined): string {
  if (!iso) return "Awaiting first ingestion";
  try {
    return new Date(iso).toUTCString();
  } catch {
    return iso ?? "Unknown";
  }
}
---

<Layout title="News — AI Pulse">
  <Header currentPath="/news/" />

  <main id="main-content">
    <!-- Page header -->
    <section class="border-b border-theme-border bg-theme-page">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 animate-reveal">
        <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4">
          <div>
            <div class="inline-flex items-center gap-2 font-mono text-[10px] tracking-widest uppercase px-2.5 py-1 rounded border border-sky-500/30 bg-sky-500/10 text-sky-500 dark:text-sky-400 mb-3">
              <span>Chronological Intelligence Feed</span>
            </div>
            <h1 class="text-2xl sm:text-3xl font-bold text-theme-primary tracking-tight mb-2">
              AI News Feed
            </h1>
            <p class="text-xs text-theme-secondary font-mono flex items-center gap-2 flex-wrap">
              <span>
                {realArticles.length} article{realArticles.length !== 1 ? "s" : ""} across{" "}
                {distinctPublishers.length} publisher{distinctPublishers.length !== 1 ? "s" : ""} · {sourcesData.length} feeds monitored
              </span>
              <span class="inline-flex items-center gap-1 text-[10px] text-emerald-700 dark:text-emerald-400 bg-emerald-500/10 border border-emerald-500/30 px-2 py-0.5 rounded">
                <span class="inline-block w-1.5 h-1.5 rounded-full bg-emerald-500 dark:bg-emerald-400"></span>
                {sourcesData.length}/{sourcesData.length} Feeds Monitored
              </span>
            </p>
          </div>
          <div class="flex flex-col sm:items-end gap-1.5">
            <p class="font-mono text-[10px] text-theme-muted tracking-wide">
              Last ingestion: {formatLastUpdated(lastUpdated)}
            </p>
            <div class="flex items-center gap-2.5 flex-wrap">
              <a
                href={`${base}/feed.xml`}
                target="_blank"
                class="font-mono text-[10px] text-amber-700 dark:text-amber-400 bg-amber-500/10 hover:bg-amber-500/20 border border-amber-500/30 px-2 py-0.5 rounded transition-colors inline-flex items-center gap-1 font-medium"
                title="Subscribe via RSS / Atom feed"
              >
                <svg class="w-2.5 h-2.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <circle cx="6.18" cy="17.82" r="2.18"></circle>
                  <path d="M4 4.44v2.83c7.03 0 12.73 5.7 12.73 12.73h2.83c0-8.59-6.97-15.56-15.56-15.56zm0 5.66v2.83c3.9 0 7.07 3.17 7.07 7.07h2.83c0-5.47-4.43-9.9-9.9-9.9z"></path>
                </svg>
                <span>RSS Feed</span>
              </a>
              <span class="text-theme-border font-mono text-[10px]">·</span>
              <a
                href="https://github.com/swaroophegde07/ai-pulse/issues/new?template=data_correction.yml&title=%5BData+Correction%5D%3A+Article+Summary+Inaccuracy+%28News+Page%29"
                target="_blank"
                rel="noopener noreferrer"
                class="font-mono text-[10px] text-theme-muted hover:text-emerald-700 dark:hover:text-emerald-400 transition-colors inline-flex items-center gap-1"
                title="Report inaccurate article summaries, broken links, or misclassifications"
              >
                <span>Report a news issue</span>
                <span>↗</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <!-- Filter controls with slotted feed content to preserve sticky height boundary -->
      <CategoryFilter
        categories={categories}
        publishers={distinctPublishers}
        topics={distinctTopics}
      >
        <div class="mt-4">
          <!-- Article grid -->
          {
            sortedArticles.length === 0 ? (
              <div
                id="empty-state"
                class="border border-theme-border rounded-lg p-16 text-center bg-theme-surface"
              >
                <p class="font-mono text-xs text-theme-secondary mb-2 font-medium">
                  No genuine news articles ingested yet.
                </p>
                <p class="font-mono text-[11px] text-theme-muted max-w-md mx-auto leading-relaxed mb-4">
                  The automated ingestion pipeline runs twice daily across {sourcesData.length} public feeds,
                  or can be triggered on demand via GitHub Actions.
                </p>
                <p class="font-mono text-[10px] text-theme-dim">
                  Run locally: <code class="text-theme-muted">python3 -m pipeline.run</code>
                </p>
              </div>
            ) : (
              <>
                <div
                  id="news-grid"
                  class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4"
                >
                  {sortedArticles.map((article) => (
                    <NewsCard
                      id={article.id}
                      title={article.title}
                      company={article.company}
                      source={article.source}
                      summary={article.summary}
                      url={article.url}
                      date={article.date}
                      category={article.category}
                      fetched_at={article.fetched_at}
                      isDemo={false}
                      topics={article.topics || []}
                      tags={article.tags || []}
                      key_points={article.key_points || []}
                      impact_score={article.impact_score}
                      sources={article.sources || []}
                      priority_label={article.priority_label}
                      priority_explanation={article.priority_explanation}
                      why_it_matters={article.why_it_matters}
                      source_type={article.source_type}
                      summary_status={article.summary_status}
                    />
                  ))}
                </div>

                <!-- Empty state for filtered results -->
                <div
                  id="empty-state"
                  style="display: none;"
                  class="border border-theme-border rounded-lg p-16 text-center mt-4 bg-theme-surface"
                >
                  <p class="font-mono text-xs text-theme-secondary mb-1">
                    No articles match your search or filter criteria.
                  </p>
                  <p class="font-mono text-[10px] text-theme-muted mb-4">
                    Try a different keyword, publisher name, date window, or clear all filters.
                  </p>
                  <button
                    type="button"
                    id="reset-filter-btn"
                    class="btn-interactive font-mono text-[10px] uppercase tracking-wider text-theme-primary px-3 py-1.5 rounded border border-theme-border bg-theme-elevated hover:bg-theme-hover cursor-pointer"
                  >
                    Clear all filters
                  </button>
                </div>

                <!-- Pagination Load More button -->
                <div
                  id="pagination-controls"
                  class="mt-10 flex justify-center"
                  style="display: none;"
                >
                  <button
                    type="button"
                    id="load-more-btn"
                    class="btn-interactive font-mono text-xs text-theme-secondary hover:text-theme-primary bg-theme-surface hover:bg-theme-hover border border-theme-border hover:border-theme-border-accent px-6 py-2.5 rounded-md cursor-pointer"
                  >
                    Load more articles ↓
                  </button>
                </div>

                <div class="mt-12 pt-6 border-t border-theme-border-subtle flex flex-wrap items-center justify-between gap-2 font-mono text-[11px] text-theme-muted">
                  <span>Notice a misclassified article or broken link?</span>
                  <a
                    href="https://github.com/swaroophegde07/ai-pulse/issues/new?template=data_correction.yml&title=%5BData+Correction%5D%3A+Article+Summary+Inaccuracy+%28News+Page%29"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-theme-secondary hover:text-emerald-700 dark:hover:text-emerald-400 transition-colors inline-flex items-center gap-1"
                  >
                    <span>Report a news issue</span>
                    <span>↗</span>
                  </a>
                </div>
              </>
            )
          }
        </div>
      </CategoryFilter>
    </div>
  </main>

  <Footer />
</Layout>
