---
// src/pages/news/index.astro — Full news feed with search + category filter

import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import NewsCard from "../../components/NewsCard.astro";
import CategoryFilter from "../../components/CategoryFilter.astro";
import Footer from "../../components/Footer.astro";
import feedData from "../../data/feed.json";

interface FeedRecord {
  id: string;
  title: string;
  company: string;
  source: string;
  summary: string;
  url: string;
  date: string | null;
  category: string;
  fetched_at: string;
  _demo?: boolean;
}

const feed = feedData as FeedRecord[];

const categories = [
  "News",
  "Research",
  "Benchmark",
  "Product Release",
  "Opinion",
];

const lastUpdated = feed
  .map((a) => a.fetched_at)
  .sort()
  .reverse()[0];

function formatLastUpdated(iso: string | undefined): string {
  if (!iso) return "Never";
  try {
    return new Date(iso).toUTCString();
  } catch {
    return iso ?? "Unknown";
  }
}
---

<Layout title="News">
  <Header currentPath="/news/" />

  <main id="main-content">
    <!-- Page header -->
    <section class="border-b border-neutral-800/60 bg-neutral-950">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
        <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4">
          <div>
            <h1 class="text-xl font-bold text-neutral-100 tracking-tight mb-1">
              AI News Feed
            </h1>
            <p class="text-xs text-neutral-500">
              {feed.length} article{feed.length !== 1 ? "s" : ""} from{" "}
              {[...new Set(feed.map((a) => a.source))].length} source{
                [...new Set(feed.map((a) => a.source))].length !== 1 ? "s" : ""
              }
            </p>
          </div>
          <p class="font-mono text-[10px] text-neutral-700 tracking-wide">
            Last updated: {formatLastUpdated(lastUpdated)}
          </p>
        </div>
      </div>
    </section>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <!-- Filter controls -->
      <div class="mb-8">
        <CategoryFilter categories={categories} />
      </div>

      <!-- Article grid -->
      {
        feed.length === 0 ? (
          <div
            id="empty-state"
            class="border border-neutral-800 rounded-lg p-16 text-center"
          >
            <p class="font-mono text-xs text-neutral-600 mb-2">
              No articles yet.
            </p>
            <p class="font-mono text-[10px] text-neutral-700">
              Run the pipeline: <code class="text-neutral-500">python -m pipeline.run</code>
            </p>
          </div>
        ) : (
          <>
            <div
              id="news-grid"
              class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4"
            >
              {feed.map((article) => (
                <NewsCard
                  id={article.id}
                  title={article.title}
                  company={article.company}
                  source={article.source}
                  summary={article.summary}
                  url={article.url}
                  date={article.date}
                  category={article.category}
                  fetched_at={article.fetched_at}
                  isDemo={article._demo === true}
                />
              ))}
            </div>

            <!-- Empty state for filtered results -->
            <div
              id="empty-state"
              style="display: none;"
              class="border border-neutral-800 rounded-lg p-16 text-center mt-4"
            >
              <p class="font-mono text-xs text-neutral-600 mb-1">
                No articles match your search.
              </p>
              <p class="font-mono text-[10px] text-neutral-700">
                Try a different query or category filter.
              </p>
            </div>
          </>
        )
      }
    </div>
  </main>

  <Footer />
</Layout>
