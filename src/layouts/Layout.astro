---
// Layout.astro — base HTML shell for all AI Pulse pages
import "../styles/global.css";
import ReaderModal from "../components/ReaderModal.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "AI Pulse",
  description = "Minimalist AI intelligence dashboard aggregating news about AI companies, models, research, and benchmarks.",
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="alternate" type="application/rss+xml" title="AI Pulse — Curated AI Intelligence Feed" href={`${base}/feed.xml`} />
    <title>{title === "AI Pulse" ? title : `${title} — AI Pulse`}</title>

    <!-- Early theme initialization to completely prevent Flash of Wrong Theme (FOUT) -->
    <script is:inline>
      (function () {
        var STORAGE_KEY = "ai-pulse-theme";
        var preference = "system";
        try {
          var saved = localStorage.getItem(STORAGE_KEY);
          if (saved === "light" || saved === "dark" || saved === "system") {
            preference = saved;
          }
        } catch (e) {
          // Graceful fallback if localStorage is blocked
        }

        var isDark = false;
        if (preference === "dark") {
          isDark = true;
        } else if (preference === "light") {
          isDark = false;
        } else {
          isDark = window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches;
        }

        var root = document.documentElement;
        if (isDark) {
          root.classList.add("dark");
        } else {
          root.classList.remove("dark");
        }
        root.setAttribute("data-theme-preference", preference);
        root.setAttribute("data-theme-resolved", isDark ? "dark" : "light");
        root.style.colorScheme = isDark ? "dark" : "light";
      })();
    </script>
  </head>
  <body class="bg-theme-page text-theme-primary min-h-screen antialiased">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[100] focus:px-4 focus:py-2 focus:bg-emerald-500 focus:text-white focus:font-mono focus:text-xs focus:font-bold focus:rounded focus:shadow-xl focus:ring-2 focus:ring-emerald-400"
    >
      Skip to main content
    </a>
    <slot />

    <!-- Global Focused Intelligence Reader Modal -->
    <ReaderModal />

    <!-- Global Futuristic HUD Toast Notification -->
    <div
      id="hud-toast"
      role="status"
      aria-live="polite"
      class="fixed bottom-6 left-1/2 -translate-x-1/2 z-[100] pointer-events-none transition-all duration-200 opacity-0 translate-y-3"
    >
      <div class="inline-flex items-center gap-2 px-3.5 py-2 rounded-full border border-theme-border bg-theme-surface/95 backdrop-blur-md shadow-xl text-xs font-mono text-theme-primary">
        <span id="hud-toast-icon" class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        <span id="hud-toast-msg">Notification</span>
      </div>
    </div>

    <script>
      import "../scripts/theme";
      import "../scripts/relativeTime";

      let toastTimer: number | null = null;
      window.addEventListener("ai-pulse:toast", (e: any) => {
        const toast = document.getElementById("hud-toast");
        const msg = document.getElementById("hud-toast-msg");
        const icon = document.getElementById("hud-toast-icon");
        if (!toast || !msg) return;

        msg.textContent = e.detail?.message || "Notification";
        if (icon) {
          icon.className = `w-2 h-2 rounded-full ${e.detail?.color || "bg-emerald-500"}`;
        }

        toast.classList.remove("opacity-0", "translate-y-3", "pointer-events-none");
        toast.classList.add("opacity-100", "translate-y-0");

        if (toastTimer) clearTimeout(toastTimer);
        toastTimer = window.setTimeout(() => {
          toast.classList.remove("opacity-100", "translate-y-0");
          toast.classList.add("opacity-0", "translate-y-3", "pointer-events-none");
          toastTimer = null;
        }, 2200);
      });
    </script>
  </body>
</html>
