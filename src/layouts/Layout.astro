---
// Layout.astro — base HTML shell for all AI Pulse pages
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "AI Pulse",
  description = "Minimalist AI intelligence dashboard aggregating news about AI companies, models, research, and benchmarks.",
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <title>{title === "AI Pulse" ? title : `${title} — AI Pulse`}</title>
  </head>
  <body class="bg-neutral-950 text-neutral-100 min-h-screen antialiased selection:bg-emerald-500/20 selection:text-emerald-300">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[100] focus:px-4 focus:py-2 focus:bg-emerald-400 focus:text-neutral-950 focus:font-mono focus:text-xs focus:font-bold focus:rounded focus:shadow-xl focus:ring-2 focus:ring-white"
    >
      Skip to main content
    </a>
    <slot />
  </body>
</html>
