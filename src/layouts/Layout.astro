---
// Layout.astro — base HTML shell for all AI Pulse pages
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "AI Pulse",
  description = "Minimalist AI intelligence dashboard aggregating news about AI companies, models, research, and benchmarks.",
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <title>{title === "AI Pulse" ? title : `${title} — AI Pulse`}</title>
  </head>
  <body class="bg-neutral-950 text-neutral-100 min-h-screen antialiased">
    <slot />
  </body>
</html>
